<script is:inline>
  // ── DARK MODE ────────────────────────────────────────────────
  var darkToggle = document.getElementById('dark-toggle');
  var darkIcon = darkToggle.querySelector('.dark-icon');
  var lightIcon = darkToggle.querySelector('.light-icon');

  function applyTheme(isLight) {
    if (isLight) {
      document.body.classList.add('light-mode');
      darkIcon.style.display = 'none';
      lightIcon.style.display = '';
    } else {
      document.body.classList.remove('light-mode');
      darkIcon.style.display = '';
      lightIcon.style.display = 'none';
    }
  }

  darkToggle.addEventListener('click', function() {
    var isLight = !document.body.classList.contains('light-mode');
    applyTheme(isLight);
    localStorage.setItem('kneed-theme', isLight ? 'light' : 'dark');
  });

  applyTheme(localStorage.getItem('kneed-theme') === 'light');

  // ── MENU DRAWER ──────────────────────────────────────────────
  var drawer = document.getElementById('menu-drawer');
  var backdrop = document.getElementById('menu-backdrop');
  var menuBtn = document.getElementById('menu-btn');
  var closeBtn = document.getElementById('menu-close-btn');

  function openMenu() {
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  menuBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  backdrop.addEventListener('click', closeMenu);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeMenu();
  });
</script>