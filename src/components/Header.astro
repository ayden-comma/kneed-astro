<script is:inline>
  // ── DARK MODE ────────────────────────────────────────────────
  // Applies stored theme preference on every page render.
  // Menu drawer init is handled in BaseLayout's persistent head script
  // via the page lifecycle registry (astro:page-load).
  (function() {
    var darkToggle = document.getElementById('dark-toggle');
    if (!darkToggle) return;
    var darkIcon  = darkToggle.querySelector('.dark-icon');
    var lightIcon = darkToggle.querySelector('.light-icon');

    function applyTheme(isLight) {
      document.body.classList.toggle('light-mode', isLight);
      if (darkIcon)  darkIcon.style.display  = isLight ? 'none' : '';
      if (lightIcon) lightIcon.style.display = isLight ? ''     : 'none';
    }

    darkToggle.onclick = function() {
      var isLight = !document.body.classList.contains('light-mode');
      applyTheme(isLight);
      localStorage.setItem('kneed-theme', isLight ? 'light' : 'dark');
    };

    applyTheme(localStorage.getItem('kneed-theme') === 'light');
  })();
</script>