      <div class="menu-nav-label">Account</div>
      <div class="menu-user-info">
        <a href="/profile" id="menu-user-name" class="menu-user-name" style="text-decoration:none; color:inherit;"></a>
      </div>
      <a class="menu-nav-item" href="/recipe-book">
