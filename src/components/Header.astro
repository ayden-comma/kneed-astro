      <a href="/auth/login" class="header-signin-btn" id="header-signin">Sign in</a>
      <button class="header-user-btn" id="header-user" aria-label="Account" type="button"></button>
    </div>
  </div>

  <!-- NAV ROW: only visible on desktop -->
  <nav class="site-nav">
    {navLinks.map((link) => (
      <a href={link.href} class="nav-link">{link.label}</a>
    ))}
  </nav>
</header>

<!-- MENU DRAWER -->
