---
// Post-signup email opt-in prompt. Provider-agnostic: it keys off the session that
// already exists after ANY signup (email/password or OAuth), so it works identically
// for Google and email accounts — unlike the removed pre-signup checkbox.
// Eligibility + "already asked" are tracked by profiles.newsletter_prompted_at
// (see migration SQL in HANDOFF); localStorage is a per-device fast-path / dismiss guard.
---
<div id="nl-prompt" class="nl-prompt" role="dialog" aria-labelledby="nl-prompt-h" aria-live="polite" hidden>
  <button id="nl-prompt-x" class="nl-prompt-x" aria-label="Dismiss">×</button>
  <div id="nl-prompt-h" class="nl-prompt-h">Want updates?</div>
  <p class="nl-prompt-body">Keep me updated on things (K)Need.</p>
  <div class="nl-prompt-actions">
    <button id="nl-prompt-yes" class="nl-prompt-btn nl-prompt-yes" type="button">Yes, keep me updated</button>
    <button id="nl-prompt-no" class="nl-prompt-btn nl-prompt-no" type="button">No thanks</button>
  </div>
</div>

<style>
  .nl-prompt {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 60;
    width: min(340px, calc(100vw - 2.5rem));
    background: var(--surface-2);
    border: 1px solid var(--border-md);
    border-radius: var(--r-card);
    padding: 1.25rem 1.25rem 1.125rem;
    box-shadow: 0 12px 40px rgba(0,0,0,0.45);
    color: var(--parchment);
  }
  .nl-prompt[hidden] { display: none; }
  .nl-prompt-x {
    position: absolute; top: 0.5rem; right: 0.6rem;
    font-size: 1.25rem; line-height: 1; color: var(--p-50);
    background: none; border: none; cursor: pointer;
  }
  .nl-prompt-x:hover { color: var(--parchment); }
  .nl-prompt-h { font-family: var(--font-display); font-weight: 400; font-size: 1.05rem; margin-bottom: 0.35rem; }
  .nl-prompt-body { font-size: 0.85rem; font-weight: 300; line-height: 1.45; color: var(--p-70); margin-bottom: 1rem; }
  .nl-prompt-actions { display: flex; gap: 0.5rem; }
  .nl-prompt-btn {
    flex: 1 1 0; padding: 0.6rem 0.5rem; border-radius: var(--r-pill);
    font-family: var(--font-cond); font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .nl-prompt-yes { background: var(--amber); color: #fff; border: 1px solid var(--amber); }
  .nl-prompt-yes:hover { opacity: 0.88; }
  .nl-prompt-no { background: transparent; color: var(--p-70); border: 1px solid var(--border-md); }
  .nl-prompt-no:hover { border-color: var(--p-50); color: var(--parchment); }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const DISMISS_LIMIT = 2; // dismiss may re-ask up to this many times per device, then stop

  async function initNewsletterPrompt() {
    const path = window.location.pathname;
    if (path.startsWith('/auth') || path.startsWith('/admin')) return; // transient / not a landing surface
    const card = document.getElementById('nl-prompt');
    if (!card) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;
    const uid = session.user.id;
    const email = session.user.email;
    const token = session.access_token;
    if (!email || !token) return;

    const seenKey    = `kneed_nl_seen:${uid}`;
    const dismissKey = `kneed_nl_dismiss:${uid}`;
    if (localStorage.getItem(seenKey)) return; // terminal on this device — never query again

    // Source of truth: only accounts created after the migration have a NULL here
    // (pre-existing accounts were backfilled to now()), so this excludes them.
    const { data, error } = await supabase
      .from('profiles')
      .select('newsletter_prompted_at')
      .eq('id', uid)
      .maybeSingle();
    if (error || !data) return;                          // fail safe: don't show on error
    if (data.newsletter_prompted_at) { localStorage.setItem(seenKey, '1'); return; } // already handled

    // Definitively record "asked/answered" so it never shows again on any device.
    async function markPrompted() {
      localStorage.setItem(seenKey, '1');
      await supabase.from('profiles').update({ newsletter_prompted_at: new Date().toISOString() }).eq('id', uid);
    }
    const hide = () => { card!.setAttribute('hidden', ''); };

    document.getElementById('nl-prompt-yes')!.onclick = async () => {
      hide();
      try {
        await fetch('/api/newsletter-signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ email, consent_source: 'signup_prompt' }),
        });
      } catch (e) { console.error('[nl-prompt] subscribe failed:', e); }
      await markPrompted();
    };

    document.getElementById('nl-prompt-no')!.onclick = async () => {
      hide();
      await markPrompted(); // "No" records nothing in email_subscribers — absence is the record
    };

    document.getElementById('nl-prompt-x')!.onclick = async () => {
      hide();
      // Dismiss = "not now": don't answer yet, but cap re-asks so it never nags.
      const n = Number(localStorage.getItem(dismissKey) || '0') + 1;
      localStorage.setItem(dismissKey, String(n));
      if (n >= DISMISS_LIMIT) await markPrompted();
    };

    // Respect the per-device dismiss cap (belt-and-braces with the seen flag above).
    if (Number(localStorage.getItem(dismissKey) || '0') >= DISMISS_LIMIT) return;

    card.removeAttribute('hidden');
  }

  document.addEventListener('astro:page-load', initNewsletterPrompt);
  initNewsletterPrompt();
</script>
