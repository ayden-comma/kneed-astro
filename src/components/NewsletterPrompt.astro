---
// Post-signup email opt-in prompt. Provider-agnostic: it keys off the session that
// already exists after ANY signup (email/password or OAuth), so it works identically
// for Google and email accounts — unlike the removed pre-signup checkbox.
// Eligibility + "already asked" are tracked by profiles.newsletter_prompted_at
// (see migration SQL in HANDOFF); localStorage is a per-device fast-path / dismiss guard.
// Presented as a centred, focus-trapped modal over the post-signup landing page.
---
<div id="nl-prompt-overlay" class="nl-overlay" hidden>
  <div
    id="nl-prompt"
    class="nl-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nl-prompt-h"
    aria-describedby="nl-prompt-body"
    tabindex="-1"
  >
    <button id="nl-prompt-x" class="nl-x" aria-label="Close">&times;</button>
    <span class="nl-badge">Psst&hellip;</span>
    <div id="nl-prompt-h" class="nl-h">Want the good stuff?</div>
    <p id="nl-prompt-body" class="nl-body">New episodes, stories and what's coming next. No spam, just bread.</p>
    <div class="nl-actions">
      <button id="nl-prompt-yes" class="nl-btn nl-btn-primary" type="button">Yes please</button>
      <button id="nl-prompt-no" class="nl-btn nl-btn-ghost" type="button">No thanks</button>
    </div>
  </div>
</div>

<style>
.nl-overlay{
  position:fixed;inset:0;z-index:1000;
  display:flex;align-items:center;justify-content:center;padding:24px;
  background:rgba(4,3,3,.62);backdrop-filter:blur(2px);
}
.nl-overlay[hidden]{display:none;}
.nl-card{
  position:relative;width:100%;max-width:360px;
  background:linear-gradient(165deg,#241a12,var(--surface-2) 60%);
  border:1px solid var(--border-md);border-radius:18px;
  padding:34px 30px 28px;text-align:center;
  box-shadow:0 24px 60px rgba(0,0,0,.5);
}
.nl-x{
  position:absolute;top:14px;right:14px;width:28px;height:28px;
  border-radius:50%;border:1px solid var(--border-md);background:none;
  color:var(--p-50);font-size:15px;line-height:1;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:color .18s,border-color .18s;
}
.nl-x:hover{color:var(--parchment);border-color:var(--parchment);}
.nl-badge{
  display:inline-block;font-weight:600;letter-spacing:.22em;text-transform:uppercase;
  font-size:.64rem;color:var(--amber);
  border:1px solid rgba(200,131,58,.4);border-radius:var(--r-pill);padding:5px 14px;
  align-self:center;
}
.nl-h{
  font-family:var(--font-display);font-weight:500;font-size:2.1rem;line-height:1.02;
  color:var(--parchment);margin:18px 0 10px;
}
.nl-body{
  font-weight:300;color:var(--p-70);font-size:.95rem;line-height:1.5;
  max-width:250px;margin:0 auto;
}
.nl-actions{margin-top:24px;display:flex;flex-direction:column;gap:10px;}
.nl-btn{
  font-weight:600;letter-spacing:.12em;text-transform:uppercase;font-size:.82rem;
  border-radius:var(--r-pill);padding:14px;cursor:pointer;border:1px solid transparent;
  transition:filter .18s,background .18s,color .18s;
}
.nl-btn-primary{background:var(--amber);color:#0E0C0A;border-color:var(--amber);}
.nl-btn-primary:hover{filter:brightness(1.08);}
.nl-btn-ghost{background:none;color:var(--p-50);border-color:transparent;}
.nl-btn-ghost:hover{color:var(--parchment);}
@media(max-width:400px){.nl-h{font-size:1.85rem;}}
</style>

<script>
  import { supabase } from '../lib/supabase';

  const DISMISS_LIMIT = 2; // dismiss may re-ask up to this many times per device, then stop

  async function initNewsletterPrompt() {
    const path = window.location.pathname;
    if (path.startsWith('/auth') || path.startsWith('/admin')) return; // transient / not a landing surface
    const overlay = document.getElementById('nl-prompt-overlay');
    const dialog  = document.getElementById('nl-prompt');
    if (!overlay || !dialog) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;
    const uid = session.user.id;
    const email = session.user.email;
    const token = session.access_token;
    if (!email || !token) return;

    const seenKey    = `kneed_nl_seen:${uid}`;
    const dismissKey = `kneed_nl_dismiss:${uid}`;
    if (localStorage.getItem(seenKey)) return; // terminal on this device — never query again

    // Source of truth: only accounts created after the migration have a NULL here
    // (pre-existing accounts were backfilled to now()), so this excludes them.
    const { data, error } = await supabase
      .from('profiles')
      .select('newsletter_prompted_at')
      .eq('id', uid)
      .maybeSingle();
    if (error || !data) return;                          // fail safe: don't show on error
    if (data.newsletter_prompted_at) { localStorage.setItem(seenKey, '1'); return; } // already handled

    // Respect the per-device dismiss cap (belt-and-braces with the seen flag above).
    if (Number(localStorage.getItem(dismissKey) || '0') >= DISMISS_LIMIT) return;

    // ── Modal machinery: focus trap, focus save/restore, scroll lock, Esc ──────────
    let prevFocus: HTMLElement | null = null;
    let prevOverflow = '';

    function getFocusable(): HTMLElement[] {
      return Array.from(
        dialog!.querySelectorAll<HTMLElement>('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])')
      ).filter(el => !el.hasAttribute('disabled'));
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') { e.preventDefault(); dismiss(); return; }
      if (e.key !== 'Tab') return;
      const f = getFocusable();
      if (f.length === 0) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }

    function open() {
      prevFocus = document.activeElement as HTMLElement | null;
      prevOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';          // lock body scroll
      overlay!.removeAttribute('hidden');
      document.addEventListener('keydown', onKeydown, true);
      dialog!.focus();                                    // move focus into the modal
    }

    function teardown() {
      overlay!.setAttribute('hidden', '');
      document.body.style.overflow = prevOverflow;        // restore scroll
      document.removeEventListener('keydown', onKeydown, true);
      prevFocus?.focus?.();                               // return focus to the page
    }

    async function markPrompted() {
      localStorage.setItem(seenKey, '1');
      await supabase.from('profiles').update({ newsletter_prompted_at: new Date().toISOString() }).eq('id', uid);
    }

    // All three escape routes (×, backdrop, Esc) are "not now" — same dismiss + cap.
    async function dismiss() {
      teardown();
      const n = Number(localStorage.getItem(dismissKey) || '0') + 1;
      localStorage.setItem(dismissKey, String(n));
      if (n >= DISMISS_LIMIT) await markPrompted();
    }

    document.getElementById('nl-prompt-yes')!.onclick = async () => {
      teardown();
      try {
        await fetch('/api/newsletter-signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ email, consent_source: 'signup_prompt' }),
        });
      } catch (e) { console.error('[nl-prompt] subscribe failed:', e); }
      await markPrompted();
    };

    document.getElementById('nl-prompt-no')!.onclick = async () => {
      teardown();
      await markPrompted(); // "No" records nothing in email_subscribers — absence is the record
    };

    document.getElementById('nl-prompt-x')!.onclick = () => dismiss();
    overlay.onclick = (e) => { if (e.target === overlay) dismiss(); }; // backdrop tap only

    open();
  }

  document.addEventListener('astro:page-load', initNewsletterPrompt);
  initNewsletterPrompt();
</script>
