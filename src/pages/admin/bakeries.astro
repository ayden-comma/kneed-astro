  async function loadList() {
    const { data, error } = await supabase
      .from('bakeries_cms')
      .select('id, name, slug, category, suburb, published, updated_at, published_at')
      .order('updated_at', { ascending: false });
    if (error) { tbody.innerHTML = `<tr><td colspan="7"><div class="admin-empty">Error: ${error.message}</div></td></tr>`; return; }
    const rows = (data ?? []) as BakeryRow[];
    tbody.innerHTML = rows.length === 0
      ? '<tr><td colspan="7"><div class="admin-empty">No bakeries yet. Add your first one.</div></td></tr>'
      : rows.map(rowHTML).join('');
    bindRowButtons();
    updateSortIcons();
  }

  function bindRowButtons() {
    tbody.querySelectorAll('.btn-edit-bakery').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id!;
        const { data } = await supabase.from('bakeries_cms').select('*').eq('id', id).single();
        if (!data) return;
        openModal(id);
        titleEl.textContent = 'Edit Bakery';
        (field('f-id') as HTMLInputElement).value         = data.id;
        (field('f-name') as HTMLInputElement).value       = data.name ?? '';
        (field('f-slug') as HTMLInputElement).value       = data.slug ?? '';
        (field('f-category') as HTMLInputElement).value   = data.category ?? '';
        (field('f-website') as HTMLInputElement).value    = data.website ?? '';
        const { data: locRows } = await supabase.from('locations').select('label, address, lat, lng, hours, place_id').eq('bakery_slug', data.slug).order('sort_order');
        populateLocations(locRows as any);
        (field('f-instagram') as HTMLInputElement).value  = data.instagram ?? '';
        (field('f-hours') as HTMLInputElement).value      = data.hours ?? '';
        (field('f-date') as HTMLInputElement).value           = data.date ?? '';
        (field('f-episode-number') as HTMLInputElement).value = data.episode_number ?? '';
        (field('f-duration') as HTMLInputElement).value       = data.duration ?? '';
        (field('f-video-id') as HTMLInputElement).value       = data.video_id ?? '';
        (field('f-map-link') as HTMLInputElement).value   = data.map_link ?? '';
        (field('f-quote') as HTMLTextAreaElement).value   = data.quote ?? '';
        populateCredits(data.credits as { title: string; name: string }[] | null);
        (field('f-description') as HTMLTextAreaElement).value  = data.description ?? '';
        (field('f-thumbnail') as HTMLInputElement).value       = data.thumbnail ?? '';
        (field('f-hero-tag') as HTMLInputElement).value         = data.hero_tag ?? '';
        (field('f-hero-title') as HTMLInputElement).value       = data.hero_title ?? '';
        (field('f-hero-subtitle') as HTMLTextAreaElement).value = data.hero_subtitle ?? '';
        (field('f-hero-bg-word') as HTMLInputElement).value     = data.hero_bg_word ?? '';
        (field('f-loop-video-url') as HTMLInputElement).value   = data.loop_video_url ?? '';
        (field('f-hero-image-url') as HTMLInputElement).value   = data.hero_image_url ?? '';

        const heroPreview = document.getElementById('f-hero-img-preview') as HTMLImageElement;
        if (data.hero_image_url) { heroPreview.src = data.hero_image_url; heroPreview.style.display = 'block'; }
        else heroPreview.style.display = 'none';
        updateHeroPreview();

        imgListEl.innerHTML = '';
        const imgs = data.images as ImgRow[] | null;
        (imgs ?? []).forEach(img => imgListEl.appendChild(createImgRow(img.src, img.caption)));

        if (bodyEditor) bodyEditor.commands.setContent(data.body ?? '');
        else _pendingContent = data.body ?? '';

        setPublishBtn(!!data.published);
        const preview = document.getElementById('f-thumb-preview') as HTMLImageElement;
        if (data.thumbnail) { preview.src = data.thumbnail; preview.style.display = 'block'; }
        else preview.style.display = 'none';

        // Hero dot: show if bakery has hero content
        const heroTabDot = document.getElementById('hero-tab-dot') as HTMLElement;
        heroTabDot.style.display = (data.hero_title || data.hero_image_url) ? '' : 'none';
      });
    });

    tbody.querySelectorAll('.btn-del-bakery').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id   = (btn as HTMLElement).dataset.id!;
        const name = (btn as HTMLElement).dataset.name!;
        if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
        const { error } = await supabase.from('bakeries_cms').delete().eq('id', id);
        if (error) { showMsg(msgEl, error.message, 'error'); return; }
        document.querySelector(`tr[data-id="${id}"]`)?.remove();
        showMsg(msgEl, `"${name}" deleted.`, 'success');
      });
    });

    tbody.querySelectorAll('.toggle-publish').forEach(badge => {
      badge.addEventListener('click', (e) => {
        e.stopPropagation();
        openStatusPopup(badge as HTMLElement, 'bakeries_cms');
      });
    });
  }

  // ── Status popup ──────────────────────────────────────────────
  let statusPopup: HTMLElement | null = null;
  let activePopupBadge: HTMLElement | null = null;

  function closeStatusPopup() {
    statusPopup?.remove();
    statusPopup = null;
    activePopupBadge = null;
  }

  async function applyPublishState(badge: HTMLElement, newPublished: boolean, table: string) {
    const slug = badge.dataset.slug!;
    closeStatusPopup();
    badge.style.opacity = '0.5';
    badge.style.pointerEvents = 'none';
    const res = await fetch('/api/admin-toggle-publish', {
      method: 'POST',
      headers: await authHeaders(),
      body: JSON.stringify({ table, slug, published: newPublished }),
    });
    const json = await res.json();
    badge.style.opacity = '';
    badge.style.pointerEvents = '';
    if (json.error) { showMsg(msgEl, `Error: ${json.error}`, 'error'); return; }
    badge.dataset.published = String(newPublished);
    badge.className = `admin-badge admin-badge-${newPublished ? 'published' : 'draft'} toggle-publish`;
    badge.textContent = newPublished ? 'Published' : 'Draft';
    const tr = badge.closest('tr') as HTMLTableRowElement;
    if (tr) {
      tr.dataset.status = newPublished ? 'published' : 'draft';
      // Update published date cell if first publish
      if (newPublished && !badge.dataset.publishedAt) {
        const cells = tr.querySelectorAll('td');
        const pubCell = cells[cells.length - 2]; // second-to-last (before actions)
        if (pubCell) pubCell.textContent = fmtDate(new Date().toISOString());
      }
    }
  }

  function openStatusPopup(badge: HTMLElement, table: string) {
    closeStatusPopup();
    activePopupBadge = badge;
    const isPublished = badge.dataset.published === 'true';
    const popup = document.createElement('div');
    popup.className = 'status-popup';
    popup.innerHTML = `
      <div class="status-popup-option${isPublished ? ' active' : ''}" data-val="true">
        <span class="status-popup-dot published"></span>Published${isPublished ? '<span class="status-popup-check">✓</span>' : ''}
      </div>
      <div class="status-popup-option${!isPublished ? ' active' : ''}" data-val="false">
        <span class="status-popup-dot draft"></span>Not Published${!isPublished ? '<span class="status-popup-check">✓</span>' : ''}
      </div>`;
    popup.querySelectorAll<HTMLElement>('.status-popup-option').forEach(opt => {
      opt.addEventListener('click', async (e) => {
        e.stopPropagation();
        await applyPublishState(badge, opt.dataset.val === 'true', table);
      });
    });
    document.body.appendChild(popup);
    statusPopup = popup;
    const rect = badge.getBoundingClientRect();
    popup.style.top = `${rect.bottom + 4}px`;
    popup.style.left = `${rect.left}px`;
  }

  document.addEventListener('click', (e) => {
    if (statusPopup && !statusPopup.contains(e.target as Node) && e.target !== activePopupBadge) {
      closeStatusPopup();
    }
  });

  // ── Publish button ────────────────────────────────────────────
  let currentPublished = false;

  function setPublishBtn(published: boolean) {
    currentPublished = published;
    const btn = document.getElementById('form-publish-btn') as HTMLButtonElement;
    if (published) {
      btn.textContent = 'Unpublish';
      btn.className = 'wf-pill pill-light';
      btn.style.color = 'var(--p-50)';
    } else {
      btn.textContent = 'Publish';
      btn.className = 'wf-pill pill-amber';
      btn.style.color = '';
    }
  }

  // ── Modal open / close ────────────────────────────────────────
  function openModal(editId?: string) {
    modal.classList.add('is-open');
    setActiveTab('bakery');
    if (!bodyEditor) initBodyEditor();
    if (!editId) {
      titleEl.textContent = 'Add Bakery';
      form.reset();
      (field('f-id') as HTMLInputElement).value = '';
      populateLocations(null);
      (field('f-thumbnail') as HTMLInputElement).value = '';
      (document.getElementById('f-thumb-preview') as HTMLImageElement).style.display = 'none';
      (document.getElementById('f-upload-status') as HTMLElement).textContent = '';
      (field('f-hero-image-url') as HTMLInputElement).value = '';
      (document.getElementById('f-hero-img-preview') as HTMLImageElement).style.display = 'none';
      (document.getElementById('f-hero-upload-status') as HTMLElement).textContent = '';
      (document.getElementById('hero-tab-dot') as HTMLElement).style.display = 'none';
      updateHeroPreview();
      populateCredits(null);
      imgListEl.innerHTML = '';
      if (bodyEditor) bodyEditor.commands.setContent('');
      else _pendingContent = '';
      setPublishBtn(false);
    }
    modalMsg.classList.remove('is-visible');
  }
  function closeModal() { modal.classList.remove('is-open'); }

  [overlay, closeBtn, cancelBtn].forEach(el => el.addEventListener('click', closeModal));
  addBtn.addEventListener('click', () => openModal());

  // ── Thumbnail upload ──────────────────────────────────────────
  document.getElementById('f-thumb-file')!.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const statusEl = document.getElementById('f-upload-status')!;
    statusEl.textContent = 'Uploading…';
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { statusEl.textContent = 'Not authenticated'; return; }
    const fd = new FormData(); fd.append('image', file);
    const res  = await fetch('/api/upload', { method: 'POST', headers: { Authorization: `Bearer ${session.access_token}` }, body: fd });
    const json = await res.json() as { url?: string; error?: string };
    if (json.error) { statusEl.textContent = `Error: ${json.error}`; return; }
    (field('f-thumbnail') as HTMLInputElement).value = json.url ?? '';
    const preview = document.getElementById('f-thumb-preview') as HTMLImageElement;
    preview.src = json.url ?? ''; preview.style.display = 'block';
    statusEl.textContent = 'Uploaded ✓';
  });

  // ── Hero image upload ─────────────────────────────────────────
  document.getElementById('f-hero-img-file')!.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const statusEl = document.getElementById('f-hero-upload-status')!;
    statusEl.textContent = 'Uploading…';
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { statusEl.textContent = 'Not authenticated'; return; }
    const fd = new FormData(); fd.append('image', file);
    const res  = await fetch('/api/upload', { method: 'POST', headers: { Authorization: `Bearer ${session.access_token}` }, body: fd });
    const json = await res.json() as { url?: string; error?: string };
    if (json.error) { statusEl.textContent = `Error: ${json.error}`; return; }
    (field('f-hero-image-url') as HTMLInputElement).value = json.url ?? '';
    const preview = document.getElementById('f-hero-img-preview') as HTMLImageElement;
    preview.src = json.url ?? ''; preview.style.display = 'block';
    statusEl.textContent = 'Uploaded ✓';
    updateHeroPreview();
  });

  // ── Hero live preview ─────────────────────────────────────────
  function updateHeroPreview() {
    const img        = (field('f-hero-image-url') as HTMLInputElement).value.trim();
    const title      = (field('f-hero-title') as HTMLInputElement).value.trim();
    const tag        = (field('f-hero-tag') as HTMLInputElement).value.trim();
    const subtitle   = (field('f-hero-subtitle') as HTMLTextAreaElement).value.trim();
    const bgWord     = (field('f-hero-bg-word') as HTMLInputElement).value.trim();
    const bakeryName = (field('f-name') as HTMLInputElement).value.trim();
    const epNum      = (field('f-episode-number') as HTMLInputElement).value.trim();

    const wrap      = document.getElementById('hero-preview-wrap')!;
    const bg        = document.getElementById('hero-preview-bg')!;
    const bgWordEl  = document.getElementById('hero-preview-bgword')!;
    const eyebrowEl = document.getElementById('hero-preview-eyebrow')!;
    const tagEl     = document.getElementById('hero-preview-tag')!;
    const metaEl    = document.getElementById('hero-preview-meta')!;
    const titleEl2  = document.getElementById('hero-preview-title')!;
    const bakeryEl  = document.getElementById('hero-preview-bakery')!;
    const subEl     = document.getElementById('hero-preview-subtitle')!;

    const hasContent = img || title || tag;
    wrap.style.display = hasContent ? '' : 'none';

    bg.style.backgroundImage = img ? `url('${img}')` : '';
    bgWordEl.textContent = bgWord;

    eyebrowEl.style.display = tag ? '' : 'none';
    tagEl.textContent  = tag;
    metaEl.textContent = epNum ? `EP. ${String(epNum).padStart(2, '0')} · NOW PLAYING` : 'NOW PLAYING';

    titleEl2.textContent       = title;
    bakeryEl.textContent       = bakeryName;
    bakeryEl.style.display     = bakeryName ? '' : 'none';
    subEl.textContent          = subtitle;
  }

  ['f-hero-title', 'f-hero-tag', 'f-hero-subtitle', 'f-hero-bg-word', 'f-episode-number'].forEach(id => {
    field(id)!.addEventListener('input', updateHeroPreview);
  });

  // ── Slug auto-generate ────────────────────────────────────────
  (field('f-name') as HTMLInputElement).addEventListener('input', (e) => {
    if (!(field('f-id') as HTMLInputElement).value) {
      (field('f-slug') as HTMLInputElement).value = (e.target as HTMLInputElement).value
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim();
    }
    updateHeroPreview();
  });

  // ── Save ──────────────────────────────────────────────────────
  async function saveBakery(published: boolean, openPreview = false) {
    const draftBtn   = document.getElementById('form-draft-btn') as HTMLButtonElement;
    const previewBtn = document.getElementById('form-preview-btn') as HTMLButtonElement;
    const publishBtn = document.getElementById('form-publish-btn') as HTMLButtonElement;
    [draftBtn, previewBtn, publishBtn].forEach(b => { b.disabled = true; });

    const id      = (field('f-id') as HTMLInputElement).value;
    const nameVal = (field('f-name') as HTMLInputElement).value.trim();
    const slug    = (field('f-slug') as HTMLInputElement).value.trim();

    if (!nameVal || !slug) {
      const basicsBtn = document.querySelector<HTMLElement>('.bk-tab[data-tab="bakery"]');
      basicsBtn?.classList.add('is-error');
      setTimeout(() => basicsBtn?.classList.remove('is-error'), 2000);
      switchTab('bakery');
      showMsg(modalMsg, 'Name and slug are required.', 'error');
      [draftBtn, previewBtn, publishBtn].forEach(b => { b.disabled = false; });
      return;
    }

    const bodyHtml   = bodyEditor ? bodyEditor.getHTML() : '';
    const normalBody = bodyHtml === '<p></p>' ? null : bodyHtml || null;

    const payload: Record<string, unknown> = {
      name:           nameVal,
      slug,
      category:       (field('f-category') as HTMLInputElement).value.trim(),
      website:        (field('f-website') as HTMLInputElement).value.trim() || null,
      instagram:      (field('f-instagram') as HTMLInputElement).value.trim() || null,
      hours:          (field('f-hours') as HTMLInputElement).value.trim() || null,
      date:           (field('f-date') as HTMLInputElement).value.trim() || null,
      episode_number: parseInt((field('f-episode-number') as HTMLInputElement).value) || null,
      duration:       (field('f-duration') as HTMLInputElement).value.trim() || null,
      video_id:       (field('f-video-id') as HTMLInputElement).value.trim() || null,
      map_link:       (field('f-map-link') as HTMLInputElement).value.trim() || null,
      quote:          (field('f-quote') as HTMLTextAreaElement).value.trim() || null,
      credits:        getCreditsData(),
      description:    (field('f-description') as HTMLTextAreaElement).value.trim() || null,
      thumbnail:      (field('f-thumbnail') as HTMLInputElement).value.trim() || null,
      hero_tag:       (field('f-hero-tag') as HTMLInputElement).value.trim() || null,
      hero_title:     (field('f-hero-title') as HTMLInputElement).value.trim() || null,
      hero_subtitle:  (field('f-hero-subtitle') as HTMLTextAreaElement).value.trim() || null,
      hero_bg_word:   (field('f-hero-bg-word') as HTMLInputElement).value.trim() || null,
      loop_video_url: (field('f-loop-video-url') as HTMLInputElement).value.trim() || null,
      hero_image_url: (field('f-hero-image-url') as HTMLInputElement).value.trim() || null,
      images:         getImagesData(),
      body:           normalBody,
      published,
      updated_at:     new Date().toISOString(),
    };

    let error;
    if (id) ({ error } = await supabase.from('bakeries_cms').update(payload).eq('id', id));
    else    ({ error } = await supabase.from('bakeries_cms').insert(payload));

    [draftBtn, previewBtn, publishBtn].forEach(b => { b.disabled = false; });

    if (error) { showMsg(modalMsg, error.message, 'error'); return; }

    await fetch('/api/admin-locations', {
      method: 'POST',
      headers: await authHeaders(),
      body: JSON.stringify({ bakery_slug: slug, locations: getLocationsData() }),
    });

    if (openPreview) {
      setPublishBtn(published);
      window.open(`/bakeries/${slug}?preview=true`, '_blank');
      return;
    }

    closeModal();
    showMsg(msgEl, `Bakery ${id ? 'updated' : 'added'} successfully.`, 'success');
    loadList();
  }

  document.getElementById('form-draft-btn')!.addEventListener('click', () => saveBakery(false));
  document.getElementById('form-preview-btn')!.addEventListener('click', () => saveBakery(false, true));
  document.getElementById('form-publish-btn')!.addEventListener('click', () => saveBakery(!currentPublished));

  // ── Sorting ───────────────────────────────────────────────────
  let sortCol = 'modified';
  let sortDir: 'asc' | 'desc' = 'desc';

  function sortTable(col: string) {
    if (sortCol === col) {
      sortDir = sortDir === 'asc' ? 'desc' : 'asc';
    } else {
      sortCol = col;
      sortDir = 'asc';
    }
    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-id]'));
    rows.sort((a, b) => {
      const av = (a.dataset[col] ?? '').toLowerCase();
      const bv = (b.dataset[col] ?? '').toLowerCase();
      return sortDir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
    });
    rows.forEach(r => tbody.appendChild(r));
    updateSortIcons();
  }

  function updateSortIcons() {
    document.querySelectorAll<HTMLElement>('th.th-sortable').forEach(th => {
      const icon = th.querySelector('.sort-indicator');
      if (!icon) return;
      icon.textContent = th.dataset.sort === sortCol ? (sortDir === 'asc' ? ' ▲' : ' ▼') : '';
    });
  }

  document.querySelectorAll<HTMLElement>('th.th-sortable').forEach(th => {
    th.addEventListener('click', () => sortTable(th.dataset.sort!));
  });

  loadList();
</script>

