  // ── TipTap editor ─────────────────────────────────────────────
  let bodyEditor: Editor | null = null;
  let _pendingContent = '';
  let _savedEditorPos: number | null = null;

  function initBodyEditor() {
    const el = document.getElementById('f-body-content');
    if (!el || bodyEditor) return;
    bodyEditor = new Editor({
      element: el,
      extensions: [
        StarterKit,
        CustomImage,
        Link.configure({ openOnClick: false }),
        Underline,
        TextAlign.configure({ types: ['heading', 'paragraph'] }),
        Youtube.configure({ width: 640, height: 360, nocookie: true }),
        Placeholder.configure({ placeholder: 'Write the bakery story here…' }),
      ],
      content: _pendingContent,
      onTransaction: () => updateToolbar(),
    });
    bindToolbar();

    bodyEditor.on('selectionUpdate', () => {
      const { selection } = bodyEditor!.state;
      const node = selection.$anchor.nodeAfter || selection.$from.nodeAfter;
      const toolbar = document.getElementById('tiptap-img-toolbar');
      if (!toolbar) return;

      if (node?.type.name === 'image') {
        const imgEl = (bodyEditor!.view.nodeDOM(selection.$anchor.pos) as HTMLElement) ||
                      (bodyEditor!.view.nodeDOM(selection.from) as HTMLElement);

        if (imgEl && (imgEl.tagName === 'IMG' || imgEl.querySelector?.('img'))) {
          const actualImg = imgEl.tagName === 'IMG' ? imgEl : imgEl.querySelector('img');
          if (actualImg) {
            const imgRect = actualImg.getBoundingClientRect();
            const wrapEl = document.querySelector('.rte-wrap') as HTMLElement;
            const wrapRect = wrapEl?.getBoundingClientRect();
            if (wrapRect) {
              toolbar.style.display = 'flex';
              toolbar.style.top = (imgRect.top - wrapRect.top - 48 + wrapEl.scrollTop) + 'px';
              toolbar.style.left = (imgRect.left - wrapRect.left) + 'px';
            }
          }
        }

        toolbar.querySelectorAll('.tiptap-img-size-btn').forEach(btn => {
          btn.classList.toggle('active', (btn as HTMLElement).dataset.size === node.attrs.size);
        });
        toolbar.querySelectorAll('.tiptap-img-align-btn').forEach(btn => {
          btn.classList.toggle('active', (btn as HTMLElement).dataset.align === node.attrs.align);
        });

        toolbar.querySelectorAll('.tiptap-img-size-btn').forEach(btn => {
          (btn as HTMLElement).onclick = () => {
            bodyEditor!.chain().focus().updateAttributes('image', { size: (btn as HTMLElement).dataset.size }).run();
          };
        });
        toolbar.querySelectorAll('.tiptap-img-align-btn').forEach(btn => {
          (btn as HTMLElement).onclick = () => {
            bodyEditor!.chain().focus().updateAttributes('image', { align: (btn as HTMLElement).dataset.align }).run();
          };
        });
      } else {
        toolbar.style.display = 'none';
      }
    });
  }

  function updateToolbar() {
    if (!bodyEditor) return;
    document.querySelectorAll<HTMLButtonElement>('.rte-btn[data-cmd]').forEach(btn => {
      const cmd = btn.dataset.cmd!;
      let active = false;
      if (cmd === 'bold')           active = bodyEditor!.isActive('bold');
      else if (cmd === 'italic')    active = bodyEditor!.isActive('italic');
      else if (cmd === 'underline') active = bodyEditor!.isActive('underline');
      else if (cmd === 'h2')        active = bodyEditor!.isActive('heading', { level: 2 });
      else if (cmd === 'h3')        active = bodyEditor!.isActive('heading', { level: 3 });
      else if (cmd === 'bulletList')  active = bodyEditor!.isActive('bulletList');
      else if (cmd === 'orderedList') active = bodyEditor!.isActive('orderedList');
      else if (cmd === 'blockquote')  active = bodyEditor!.isActive('blockquote');
      else if (cmd === 'link')      active = bodyEditor!.isActive('link');
      btn.classList.toggle('is-active', active);
    });
  }

  function bindToolbar() {
    const imgUpload = document.getElementById('rte-img-upload') as HTMLInputElement;
    document.querySelectorAll<HTMLButtonElement>('.rte-btn[data-cmd]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!bodyEditor) return;
        const cmd = btn.dataset.cmd!;
        const chain = bodyEditor.chain().focus();
        if      (cmd === 'bold')        chain.toggleBold().run();
        else if (cmd === 'italic')      chain.toggleItalic().run();
        else if (cmd === 'underline')   chain.toggleUnderline().run();
        else if (cmd === 'h2')          chain.toggleHeading({ level: 2 }).run();
        else if (cmd === 'h3')          chain.toggleHeading({ level: 3 }).run();
        else if (cmd === 'bulletList')  chain.toggleBulletList().run();
        else if (cmd === 'orderedList') chain.toggleOrderedList().run();
        else if (cmd === 'blockquote')  chain.toggleBlockquote().run();
        else if (cmd === 'clearFormat') chain.clearNodes().unsetAllMarks().run();
        else if (cmd === 'image') {
          _savedEditorPos = bodyEditor.state.selection.anchor;
          imgUpload.click();
        } else if (cmd === 'youtube') {
          const url = prompt('YouTube or Vimeo URL:');
          if (url) bodyEditor.commands.setYoutubeVideo({ src: url });
        } else if (cmd === 'link') {
          const prev = bodyEditor.getAttributes('link').href ?? '';
          const url = prompt('URL:', prev);
          if (url === null) return;
          if (url === '') { chain.unsetLink().run(); return; }
          chain.setLink({ href: url }).run();
        }
      });
    });

    imgUpload.addEventListener('change', async () => {
      const file = imgUpload.files?.[0];
      if (!file || !bodyEditor) return;
      imgUpload.value = '';
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;
      const fd = new FormData(); fd.append('image', file);
      const res  = await fetch('/api/upload', { method: 'POST', headers: { Authorization: `Bearer ${session.access_token}` }, body: fd });
      const json = await res.json() as { url?: string; error?: string };
      if (json.url) {
        const pos = _savedEditorPos ?? bodyEditor.state.doc.content.size;
        _savedEditorPos = null;
        bodyEditor.chain().focus(pos).setImage({ src: json.url }).run();
      }
    });
  }

