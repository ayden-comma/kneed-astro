  function createImgRow(src = '', caption = ''): HTMLElement {
    const row = document.createElement('div');
    row.className = 'img-row';
    row.innerHTML = `
      ${src
        ? `<img class="img-row-thumb" src="${src}" alt="" />`
        : `<div class="img-row-placeholder"></div>`
      }
      <input class="admin-form-input img-src" type="url" placeholder="Image URL" value="${src}" />
      <input class="admin-form-input img-caption" type="text" placeholder="Caption (optional)" value="${caption}" />
      <div style="display:flex; gap:0.25rem;">
        <label class="admin-upload-btn admin-btn-sm" title="Upload">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </label>
        <button type="button" class="admin-btn admin-btn-danger admin-btn-sm img-remove-btn" title="Remove">×</button>
      </div>`;

