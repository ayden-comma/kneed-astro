  // ── Dynamic multi-location manager ───────────────────────────
  const PLACES_KEY_LOC = 'AIzaSyB6Dv_E_XEjozZqi_Tenk4AepcpYWHNUas';

  function wireLocationAutocomplete(row: HTMLElement) {
    const input = row.querySelector<HTMLInputElement>('.location-address')!;
    const list  = row.querySelector<HTMLUListElement>('.location-suggestions')!;
    let timer: ReturnType<typeof setTimeout>;

    input.addEventListener('input', () => {
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 3) { list.style.display = 'none'; return; }
      timer = setTimeout(async () => {
        try {
          const res  = await fetch('https://places.googleapis.com/v1/places:autocomplete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Goog-Api-Key': PLACES_KEY_LOC },
            body: JSON.stringify({ input: q, includedRegionCodes: ['au'], includedPrimaryTypes: ['street_address', 'premise'] }),
          });
          const data  = await res.json();
          const preds = (data.suggestions || []) as any[];
          list.innerHTML = '';
          if (!preds.length) { list.style.display = 'none'; return; }
          preds.slice(0, 5).forEach(s => {
            const placeId = s.placePrediction?.placeId || '';
            const text    = s.placePrediction?.text?.text || '';
            const li = document.createElement('li');
            li.textContent = text;
            li.style.cssText = 'padding:0.5rem 0.75rem;cursor:pointer;color:var(--parchment);font-size:0.875rem;';
            li.onmouseenter = () => { li.style.background = 'var(--surface-2)'; };
            li.onmouseleave = () => { li.style.background = ''; };
            li.onclick = async () => {
              list.style.display = 'none';
              const detailRes = await fetch(`https://places.googleapis.com/v1/places/${placeId}?key=${PLACES_KEY_LOC}`, {
                headers: { 'X-Goog-FieldMask': 'location,addressComponents' }
              });
              const place = await detailRes.json();
              if (place.location) {
                (row.querySelector('.location-lat') as HTMLInputElement).value = place.location.latitude;
                (row.querySelector('.location-lng') as HTMLInputElement).value = place.location.longitude;
              }
              if (place.addressComponents) {
                const get = (type: string) => place.addressComponents.find((c: any) => c.types.includes(type))?.longText || '';
                const streetNum  = get('street_number');
                const route      = get('route');
                const locality   = get('locality');
                const state      = get('administrative_area_level_1');
                const postcode   = get('postal_code');

                const street = [streetNum, route].filter(Boolean).join(' ');
                let full     = [street, locality, [state, postcode].filter(Boolean).join(' ')].filter(Boolean).join(', ');
                full = full
                  .replace(/\bStreet\b/g, 'St')
                  .replace(/\bRoad\b/g, 'Rd')
                  .replace(/\bAvenue\b/g, 'Ave')
                  .replace(/\bDrive\b/g, 'Dr')
                  .replace(/\bCourt\b/g, 'Ct')
                  .replace(/\bPlace\b/g, 'Pl')
                  .replace(/\bCrescent\b/g, 'Cres')
                  .replace(/\bBoulevard\b/g, 'Blvd')
                  .replace(/\bTerrace\b/g, 'Tce')
                  .replace(/\bHighway\b/g, 'Hwy')
                  .replace(/\bVictoria\b/g, 'VIC')
                  .replace(/\bNew South Wales\b/g, 'NSW')
                  .replace(/\bQueensland\b/g, 'QLD')
                  .replace(/\bSouth Australia\b/g, 'SA')
                  .replace(/\bWestern Australia\b/g, 'WA')
                  .replace(/\bTasmania\b/g, 'TAS')
                  .replace(/\bNorthern Territory\b/g, 'NT');
                input.value  = full || text;
                (row.querySelector('.location-place-id') as HTMLInputElement).value = placeId;
                console.log('[PLACE_ID] stored:', placeId, 'input value:', (row.querySelector('.location-place-id') as HTMLInputElement)?.value);
                const labelInput = row.querySelector<HTMLInputElement>('.location-label')!;
                if (!labelInput.value && locality) labelInput.value = locality;
              } else {
                input.value = text;
              }
            };
            list.appendChild(li);
          });
          list.style.display = 'block';
        } catch (_) { list.style.display = 'none'; }
      }, 300);
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !list.contains(e.target as Node)) {
        list.style.display = 'none';
      }
    });
  }

