---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Bakeries" activePage="bakeries">
  <div class="admin-page-header">
    <h1 class="admin-page-title">Bakeries</h1>
    <button class="admin-btn admin-btn-primary" id="btn-add-bakery">+ Add Bakery</button>
  </div>

  <div class="admin-section">
    <div id="admin-msg" class="admin-msg"></div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th class="th-sortable" data-sort="name">Name <span class="sort-indicator"></span></th>
            <th>Category</th>
            <th>Suburb</th>
            <th class="th-sortable" data-sort="status">Status <span class="sort-indicator"></span></th>
            <th class="th-sortable" data-sort="modified">Modified <span class="sort-indicator"></span></th>
            <th class="th-sortable" data-sort="publishedAt">Published <span class="sort-indicator"></span></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="bakery-tbody">
          <tr><td colspan="7"><div class="admin-empty">Loading…</div></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<!-- Add/Edit Modal -->
<div id="bakery-modal" class="admin-modal" role="dialog" aria-modal="true">
  <div class="admin-modal-overlay" id="bakery-modal-overlay"></div>
  <div class="admin-modal-card bk-modal-card">
    <div class="admin-modal-header">
      <div class="admin-modal-title" id="modal-title">Add Bakery</div>
      <button class="admin-modal-close" id="bakery-modal-close">×</button>
    </div>
    <div id="modal-msg" class="admin-msg bk-modal-msg"></div>

    <!-- Tab bar -->
    <div class="bk-tab-bar">
      <button type="button" class="bk-tab is-active" data-tab="bakery">Bakery</button>
      <button type="button" class="bk-tab" data-tab="location">Location</button>
      <button type="button" class="bk-tab" data-tab="episode">Episode</button>
      <button type="button" class="bk-tab" data-tab="hero-carousel">Hero Carousel<span class="bk-tab-dot" id="hero-tab-dot" style="display:none;"></span></button>
    </div>

    <form class="admin-form bk-form" id="bakery-form" autocomplete="off">
      <input type="hidden" id="f-id" />

      <div class="bk-tab-content">

        <!-- ── TAB 1: BASICS ──────────────────────────────────── -->
        <div class="bk-tab-panel" data-panel="bakery">
          <div class="admin-form-row">
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-name">Bakery Name *</label>
              <input class="admin-form-input" id="f-name" required />
            </div>
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-slug">Slug *</label>
              <input class="admin-form-input" id="f-slug" required />
            </div>
          </div>
          <div class="admin-form-field">
            <label class="admin-form-label" for="f-category">Category *</label>
            <input class="admin-form-input" id="f-category" placeholder="e.g. Sourdough" required />
          </div>
          <div class="admin-form-field">
            <label class="admin-form-label" for="f-description">Short Description</label>
            <textarea class="admin-form-textarea" id="f-description" rows="2" placeholder="One or two sentences for cards and SEO…"></textarea>
          </div>
          <div class="admin-form-field">
            <label class="admin-form-label">Thumbnail</label>
            <div class="admin-thumb-row">
              <img id="f-thumb-preview" class="admin-img-preview" src="" alt="" style="display:none;" />
              <div>
                <label class="admin-upload-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  Upload image
                  <input type="file" id="f-thumb-file" accept="image/*" style="display:none;" />
                </label>
                <div id="f-upload-status" class="admin-upload-progress" style="margin-top:0.375rem;"></div>
              </div>
            </div>
            <input type="hidden" id="f-thumbnail" />
          </div>
        </div>

        <!-- ── TAB 2: LOCATION ───────────────────────────────── -->
        <div class="bk-tab-panel" data-panel="location" style="display:none;">
          <div class="admin-form-section">
            <span class="admin-form-section-label">Locations</span>
            <div id="f-locations-list"></div>
            <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="btn-add-location" style="margin-top:0.5rem;">+ Add location</button>
          </div>
          <div class="admin-form-field" style="margin-top:0.625rem;">
            <label class="admin-form-label" for="f-hours">Hours <span style="color:var(--p-35);font-size:0.65rem;">(Bakery-wide default)</span></label>
            <input class="admin-form-input" id="f-hours" placeholder="Mon–Fri 7am–3pm" />
          </div>
          <div class="admin-form-row" style="margin-top:0.625rem;">
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-website">Website</label>
              <input class="admin-form-input" id="f-website" type="url" placeholder="https://" />
            </div>
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-instagram">Instagram</label>
              <input class="admin-form-input" id="f-instagram" placeholder="@handle" />
            </div>
          </div>
          <div class="admin-form-field">
            <label class="admin-form-label" for="f-map-link">Google Maps Link</label>
            <input class="admin-form-input" id="f-map-link" placeholder="https://maps.google.com/?q=..." />
          </div>
        </div>

        <!-- ── TAB 3: FILM ────────────────────────────────────── -->
        <div class="bk-tab-panel" data-panel="episode" style="display:none;">
          <!-- 2×2 grid: Date/Ep#, Duration/VideoID -->
          <div class="admin-form-row">
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-date">Date</label>
              <input class="admin-form-input" id="f-date" placeholder="e.g. April 2025" />
            </div>
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-episode-number">Ep #</label>
              <input class="admin-form-input" id="f-episode-number" type="number" placeholder="e.g. 1" />
            </div>
          </div>
          <div class="admin-form-row" style="margin-top:0.625rem;">
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-duration">Duration</label>
              <input class="admin-form-input" id="f-duration" placeholder="e.g. 06:42" />
            </div>
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-video-id">Video ID</label>
              <input class="admin-form-input" id="f-video-id" placeholder="YouTube or Vimeo ID" />
            </div>
          </div>

          <!-- Pull Quote -->
          <div class="admin-form-field" style="margin-top:0.875rem;">
            <label class="admin-form-label" for="f-quote">Pull Quote</label>
            <textarea class="admin-form-textarea" id="f-quote" rows="2" placeholder="A memorable line about this bakery…"></textarea>
          </div>

          <!-- Film Credits -->
          <div class="admin-form-section">
            <span class="admin-form-section-label">Film Credits</span>
            <div id="f-credits-list"></div>
            <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="btn-add-credit" style="margin-top:0.5rem;">+ Add credit</button>
          </div>

          <!-- Image Gallery -->
          <div class="admin-form-section">
            <span class="admin-form-section-label">Image Gallery</span>
            <div class="admin-form-field" style="margin-top:0.875rem;">
              <div id="f-images-list"></div>
              <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="btn-add-image" style="margin-top:0.5rem;">+ Add Image</button>
              <input type="file" id="f-img-upload-trigger" accept="image/*" style="display:none;" />
            </div>
          </div>

          <!-- Body Content (TipTap) -->
          <div class="admin-form-section">
            <span class="admin-form-section-label">Body Content</span>
            <div class="admin-form-field">
              <div class="rte-wrap" id="tiptap-editor">
                <div class="rte-toolbar" id="rte-toolbar">
                  <button type="button" class="rte-btn" data-cmd="bold" title="Bold">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
                  </button>
                  <button type="button" class="rte-btn" data-cmd="italic" title="Italic">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>
                  </button>
                  <button type="button" class="rte-btn" data-cmd="underline" title="Underline">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v6a6 6 0 0 0 12 0V4"/><line x1="4" y1="20" x2="20" y2="20"/></svg>
                  </button>
                  <div class="rte-sep"></div>
                  <button type="button" class="rte-btn" data-cmd="h2" title="Heading 2">H2</button>
                  <button type="button" class="rte-btn" data-cmd="h3" title="Heading 3">H3</button>
                  <div class="rte-sep"></div>
                  <button type="button" class="rte-btn" data-cmd="bulletList" title="Bullet list">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                  </button>
                  <button type="button" class="rte-btn" data-cmd="orderedList" title="Ordered list">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>
                  </button>
                  <button type="button" class="rte-btn" data-cmd="blockquote" title="Blockquote">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
                  </button>
                  <div class="rte-sep"></div>
                  <button type="button" class="rte-btn" data-cmd="image" title="Insert image">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  </button>
                  <button type="button" class="rte-btn" data-cmd="youtube" title="Embed YouTube/Vimeo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
                  </button>
                  <button type="button" class="rte-btn" data-cmd="link" title="Insert link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  </button>
                  <div class="rte-sep"></div>
                  <button type="button" class="rte-btn" data-cmd="clearFormat" title="Clear formatting">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4h16v3"/><path d="M5 20h6"/><path d="M13 4 8 20"/><line x1="17" y1="12" x2="22" y2="17"/><line x1="22" y1="12" x2="17" y2="17"/></svg>
                  </button>
                </div>
                <div class="rte-content" id="f-body-content"></div>
                <div id="tiptap-img-toolbar" class="tiptap-img-toolbar" style="display:none;">
                  <span class="tiptap-img-toolbar-label">Size</span>
                  <button type="button" class="tiptap-img-size-btn" data-size="small">S</button>
                  <button type="button" class="tiptap-img-size-btn" data-size="medium">M</button>
                  <button type="button" class="tiptap-img-size-btn" data-size="large">L</button>
                  <button type="button" class="tiptap-img-size-btn" data-size="full">Full</button>
                  <span class="tiptap-img-toolbar-divider"></span>
                  <span class="tiptap-img-toolbar-label">Align</span>
                  <button type="button" class="tiptap-img-align-btn" data-align="left">←</button>
                  <button type="button" class="tiptap-img-align-btn" data-align="center">↔</button>
                  <button type="button" class="tiptap-img-align-btn" data-align="right">→</button>
                </div>
                <input type="file" id="rte-img-upload" accept="image/*" style="display:none;" />
              </div>
            </div>
          </div>
        </div>

        <!-- ── TAB 4: HERO ───────────────────────────────────── -->
        <div class="bk-tab-panel" data-panel="hero-carousel" style="display:none;">
          <p style="font-size:0.75rem; color:var(--p-35); margin:0 0 0.875rem;">Controls how this bakery appears in the homepage hero carousel.</p>
          <div class="admin-form-row">
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-hero-tag">Tag (e.g. Sourdough, Pastry)</label>
              <input class="admin-form-input" id="f-hero-tag" placeholder="e.g. Sourdough" />
            </div>
            <div class="admin-form-field">
              <label class="admin-form-label" for="f-hero-title">Hero Title</label>
              <input class="admin-form-input" id="f-hero-title" />
            </div>
          </div>
          <div class="admin-form-field" style="margin-top:0.625rem;">
            <label class="admin-form-label" for="f-hero-subtitle">Hero Subtitle</label>
            <textarea class="admin-form-textarea" id="f-hero-subtitle" rows="3"></textarea>
          </div>
          <div class="admin-form-field" style="margin-top:0.625rem;">
            <label class="admin-form-label" for="f-hero-bg-word">Background Word (displays large behind hero)</label>
            <input class="admin-form-input" id="f-hero-bg-word" placeholder="e.g. BREAD" />
          </div>
          <div class="admin-form-field" style="margin-top:0.625rem;">
            <label class="admin-form-label" for="f-loop-video-url">Loop Video (short clip, autoplays silently behind hero)</label>
            <input class="admin-form-input" id="f-loop-video-url" placeholder="https://res.cloudinary.com/... (MP4 URL)" />
          </div>
          <div class="admin-form-field" style="margin-top:0.875rem;">
            <label class="admin-form-label">Hero Image</label>
            <div class="admin-thumb-row">
              <img id="f-hero-img-preview" class="admin-img-preview" src="" alt="" style="display:none;" />
              <div>
                <label class="admin-upload-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  Upload image
                  <input type="file" id="f-hero-img-file" accept="image/*" style="display:none;" />
                </label>
                <div id="f-hero-upload-status" class="admin-upload-progress" style="margin-top:0.375rem;"></div>
              </div>
            </div>
            <input type="hidden" id="f-hero-image-url" />
          </div>

          <div class="hero-preview-wrap" id="hero-preview-wrap" style="display:none; margin-top:1.25rem;">
            <div class="admin-form-section-label" style="margin-bottom:0.625rem;">Preview</div>
            <div class="hero-preview" id="hero-preview">
              <div class="hero-preview-bg" id="hero-preview-bg"></div>
              <div class="hero-preview-bgword" id="hero-preview-bgword"></div>
              <div class="hero-preview-content">
                <div class="hero-preview-eyebrow" id="hero-preview-eyebrow">
                  <span class="hero-preview-eyebrow-dot"></span>
                  <span class="hero-preview-eyebrow-tag" id="hero-preview-tag"></span>
                  <span class="hero-preview-eyebrow-rule"></span>
                  <span class="hero-preview-eyebrow-meta" id="hero-preview-meta"></span>
                </div>
                <div class="hero-preview-title" id="hero-preview-title"></div>
                <div class="hero-preview-bakery" id="hero-preview-bakery"></div>
                <div class="hero-preview-subtitle" id="hero-preview-subtitle"></div>
                <div class="hero-preview-cta">
                  <span class="hero-preview-watch-btn">
                    <svg viewBox="0 0 24 24" width="7" height="7" fill="currentColor"><polygon points="6,4 20,12 6,20"/></svg>
                    WATCH NOW
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /.bk-tab-content -->

      <!-- Action buttons — outside scrollable area, always visible -->
      <div class="bk-modal-actions">
        <button type="button" class="wf-pill pill-light" id="form-draft-btn">Save Draft</button>
        <button type="button" class="wf-pill pill-light" id="form-preview-btn" style="display:inline-flex; align-items:center; gap:0.3rem;">
          Preview
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </button>
        <button type="button" class="wf-pill pill-amber" id="form-publish-btn">Publish</button>
        <button type="button" class="admin-btn admin-btn-ghost" id="form-cancel-btn">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
  import { supabase } from '../../lib/supabase';

  async function authHeaders(): Promise<HeadersInit> {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.href = '/auth/login'; throw new Error('Session expired'); }
    return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` };
  }
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Image from '@tiptap/extension-image';

  const CustomImage = Image.extend({
    addAttributes() {
      return {
        ...this.parent?.(),
        size: {
          default: 'full',
          parseHTML: element => element.getAttribute('data-size') || 'full',
          renderHTML: attributes => ({
            'data-size': attributes.size,
            class: (attributes.class || '') + ' tiptap-img-' + attributes.size,
          }),
        },
        align: {
          default: 'center',
          parseHTML: element => element.getAttribute('data-align') || 'center',
          renderHTML: attributes => ({
            'data-align': attributes.align,
          }),
        },
      };
    },
  });
  import Link from '@tiptap/extension-link';
  import Underline from '@tiptap/extension-underline';
  import TextAlign from '@tiptap/extension-text-align';
  import Youtube from '@tiptap/extension-youtube';
  import Placeholder from '@tiptap/extension-placeholder';

  // ── Types ─────────────────────────────────────────────────────
  type BakeryRow = {
    id: string; name: string; slug: string; category: string;
    suburb: string | null; published: boolean;
    updated_at: string | null; published_at: string | null;
  };
  type ImgRow = { src: string; caption: string };

  // ── DOM refs ──────────────────────────────────────────────────
  const modal     = document.getElementById('bakery-modal')!;
  const overlay   = document.getElementById('bakery-modal-overlay')!;
  const closeBtn  = document.getElementById('bakery-modal-close')!;
  const cancelBtn = document.getElementById('form-cancel-btn')!;
  const addBtn    = document.getElementById('btn-add-bakery')!;
  const form      = document.getElementById('bakery-form') as HTMLFormElement;
  const titleEl   = document.getElementById('modal-title')!;
  const msgEl     = document.getElementById('admin-msg')!;
  const modalMsg  = document.getElementById('modal-msg')!;
  const tbody     = document.getElementById('bakery-tbody')!;

  // ── Tab switching ─────────────────────────────────────────────
  let currentTab = 'bakery';

  function setActiveTab(tab: string) {
    document.querySelectorAll<HTMLElement>('.bk-tab-panel').forEach(p => {
      const active = p.dataset.panel === tab;
      p.style.display = active ? '' : 'none';
      p.style.opacity = active ? '1' : '';
      p.style.transform = '';
    });
    document.querySelectorAll<HTMLElement>('.bk-tab').forEach(b => {
      b.classList.toggle('is-active', b.dataset.tab === tab);
    });
    currentTab = tab;
  }

  function switchTab(toTab: string) {
    if (toTab === currentTab) return;
    const leaving  = document.querySelector<HTMLElement>(`.bk-tab-panel[data-panel="${currentTab}"]`);
    const arriving = document.querySelector<HTMLElement>(`.bk-tab-panel[data-panel="${toTab}"]`);
    const leavingBtn  = document.querySelector<HTMLElement>(`.bk-tab[data-tab="${currentTab}"]`);
    const arrivingBtn = document.querySelector<HTMLElement>(`.bk-tab[data-tab="${toTab}"]`);
    if (!leaving || !arriving) return;

    leaving.style.opacity = '0';
    leaving.style.transform = 'translateY(6px)';

    setTimeout(() => {
      leaving.style.display = 'none';
      leaving.style.opacity = '';
      leaving.style.transform = '';
      arriving.style.display = '';
      arriving.style.opacity = '0';
      arriving.style.transform = 'translateY(6px)';
      arriving.getBoundingClientRect(); // force reflow
      setTimeout(() => {
        arriving.style.opacity = '1';
