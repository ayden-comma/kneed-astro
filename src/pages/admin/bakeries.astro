  function updateThumb(row: HTMLElement, src: string) {
    const existing    = row.querySelector<HTMLImageElement>('.img-row-thumb');
    const placeholder = row.querySelector('.img-row-placeholder');
    if (src) {
      if (existing) { existing.src = src; }
      else {
        const img = document.createElement('img');
        img.className = 'img-row-thumb'; img.src = src; img.alt = '';
        placeholder?.replaceWith(img);
      }
    } else {
      if (existing) { const ph = document.createElement('div'); ph.className = 'img-row-placeholder'; existing.replaceWith(ph); }
    }
  }

  function getImagesData(): ImgRow[] | null {
    const rows = imgListEl.querySelectorAll<HTMLElement>('.img-row');
    const result: ImgRow[] = [];
    rows.forEach(row => {
      const src     = (row.querySelector<HTMLInputElement>('.img-src')?.value ?? '').trim();
      const caption = (row.querySelector<HTMLInputElement>('.img-caption')?.value ?? '').trim();
      if (src) result.push({ src, caption });
