    const srcInput = row.querySelector<HTMLInputElement>('.img-src')!;
    srcInput.addEventListener('change', () => updateThumb(row, srcInput.value));
    row.querySelector('.img-remove-btn')!.addEventListener('click', () => row.remove());
    return row;
