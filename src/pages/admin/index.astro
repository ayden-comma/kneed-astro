---
// SECURITY: Keep this page a client-fetched shell. Do NOT fetch or render data server-side here — there is no server-side auth gate (session lives in localStorage, not cookies). Data is loaded client-side after adminCheck verifies admin role, and the API routes enforce auth via requireAdmin. Server-rendering data here would leak it to unauthenticated visitors.
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard" activePage="dashboard">
  <div class="admin-page-header">
    <h1 class="admin-page-title">Dashboard</h1>
  </div>

  <div class="admin-stats">
    <a class="admin-stat-link" href="/admin/bakeries">
      <div class="admin-stat-card">
        <div class="admin-stat-num" id="stat-bakeries">—</div>
        <div class="admin-stat-label">Bakeries</div>
      </div>
    </a>
    <a class="admin-stat-link" href="/admin/members">
      <div class="admin-stat-card">
        <div class="admin-stat-num" id="stat-members">—</div>
        <div class="admin-stat-label">Members</div>
      </div>
    </a>
    <a class="admin-stat-link" href="/admin/comments">
      <div class="admin-stat-card">
        <div class="admin-stat-num" id="stat-comments">—</div>
        <div class="admin-stat-label">Comments</div>
      </div>
    </a>
    <a class="admin-stat-link" href="/admin/submissions">
      <div class="admin-stat-card">
        <div class="admin-stat-num" id="stat-pending">—</div>
        <div class="admin-stat-label">Pending Submissions</div>
      </div>
    </a>
  </div>

  <div class="admin-dash-grid">
    <div class="admin-section">
      <div class="admin-section-title">Recent Comments</div>
      <div id="recent-comments"><div class="admin-empty">Loading…</div></div>
    </div>
    <div class="admin-section">
      <div class="admin-section-title">New Members</div>
      <div id="recent-members"><div class="admin-empty">Loading…</div></div>
    </div>
  </div>

</AdminLayout>

<style>
  /* Summary cards are now links — keep the card visuals identical, add a subtle hover. */
  .admin-stat-link { display: block; text-decoration: none; color: inherit; cursor: pointer; }
  .admin-stat-link .admin-stat-card { transition: border-color 0.15s, background 0.15s; }
  .admin-stat-link:hover .admin-stat-card { border-color: var(--border-md); background: var(--surface-3); }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  function timeAgo(dateStr: string) {
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 60) return `${mins}m ago`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h ago`;
    return `${Math.floor(hrs / 24)}d ago`;
  }

  async function loadDashboard() {
    const { data: { session } } = await supabase.auth.getSession();

    // ── Anon-readable: bakeries count, comments count, recent comments ──
    const [
      { count: bakeryCount },
      { count: commentCount },
      { data: recentComments },
    ] = await Promise.all([
      supabase.from('bakeries_cms').select('*', { count: 'exact', head: true }),
      supabase.from('comments').select('*', { count: 'exact', head: true }),
      supabase.from('comments').select('id, content, bakery_slug, created_at').order('created_at', { ascending: false }).limit(5),
    ]);

    const s = (id: string, val: number | null) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(val ?? 0);
    };
    s('stat-bakeries', bakeryCount);
    s('stat-comments', commentCount);

    const commentsEl = document.getElementById('recent-comments')!;
    const arr = (recentComments ?? []) as { id: string; content: string; bakery_slug: string; created_at: string }[];
    commentsEl.innerHTML = arr.length === 0
      ? '<div class="admin-empty">No comments yet.</div>'
      : arr.map(c => `
          <a href="/bakeries/${c.bakery_slug}#comment-${c.id}" target="_blank" rel="noopener" style="display:block;text-decoration:none;color:inherit;">
          <div class="admin-activity-item">
            <div class="admin-activity-dot"></div>
            <div>
              <div class="admin-activity-text" style="max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${c.content}</div>
              <div class="admin-activity-meta">${c.bakery_slug} · ${timeAgo(c.created_at)}</div>
            </div>
          </div>
          </a>`).join('');

    // ── Gated: members count, pending count, recent members ──
    if (!session) {
      document.getElementById('stat-members')!.textContent  = '—';
      document.getElementById('stat-pending')!.textContent  = '—';
      document.getElementById('recent-members')!.innerHTML  = '<div class="admin-empty">Sign in required</div>';
      return;
    }

    const dashRes = await fetch('/api/admin-dashboard', {
      headers: { 'Authorization': `Bearer ${session.access_token}` },
    });

    if (!dashRes.ok) {
      document.getElementById('stat-members')!.textContent  = '—';
      document.getElementById('stat-pending')!.textContent  = '—';
      document.getElementById('recent-members')!.innerHTML  = '<div class="admin-empty">Couldn\'t load member data</div>';
      return;
    }

    const { membersCount, pendingCount, recentMembers } = await dashRes.json() as {
      membersCount: number | null;
      pendingCount: number | null;
      recentMembers: { id: string; display_name: string | null; created_at: string }[] | null;
    };

    s('stat-members', membersCount);
    s('stat-pending', pendingCount);

    const membersEl = document.getElementById('recent-members')!;
    const marr = recentMembers ?? [];
    membersEl.innerHTML = marr.length === 0
      ? '<div class="admin-empty">No members yet.</div>'
      : marr.map(m => `
          <a href="/admin/members/${m.id}" style="display:block;text-decoration:none;color:inherit;">
          <div class="admin-activity-item">
            <div class="admin-activity-dot"></div>
            <div>
              <div class="admin-activity-text">${m.display_name || 'Anonymous'}</div>
              <div class="admin-activity-meta">Joined ${timeAgo(m.created_at)}</div>
            </div>
          </div>
          </a>`).join('');
  }

  // Run after adminCheck has revealed the content
  const observer = new MutationObserver(() => {
    const content = document.getElementById('admin-content');
    if (content && content.style.display !== 'none') {
      observer.disconnect();
      loadDashboard();
    }
  });
  observer.observe(document.body, { childList: false, attributes: true, subtree: true });
  // Also try immediately in case content is already visible
  const content = document.getElementById('admin-content');
  if (content && content.style.display !== 'none') {
    loadDashboard();
  }
</script>
