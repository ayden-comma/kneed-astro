---
// SECURITY: Keep this page a client-fetched shell. Do NOT fetch or render data server-side here — there is no server-side auth gate (session lives in localStorage, not cookies). Data is loaded client-side after adminCheck verifies admin role, and the API routes enforce auth via requireAdmin. Server-rendering data here would leak it to unauthenticated visitors.
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Announce" activePage="announce">
  <div class="admin-page-header">
    <h1 class="admin-page-title">Announce</h1>
  </div>

  <div class="admin-section">
    <div id="admin-msg" class="admin-msg"></div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th class="th-sortable" data-sort="episode" style="cursor:pointer;">Episode <span class="sort-ind" data-for="episode"></span></th>
            <th class="th-sortable" data-sort="name" style="cursor:pointer;">Name <span class="sort-ind" data-for="name"></span></th>
            <th class="th-sortable" data-sort="status" style="cursor:pointer;">Status <span class="sort-ind" data-for="status"></span></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="announce-tbody">
          <tr><td colspan="4"><div class="admin-empty">Loading…</div></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<!-- Email preview modal (populated client-side; iframe srcdoc = rendered email HTML) -->
<div id="preview-modal" style="display:none; position:fixed; inset:0; z-index:1000; align-items:flex-start; justify-content:center; padding:2rem 1rem; background:rgba(0,0,0,0.75); overflow-y:auto;">
  <div style="position:relative; width:100%; max-width:640px; background:#f2ede6; border-radius:8px; overflow:hidden;">
    <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:0.75rem 1rem; background:#0e0c0a;">
      <span style="color:#f2ede6; font-family:var(--font-cond); font-size:0.75rem; letter-spacing:0.15em; text-transform:uppercase;">Email preview</span>
      <button id="preview-close" class="admin-btn admin-btn-ghost" type="button">Close</button>
    </div>
    <iframe id="preview-frame" title="Email preview" style="display:block; width:100%; height:80vh; border:0; background:#e4ddd2;"></iframe>
  </div>
</div>

<script>
  import { supabase } from '../../lib/supabase';

  async function authHeaders(): Promise<HeadersInit> {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.href = '/auth/login'; throw new Error('Session expired'); }
    return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` };
  }

  type EpisodeRow = { id: string; name: string; episode_number: number | null; announced_at: string | null };
  type AnnounceResp = {
    ok?: boolean;
    error?: string;
    sentTo?: string;
    subscriberCount?: number;
    recipientCount?: number;
    failedChunks?: number;
    alreadyAnnounced?: boolean;
    announcedAt?: string;
    html?: string;
  };

  const OK_COLOR = 'var(--amber)';
  const ERR_COLOR = '#e05555';

  const tbody = document.getElementById('announce-tbody')!;
  const msgEl = document.getElementById('admin-msg')!;

  type SortKey = 'episode' | 'name' | 'status';
  let _rows: EpisodeRow[] = [];
  let _sortKey: SortKey = 'episode';
  let _sortDir: 1 | -1 = 1; // 1 = ascending, -1 = descending

  function esc(v: unknown): string {
    return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function fmtDate(s: string | null | undefined): string {
    if (!s) return '';
    const d = new Date(s);
    return isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
  }
  function inlineOf(btn: HTMLElement): HTMLElement {
    return btn.closest('td')!.querySelector('.announce-inline') as HTMLElement;
  }
  async function postAnnounce(payload: Record<string, unknown>): Promise<AnnounceResp> {
    const res = await fetch('/api/admin-send-announcement', {
      method: 'POST',
      headers: await authHeaders(),
      body: JSON.stringify(payload),
    });
    return await res.json().catch(() => ({})) as AnnounceResp;
  }

  function rowHTML(r: EpisodeRow): string {
    const ep = r.episode_number ? 'Ep. ' + String(r.episode_number).padStart(2, '0') : '';
    const announced = !!r.announced_at;
    const status = announced ? '✓ Announced ' + fmtDate(r.announced_at) : 'Not announced yet';
    // Once an episode has gone out, demote the live-send button to a quiet ghost so the
    // page isn't a wall of identical orange "send to everyone" buttons. The double-send
    // guard in the API still applies either way.
    const liveBtn = announced
      ? `<button class="admin-btn admin-btn-ghost btn-live" data-id="${esc(r.id)}">Send again…</button>`
      : `<button class="admin-btn admin-btn-primary btn-live" data-id="${esc(r.id)}">Send to all subscribers</button>`;
    return `<tr>
      <td>${esc(ep)}</td>
      <td>${esc(r.name)}</td>
      <td${announced ? ' style="color:var(--amber);"' : ''}>${esc(status)}</td>
      <td>
        <div style="display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
          <button class="admin-btn admin-btn-ghost btn-preview" data-id="${esc(r.id)}">Preview</button>
          <button class="admin-btn admin-btn-ghost btn-test" data-id="${esc(r.id)}">Send test to me</button>
          ${liveBtn}
        </div>
        <div class="announce-inline" style="margin-top:0.5rem; font-size:0.85rem; line-height:1.5;"></div>
      </td>
    </tr>`;
  }

  function sortRows(rows: EpisodeRow[]): EpisodeRow[] {
    const copy = rows.slice();
    copy.sort((a, b) => {
      let cmp = 0;
      if (_sortKey === 'episode') {
        const an = a.episode_number, bn = b.episode_number;
        if (an == null && bn == null) cmp = 0;
        else if (an == null) return 1;   // null episode numbers always last
        else if (bn == null) return -1;
        else cmp = an - bn;
      } else if (_sortKey === 'name') {
        cmp = (a.name || '').localeCompare(b.name || '', undefined, { sensitivity: 'base' });
      } else { // status: announced state, then announced_at
        const aa = a.announced_at ? 1 : 0;
        const bb = b.announced_at ? 1 : 0;
        if (aa !== bb) cmp = aa - bb;
        else if (a.announced_at && b.announced_at) cmp = new Date(a.announced_at).getTime() - new Date(b.announced_at).getTime();
        else cmp = 0;
      }
      return cmp * _sortDir;
    });
    return copy;
  }

  function updateSortIndicators() {
    document.querySelectorAll<HTMLElement>('.sort-ind').forEach((el) => {
      el.textContent = el.dataset.for === _sortKey ? (_sortDir === 1 ? '▲' : '▼') : '';
    });
  }

  function render() {
    if (_rows.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4"><div class="admin-empty">No published episodes yet.</div></td></tr>';
    } else {
      tbody.innerHTML = sortRows(_rows).map(rowHTML).join('');
      bindRows();
    }
    updateSortIndicators();
  }

  async function loadList() {
    const { data, error } = await supabase
      .from('bakeries_cms')
      .select('id, name, episode_number, announced_at')
      .eq('published', true)
      .order('episode_number', { ascending: true });
    if (error) {
      tbody.innerHTML = `<tr><td colspan="4"><div class="admin-empty">Error: ${esc(error.message)}</div></td></tr>`;
      return;
    }
    _rows = (data ?? []) as EpisodeRow[];
    render();
  }

  function bindRows() {
    tbody.querySelectorAll<HTMLButtonElement>('.btn-preview').forEach(btn => {
      btn.addEventListener('click', () => openPreview(btn));
    });
    tbody.querySelectorAll<HTMLButtonElement>('.btn-test').forEach(btn => {
      btn.addEventListener('click', () => sendTest(btn));
    });
    tbody.querySelectorAll<HTMLButtonElement>('.btn-live').forEach(btn => {
      btn.addEventListener('click', () => startLive(btn, false));
    });
  }

  async function sendTest(btn: HTMLElement) {
    const id = btn.dataset.id!;
    const inline = inlineOf(btn);
    inline.style.color = '';
    inline.textContent = 'Sending test…';
    try {
      const data = await postAnnounce({ bakeryId: id, mode: 'test' });
      if (data.ok) { inline.style.color = OK_COLOR; inline.textContent = 'Test sent to ' + esc(data.sentTo ?? 'you'); }
      else { inline.style.color = ERR_COLOR; inline.textContent = data.error ?? 'Test failed'; }
    } catch {
      inline.style.color = ERR_COLOR; inline.textContent = 'Network error';
    }
  }

  // Get the subscriber count, then reveal an in-page confirm line (no native confirm()).
  async function startLive(btn: HTMLElement, force: boolean) {
    const inline = inlineOf(btn);
    inline.style.color = '';
    inline.textContent = 'Checking subscribers…';
    let count = 0;
    try {
      const data = await postAnnounce({ mode: 'count' });
      if (!data.ok) { inline.style.color = ERR_COLOR; inline.textContent = data.error ?? 'Could not get subscriber count'; return; }
      count = data.subscriberCount ?? 0;
    } catch {
      inline.style.color = ERR_COLOR; inline.textContent = 'Network error'; return;
    }

    inline.style.color = '';
    inline.innerHTML = `<span>This will email ${count} subscribers. This cannot be undone.</span>`;
    const confirmBtn = document.createElement('button');
    confirmBtn.className = 'admin-btn admin-btn-primary';
    confirmBtn.textContent = 'Confirm send';
    confirmBtn.style.margin = '0 0 0 0.5rem';
    confirmBtn.addEventListener('click', () => doLive(btn, force));
    const cancelBtn = document.createElement('button');
    cancelBtn.className = 'admin-btn admin-btn-ghost';
    cancelBtn.textContent = 'Cancel';
    cancelBtn.style.margin = '0 0 0 0.3rem';
    cancelBtn.addEventListener('click', () => { inline.innerHTML = ''; });
    inline.appendChild(confirmBtn);
    inline.appendChild(cancelBtn);
  }

  async function doLive(btn: HTMLElement, force: boolean) {
    const id = btn.dataset.id!;
    const inline = inlineOf(btn);
    inline.style.color = '';
    inline.textContent = 'Sending…';
    try {
      const data = await postAnnounce({ bakeryId: id, mode: 'live', force });
      if (data.ok) {
        let txt = 'Sent to ' + (data.recipientCount ?? 0) + ' subscribers';
        if (data.failedChunks && data.failedChunks > 0) txt += ' (' + data.failedChunks + ' batch(es) failed — check logs)';
        inline.style.color = OK_COLOR;
        inline.textContent = txt;
        setTimeout(loadList, 1400); // refresh so the row's status shows "Announced …"
      } else if (data.alreadyAnnounced) {
        inline.style.color = '';
        inline.innerHTML = `<span>Already announced on ${esc(fmtDate(data.announcedAt))}.</span>`;
        const again = document.createElement('button');
        again.className = 'admin-btn admin-btn-ghost';
        again.textContent = 'Send again anyway';
        again.style.margin = '0 0 0 0.5rem';
        again.addEventListener('click', () => startLive(btn, true));
        inline.appendChild(again);
      } else {
        inline.style.color = ERR_COLOR;
        inline.textContent = data.error ?? 'Send failed';
      }
    } catch {
      inline.style.color = ERR_COLOR;
      inline.textContent = 'Network error';
    }
  }

  // ── Email preview modal ────────────────────────────────────────
  const previewModal = document.getElementById('preview-modal') as HTMLElement;
  const previewFrame = document.getElementById('preview-frame') as HTMLIFrameElement;
  const previewClose = document.getElementById('preview-close');

  function closePreview() {
    previewModal.style.display = 'none';
    previewFrame.srcdoc = '';
  }
  previewClose?.addEventListener('click', closePreview);
  previewModal?.addEventListener('click', (e) => { if (e.target === previewModal) closePreview(); });

  async function openPreview(btn: HTMLElement) {
    const id = btn.dataset.id!;
    const inline = inlineOf(btn);
    inline.style.color = '';
    inline.textContent = 'Loading preview…';
    try {
      const data = await postAnnounce({ bakeryId: id, mode: 'preview' });
      if (data.ok && data.html) {
        inline.textContent = '';
        previewFrame.srcdoc = data.html;
        previewModal.style.display = 'flex';
      } else {
        inline.style.color = ERR_COLOR;
        inline.textContent = data.error ?? 'Preview failed';
      }
    } catch {
      inline.style.color = ERR_COLOR;
      inline.textContent = 'Network error';
    }
  }

  // Sortable headers — same list re-renders from _rows without re-fetching.
  document.querySelectorAll<HTMLElement>('.th-sortable').forEach((th) => {
    th.addEventListener('click', () => {
      const key = th.dataset.sort as SortKey;
      if (_sortKey === key) _sortDir = _sortDir === 1 ? -1 : 1;
      else { _sortKey = key; _sortDir = 1; }
      render();
    });
  });

  loadList();
  void msgEl; // reserved for future page-level messages
</script>
