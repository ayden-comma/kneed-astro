---
// SECURITY: Keep this page a client-fetched shell. Do NOT fetch or render data server-side here — there is no server-side auth gate (session lives in localStorage, not cookies). Data is loaded client-side after adminCheck verifies admin role, and the API routes enforce auth via requireAdmin. Server-rendering data here would leak it to unauthenticated visitors.
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Campaigns" activePage="campaigns">
  <div class="admin-page-header" style="display:flex; justify-content:space-between; align-items:center; gap:1rem;">
    <h1 class="admin-page-title">Campaigns</h1>
    <a class="admin-btn admin-btn-primary" href="/admin/campaigns/new">New campaign</a>
  </div>

  <div class="admin-section">
    <div id="admin-msg" class="admin-msg"></div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Subject</th>
            <th>Status</th>
            <th style="text-align:right;">Recipients</th>
            <th>Created</th>
            <th>Sent</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="campaign-tbody">
          <tr><td colspan="6"><div class="admin-empty">Loading…</div></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';

  async function authHeaders(): Promise<HeadersInit> {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.href = '/auth/login'; throw new Error('Session expired'); }
    return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` };
  }

  type CampaignRow = {
    id: string;
    subject: string | null;
    status: string | null;
    recipient_count: number | null;
    sent_at: string | null;
    created_at: string | null;
  };

  const tbody = document.getElementById('campaign-tbody')!;

  function esc(v: unknown): string {
    return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function fmtDate(s: string | null | undefined): string {
    if (!s) return '';
    const d = new Date(s);
    return isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
  }
  function statusBadge(status: string | null): string {
    const sent = status === 'sent';
    const cls = sent ? 'admin-badge-admin' : 'admin-badge-member';
    return `<span class="admin-badge ${cls}">${esc(sent ? 'Sent' : 'Draft')}</span>`;
  }

  function rowHTML(c: CampaignRow): string {
    // Delete is offered on drafts only — sent campaigns are send history.
    const actions = c.status === 'sent'
      ? ''
      : `<button class="admin-btn admin-btn-ghost admin-btn-sm btn-del-draft" data-id="${esc(c.id)}">Delete</button>`;
    return `<tr style="cursor:pointer;" data-id="${esc(c.id)}">
      <td><a href="/admin/campaigns/${esc(c.id)}" style="color:inherit;text-decoration:none;"><strong>${esc(c.subject || '(no subject)')}</strong></a></td>
      <td>${statusBadge(c.status)}</td>
      <td style="text-align:right;color:var(--p-70);">${c.status === 'sent' ? (c.recipient_count ?? 0) : ''}</td>
      <td style="white-space:nowrap;color:var(--p-50);">${esc(fmtDate(c.created_at))}</td>
      <td style="white-space:nowrap;color:var(--p-50);">${esc(fmtDate(c.sent_at))}</td>
      <td class="actions-cell" style="text-align:right;white-space:nowrap;">${actions}</td>
    </tr>`;
  }

  function showMsg(text: string, type: 'error' | 'success') {
    const m = document.getElementById('admin-msg')!;
    m.textContent = text;
    m.className = `admin-msg admin-msg-${type} is-visible`;
    setTimeout(() => m.classList.remove('is-visible'), 4000);
  }

  async function loadList() {
    let json: { campaigns?: CampaignRow[]; error?: string };
    try {
      const res = await fetch('/api/admin-campaigns', { headers: await authHeaders() });
      if (!res.ok) { tbody.innerHTML = '<tr><td colspan="6"><div class="admin-empty">Couldn\'t load campaigns</div></td></tr>'; return; }
      json = await res.json();
    } catch {
      tbody.innerHTML = '<tr><td colspan="6"><div class="admin-empty">Couldn\'t load campaigns</div></td></tr>';
      return;
    }
    const rows = json.campaigns ?? [];
    if (rows.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6"><div class="admin-empty">No campaigns yet. Create one to get started.</div></td></tr>';
      return;
    }
    tbody.innerHTML = rows.map(rowHTML).join('');
    tbody.querySelectorAll<HTMLElement>('tr[data-id]').forEach((tr) => {
      tr.addEventListener('click', (e) => {
        // Clicks inside the actions cell (Delete / inline confirm) shouldn't navigate.
        if ((e.target as HTMLElement).closest('.actions-cell')) return;
        window.location.href = `/admin/campaigns/${tr.dataset.id}`;
      });
    });
    bindDeleteButtons();
  }

  function bindDeleteButtons() {
    tbody.querySelectorAll<HTMLButtonElement>('.btn-del-draft').forEach(btn => {
      btn.addEventListener('click', () => showRowConfirm(btn));
    });
  }

  // In-page confirm: swap the Delete button for a "Delete draft? Delete / Cancel" prompt.
  function showRowConfirm(btn: HTMLButtonElement) {
    const cell = btn.closest('.actions-cell') as HTMLElement;
    const id = btn.dataset.id!;
    cell.innerHTML = `<span style="color:var(--p-70);font-size:0.82rem;margin-right:0.45rem;">Delete draft?</span>
      <button class="admin-btn admin-btn-danger admin-btn-sm btn-del-yes">Delete</button>
      <button class="admin-btn admin-btn-ghost admin-btn-sm btn-del-no">Cancel</button>`;
    cell.querySelector<HTMLButtonElement>('.btn-del-no')!.addEventListener('click', loadList);
    cell.querySelector<HTMLButtonElement>('.btn-del-yes')!.addEventListener('click', async () => {
      const yes = cell.querySelector<HTMLButtonElement>('.btn-del-yes')!;
      yes.disabled = true; yes.textContent = 'Deleting…';
      try {
        const res = await fetch('/api/admin-campaign-delete', {
          method: 'POST', headers: await authHeaders(), body: JSON.stringify({ id }),
        });
        const data = await res.json().catch(() => ({})) as { ok?: boolean; error?: string };
        if (res.ok && data.ok) { showMsg('Draft deleted.', 'success'); loadList(); return; }
        showMsg(data.error || 'Could not delete draft.', 'error');
        loadList();
      } catch {
        showMsg('Could not delete draft.', 'error');
        loadList();
      }
    });
  }

  loadList();
</script>
