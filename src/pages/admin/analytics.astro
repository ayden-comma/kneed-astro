---
// SECURITY: Keep this page a client-fetched shell. Do NOT fetch or render data server-side here — there is no server-side auth gate (session lives in localStorage, not cookies). Data is loaded client-side after adminCheck verifies admin role, and the API routes enforce auth via requireAdmin. Server-rendering data here would leak it to unauthenticated visitors.
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Analytics" activePage="analytics">
  <div class="admin-page-header">
    <h1 class="admin-page-title">Analytics</h1>
  </div>

  <!-- ── SITE: GA4 page views ─────────────────────────────────── -->
  <div class="admin-section">
    <div class="admin-section-title" style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
      <span>Site — Last 28 Days</span>
      <span style="display:flex;align-items:baseline;gap:0.4rem;flex-shrink:0;">
        <span id="analytics-avg-engagement" style="font-family:var(--font-display);font-size:1.75rem;font-weight:200;color:var(--amber);line-height:1;">—</span>
        <span style="font-size:0.68rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--p-35);">avg engagement</span>
      </span>
    </div>
    <div style="position:relative;height:160px;margin-bottom:1.5rem;">
      <canvas id="analytics-chart" style="display:block;width:100%;height:100%;"></canvas>
      <div id="analytics-chart-msg" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--p-35);font-size:0.875rem;">Loading…</div>
    </div>
    <div class="admin-section-title" style="margin-top:0.25rem;">Top Pages</div>
    <div id="analytics-top-pages" class="admin-table-wrap">
      <div class="admin-empty">Loading…</div>
    </div>
  </div>

  <!-- ── EMAIL: episode-announcement click analytics ──────────── -->
  <div class="admin-section">
    <div class="admin-section-title">Email — Episode Announcements</div>
    <div id="email-analytics" class="admin-table-wrap">
      <div class="admin-empty">Loading…</div>
    </div>
  </div>
</AdminLayout>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<script>
  import { supabase } from '../../lib/supabase';

  async function authHeaders(): Promise<HeadersInit> {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.href = '/auth/login'; throw new Error('Session expired'); }
    return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` };
  }

  function esc(v: unknown): string {
    return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function fmtDuration(secs: number): string {
    const m = Math.floor(secs / 60);
    const s = Math.round(secs % 60);
    return m > 0 ? `${m}m ${s}s` : `${s}s`;
  }

  function fmtDate(yyyymmdd: string): string {
    const y = yyyymmdd.slice(0, 4), mo = yyyymmdd.slice(4, 6), d = yyyymmdd.slice(6, 8);
    return new Date(`${y}-${mo}-${d}`).toLocaleDateString('en-AU', { month: 'short', day: 'numeric' });
  }

  // ── SITE: GA4 page-view analytics (relocated from the dashboard; fetches /api/analytics as before) ──
  async function loadSiteAnalytics() {
    const chartMsg   = document.getElementById('analytics-chart-msg')!;
    const topPagesEl = document.getElementById('analytics-top-pages')!;
    const avgEl      = document.getElementById('analytics-avg-engagement')!;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      chartMsg.textContent = 'Sign in required';
      topPagesEl.innerHTML = '<div class="admin-empty">Sign in required</div>';
      return;
    }

    let json: { pageviews: any; topPages: any };
    try {
      const res = await fetch('/api/analytics', {
        headers: { 'Authorization': `Bearer ${session.access_token}` },
      });
      if (!res.ok) {
        chartMsg.textContent = "Couldn't load analytics";
        topPagesEl.innerHTML = '<div class="admin-empty">Couldn\'t load analytics</div>';
        return;
      }
      json = await res.json();
    } catch {
      chartMsg.textContent = "Couldn't load analytics";
      topPagesEl.innerHTML = '<div class="admin-empty">Couldn\'t load analytics</div>';
      return;
    }

    // ── Pageviews chart ──────────────────────────────────────────
    type GARow = { dimensionValues: { value: string }[]; metricValues: { value: string }[] };
    const pvRows: GARow[] = json.pageviews?.rows ?? [];
    const labels  = pvRows.map(r => fmtDate(r.dimensionValues[0].value));
    const pvData  = pvRows.map(r => Number(r.metricValues[0].value));

    chartMsg.style.display = 'none';
    const canvas  = document.getElementById('analytics-chart') as HTMLCanvasElement;
    const ctx     = canvas.getContext('2d')!;
    const amber   = 'rgba(200,131,58,1)';
    const grad    = ctx.createLinearGradient(0, 0, 0, canvas.offsetHeight || 160);
    grad.addColorStop(0, 'rgba(200,131,58,0.18)');
    grad.addColorStop(1, 'rgba(200,131,58,0)');

    new (window as any).Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          data: pvData,
          borderColor: amber,
          borderWidth: 1.5,
          pointRadius: 0,
          pointHoverRadius: 3,
          pointHoverBackgroundColor: amber,
          fill: true,
          backgroundColor: grad,
          tension: 0.3,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: {
          callbacks: { label: (c: any) => ` ${c.parsed.y.toLocaleString()} views` },
          backgroundColor: 'rgba(26,22,19,0.95)',
          borderColor: 'rgba(242,237,230,0.12)',
          borderWidth: 1,
          titleColor: 'rgba(242,237,230,0.5)',
          bodyColor: 'rgba(200,131,58,1)',
          titleFont: { size: 10 },
          bodyFont: { size: 11 },
        }},
        scales: {
          x: {
            ticks: { color: 'rgba(242,237,230,0.35)', font: { size: 10 }, maxTicksLimit: 7 },
            grid: { color: 'rgba(242,237,230,0.06)' },
            border: { color: 'rgba(242,237,230,0.08)' },
          },
          y: {
            ticks: { color: 'rgba(242,237,230,0.35)', font: { size: 10 }, maxTicksLimit: 5 },
            grid: { color: 'rgba(242,237,230,0.06)' },
            border: { color: 'rgba(242,237,230,0.08)' },
          },
        },
      },
    });

    // ── Top pages table ──────────────────────────────────────────
    const tpRows: GARow[] = json.topPages?.rows ?? [];

    if (tpRows.length === 0) {
      topPagesEl.innerHTML = '<div class="admin-empty">No page data.</div>';
    } else {
      const totalDur = tpRows.reduce((sum, r) => sum + Number(r.metricValues[1].value), 0);
      avgEl.textContent = fmtDuration(totalDur / tpRows.length);

      topPagesEl.innerHTML = `
        <table class="admin-table">
          <thead><tr>
            <th>Page</th>
            <th style="text-align:right;white-space:nowrap;">Views</th>
            <th style="text-align:right;white-space:nowrap;">Avg Engagement</th>
          </tr></thead>
          <tbody>
            ${tpRows.map(r => {
              const path = r.dimensionValues[0].value;
              const views = Number(r.metricValues[0].value).toLocaleString();
              const dur   = fmtDuration(Number(r.metricValues[1].value));
              return `<tr>
                <td class="admin-truncate" style="max-width:260px;color:var(--p-70);">${path}</td>
                <td style="text-align:right;color:var(--amber);font-family:var(--font-display);font-weight:200;font-size:1rem;">${views}</td>
                <td style="text-align:right;color:var(--p-50);font-size:0.8rem;">${dur}</td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>`;
    }
  }

  // ── EMAIL: episode-announcement click analytics ─────────────────
  type EmailBroadcast = {
    bakery_id: string;
    name: string | null;
    episode_number: number | null;
    sent: number;
    delivered: number;
    bounced: number;
    clicked_total: number;
    clicked_unique: number;
    click_through_rate: number;
    links: { url: string; count: number }[];
  };
  type EmailSortKey = 'episode' | 'bakery' | 'sent' | 'delivered' | 'clicked' | 'ctr';

  let _broadcasts: EmailBroadcast[] = [];
  const _open = new Set<string>();        // bakery_ids of expanded rows (multiple allowed)
  let _emailSortKey: EmailSortKey = 'episode';
  let _emailSortDir: 1 | -1 = 1;          // default: episode ascending, blanks last

  // Map a clicked URL to a friendly label (case-insensitive substring match).
  function linkLabel(url: string): string {
    const u = url.toLowerCase();
    if (u.includes('instagram.com')) return 'Instagram';
    if (u.includes('tiktok.com'))    return 'TikTok';
    if (u.includes('youtube.com'))   return 'YouTube';
    if (u.includes('facebook.com'))  return 'Facebook';
    if (u.includes('/unsubscribe'))  return 'Unsubscribe';
    if (u.includes('/bakeries/'))    return 'Episode page';
    try { return new URL(url).pathname; } catch { return url; }
  }

  function sortBroadcasts(list: EmailBroadcast[]): EmailBroadcast[] {
    const copy = list.slice();
    copy.sort((a, b) => {
      let cmp = 0;
      switch (_emailSortKey) {
        case 'episode': {
          const an = a.episode_number, bn = b.episode_number;
          if (an == null && bn == null) cmp = 0;
          else if (an == null) return 1;   // blanks always last, regardless of direction
          else if (bn == null) return -1;
          else cmp = an - bn;
          break;
        }
        case 'bakery':    cmp = (a.name || '').localeCompare(b.name || '', undefined, { sensitivity: 'base' }); break;
        case 'sent':      cmp = a.sent - b.sent; break;
        case 'delivered': cmp = a.delivered - b.delivered; break;
        case 'clicked':   cmp = a.clicked_unique - b.clicked_unique; break;
        case 'ctr':       cmp = a.click_through_rate - b.click_through_rate; break;
      }
      return cmp * _emailSortDir;
    });
    return copy;
  }

  function emailRowHTML(b: EmailBroadcast): string {
    const open = _open.has(b.bakery_id);
    const ep   = b.episode_number ? 'Ep. ' + String(b.episode_number).padStart(2, '0') : '';
    const ctr  = (b.click_through_rate * 100).toFixed(1) + '%';
    const caret = open ? '▾' : '▸';
    const main = `<tr class="email-row" data-id="${esc(b.bakery_id)}" style="cursor:pointer;">
      <td>${esc(ep)}</td>
      <td style="color:var(--p-70);">${esc(b.name ?? '—')}</td>
      <td style="text-align:right;">${b.sent}</td>
      <td style="text-align:right;">${b.delivered}</td>
      <td style="text-align:right;color:var(--amber);font-family:var(--font-display);font-weight:200;font-size:1rem;">${b.clicked_unique}</td>
      <td style="text-align:right;color:var(--p-50);">${ctr}</td>
      <td style="text-align:right;color:var(--p-35);width:1.5rem;">${caret}</td>
    </tr>`;
    if (!open) return main;

    const linkLines = (b.links ?? []).length === 0
      ? '<div class="admin-activity-meta" style="color:var(--p-35);">No link clicks recorded.</div>'
      : b.links.map(l =>
          `<div class="admin-activity-meta" title="${esc(l.url)}" style="max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(linkLabel(l.url))} — ${l.count}</div>`
        ).join('');
    const summary = `<div style="font-size:0.8rem;color:var(--p-50);margin-bottom:0.5rem;">${b.clicked_total} total clicks from ${b.clicked_unique} unique recipients</div>`;
    const detail = `<tr class="email-detail-row"><td colspan="7" style="background:var(--surface);padding:0.875rem 1rem;">${summary}${linkLines}</td></tr>`;
    return main + detail;
  }

  function updateEmailSortIndicators() {
    document.querySelectorAll<HTMLElement>('#email-analytics th.th-sortable').forEach((th) => {
      const icon = th.querySelector('.sort-indicator');
      if (icon) icon.textContent = th.dataset.sort === _emailSortKey ? (_emailSortDir === 1 ? ' ▲' : ' ▼') : '';
    });
  }

  function renderEmail() {
    const el = document.getElementById('email-analytics')!;
    if (_broadcasts.length === 0) {
      el.innerHTML = '<div class="admin-empty">No email broadcasts with tracked events yet.</div>';
      return;
    }
    const sorted = sortBroadcasts(_broadcasts);
    el.innerHTML = `
      <table class="admin-table">
        <thead><tr>
          <th class="th-sortable" data-sort="episode" style="cursor:pointer;">Episode <span class="sort-indicator"></span></th>
          <th class="th-sortable" data-sort="bakery" style="cursor:pointer;">Bakery <span class="sort-indicator"></span></th>
          <th class="th-sortable" data-sort="sent" style="cursor:pointer;text-align:right;">Sent <span class="sort-indicator"></span></th>
          <th class="th-sortable" data-sort="delivered" style="cursor:pointer;text-align:right;">Delivered <span class="sort-indicator"></span></th>
          <th class="th-sortable" data-sort="clicked" style="cursor:pointer;text-align:right;">Clicked <span class="sort-indicator"></span></th>
          <th class="th-sortable" data-sort="ctr" style="cursor:pointer;text-align:right;">CTR <span class="sort-indicator"></span></th>
          <th></th>
        </tr></thead>
        <tbody>
          ${sorted.map(emailRowHTML).join('')}
        </tbody>
      </table>`;

    // Header clicks sort; body-row clicks expand (separate elements — no interference).
    el.querySelectorAll<HTMLElement>('th.th-sortable').forEach((th) => {
      th.addEventListener('click', () => {
        const key = th.dataset.sort as EmailSortKey;
        if (_emailSortKey === key) _emailSortDir = _emailSortDir === 1 ? -1 : 1;
        else { _emailSortKey = key; _emailSortDir = 1; }
        renderEmail();
      });
    });
    el.querySelectorAll<HTMLElement>('tr.email-row').forEach((tr) => {
      tr.addEventListener('click', () => {
        const id = tr.dataset.id!;
        if (_open.has(id)) _open.delete(id); else _open.add(id);
        renderEmail();
      });
    });
    updateEmailSortIndicators();
  }

  async function loadEmailAnalytics() {
    const el = document.getElementById('email-analytics')!;
    let json: { broadcasts?: EmailBroadcast[] };
    try {
      const res = await fetch('/api/admin-email-analytics', { headers: await authHeaders() });
      if (!res.ok) { el.innerHTML = '<div class="admin-empty">Couldn\'t load email analytics</div>'; return; }
      json = await res.json();
    } catch {
      el.innerHTML = '<div class="admin-empty">Couldn\'t load email analytics</div>';
      return;
    }
    _broadcasts = json.broadcasts ?? [];
    renderEmail();
  }

  // Run after adminCheck has revealed the content (chart needs a visible, sized container).
  function runLoaders() {
    loadSiteAnalytics();
    loadEmailAnalytics();
  }
  const observer = new MutationObserver(() => {
    const content = document.getElementById('admin-content');
    if (content && content.style.display !== 'none') {
      observer.disconnect();
      runLoaders();
    }
  });
  observer.observe(document.body, { childList: false, attributes: true, subtree: true });
  const content = document.getElementById('admin-content');
  if (content && content.style.display !== 'none') runLoaders();
</script>
