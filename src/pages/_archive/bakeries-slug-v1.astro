<script>
  import { supabase } from '../../lib/supabase';

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function relativeTime(dateStr: string): string {
    const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
    if (diff < 60) return 'just now';
    if (diff < 3600) return Math.floor(diff / 60) + (Math.floor(diff / 60) === 1 ? ' minute ago' : ' minutes ago');
    if (diff < 86400) return Math.floor(diff / 3600) + (Math.floor(diff / 3600) === 1 ? ' hour ago' : ' hours ago');
    return new Date(dateStr).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function avatarInitials(name: string): string {
    return name.trim().split(/\s+/).map((n: string) => n[0]).join('').slice(0, 2).toUpperCase() || '?';
  }

  async function initComments() {
    const section = document.querySelector('.comments-section[data-slug]') as HTMLElement | null;
    if (!section) return;
    const slug = section.dataset.slug!;

    const formWrap     = document.getElementById('comment-form-wrap') as HTMLElement | null;
    const signinPrompt = document.getElementById('comment-signin-prompt') as HTMLElement | null;
    const submitBtn    = document.getElementById('comment-submit') as HTMLButtonElement | null;
    const textarea     = document.getElementById('comment-input') as HTMLTextAreaElement | null;
    const listEl       = document.getElementById('comments-list') as HTMLElement | null;
    if (!listEl) return;

    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      if (formWrap)     formWrap.style.display     = '';
      if (signinPrompt) signinPrompt.style.display = 'none';
    } else {
      if (formWrap)     formWrap.style.display     = 'none';
      if (signinPrompt) signinPrompt.style.display = '';
    }

    function formatName(fullName: string | undefined): string {
      if (!fullName) return 'Anonymous';
      const parts = fullName.trim().split(/\s+/);
      if (parts.length === 1) return parts[0];
      return parts[0] + ' ' + parts[parts.length - 1][0] + '.';
    }

    type CommentRow = { id: string; user_id: string; content: string; created_at: string; profiles?: { display_name?: string } };
    type VoteData = { up: number; down: number; userVote: 1 | -1 | 0 };
    type VoteMap = Record<string, VoteData>;

    let voteMap: VoteMap = {};

    async function fetchVotes(ids: string[]): Promise<void> {
      if (ids.length === 0) return;
      const { data: votes } = await supabase
        .from('comment_votes')
        .select('comment_id, vote, user_id')
        .in('comment_id', ids);
      for (const v of (votes ?? [])) {
        if (!voteMap[v.comment_id]) voteMap[v.comment_id] = { up: 0, down: 0, userVote: 0 };
        if (v.vote === 1) voteMap[v.comment_id].up++;
        else voteMap[v.comment_id].down++;
        if (session && v.user_id === session.user.id) voteMap[v.comment_id].userVote = v.vote;
      }
    }

    function voteHTML(commentId: string): string {
      const vd = voteMap[commentId] ?? { up: 0, down: 0, userVote: 0 };
      const score = vd.up - vd.down;
      const upActive = vd.userVote === 1 ? ' is-voted' : '';
      const downActive = vd.userVote === -1 ? ' is-voted' : '';
      return `<div class="comment-votes">
        <button class="vote-btn up-btn${upActive}" data-id="${esc(commentId)}" data-vote="1" aria-label="Upvote">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
        </button>
        <span class="vote-score">${score}</span>
        <button class="vote-btn down-btn${downActive}" data-id="${esc(commentId)}" data-vote="-1" aria-label="Downvote">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3H10z"/><path d="M17 2h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"/></svg>
        </button>
        <span class="vote-score-num" style="display:none">${score}</span>
      </div>`;
    }

    function commentHTML(c: CommentRow, isReply = false): string {
      const name = formatName(c.profiles?.display_name);
      const isOwner = session && c.user_id === session.user.id;
      const deleteBtn = isOwner
        ? `<button class="comment-delete-btn" data-id="${esc(c.id)}" aria-label="Delete">×</button>`
        : '';
      const replyBtn = !isReply && session
        ? `<button class="comment-reply-btn" data-id="${esc(c.id)}">REPLY</button>`
        : '';
      return `<div class="comment-item${isReply ? ' comment-reply' : ''}" id="comment-${esc(c.id)}" data-comment-id="${esc(c.id)}">
        <div class="comment-avatar">${esc(avatarInitials(name))}</div>
        <div class="comment-body">
          <div class="comment-meta">
            <span class="comment-author">${esc(name)}</span>
            <span class="comment-date">${relativeTime(c.created_at)}</span>
            ${deleteBtn}
          </div>
          <div class="comment-text">${esc(c.content)}</div>
          <div class="comment-actions">
            ${voteHTML(c.id)}
            ${replyBtn}
          </div>
          ${!isReply ? `<div class="comment-replies" data-parent="${esc(c.id)}"></div>
          <div class="reply-form-wrap" data-parent="${esc(c.id)}" style="display:none">
            <textarea class="reply-input comment-input" rows="2" placeholder="Write a reply…"></textarea>
            <button class="reply-submit wf-pill pill-amber" style="margin-top:0.5rem; font-size:0.75rem; padding:0.35rem 0.85rem;">Post reply</button>
          </div>` : ''}
        </div>
      </div>`;
    }

    async function loadReplies(parentId: string, repliesEl: HTMLElement) {
      const { data: replies } = await supabase
        .from('comments')
        .select('*, profiles(display_name)')
        .eq('parent_comment_id', parentId)
        .order('created_at', { ascending: true });
      if (!replies || replies.length === 0) { repliesEl.innerHTML = ''; return; }
      const replyIds = (replies as CommentRow[]).map(r => r.id);
      await fetchVotes(replyIds);
      repliesEl.innerHTML = (replies as CommentRow[]).map(r => commentHTML(r, true)).join('');
      bindDeleteBtns(repliesEl);
      bindVoteBtns(repliesEl);
    }

    function bindDeleteBtns(container: HTMLElement) {
      container.querySelectorAll('.comment-delete-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const commentId = target.dataset.id!;
          if (target.textContent === 'Confirm?') {
            const { error } = await supabase.from('comments').delete()
              .eq('id', commentId)
              .eq('user_id', session!.user.id);
            if (!error) {
              const item = listEl!.querySelector(`[data-comment-id="${commentId}"]`);
              item?.remove();
              if (!listEl!.querySelector('.comment-item')) {
                listEl!.innerHTML = '<p class="comments-empty">No comments yet. Be the first to share your thoughts!</p>';
              }
            }
          } else {
            target.textContent = 'Confirm?';
            setTimeout(() => { if (target.isConnected) target.textContent = '×'; }, 2000);
          }
        });
      });
    }

    function resortComments() {
      const items = Array.from(listEl!.querySelectorAll(':scope > .comment-item')) as HTMLElement[];
      items.sort((a, b) => {
        const va = voteMap[a.dataset.commentId!] ?? { up: 0, down: 0, userVote: 0 as 0 };
        const vb = voteMap[b.dataset.commentId!] ?? { up: 0, down: 0, userVote: 0 as 0 };
        return (vb.up - vb.down) - (va.up - va.down);
      });
      items.forEach(item => listEl!.appendChild(item));
    }

    function bindVoteBtns(container: HTMLElement) {
      container.querySelectorAll('.vote-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!session) return;
          const target = btn as HTMLButtonElement;
          const commentId = target.dataset.id!;
          const voteVal = parseInt(target.dataset.vote!) as 1 | -1;
          const current = voteMap[commentId] ?? { up: 0, down: 0, userVote: 0 as 0 };
          const hasVote = current.userVote !== 0;

          // Optimistic DOM update
          let newUp = current.up, newDown = current.down;
          if (current.userVote === 1) newUp--;
          if (current.userVote === -1) newDown--;
          const newUserVote: 1 | -1 | 0 = hasVote ? 0 : voteVal;
          if (!hasVote && voteVal === 1) newUp++;
          if (!hasVote && voteVal === -1) newDown++;
          voteMap[commentId] = { up: newUp, down: newDown, userVote: newUserVote };

          const itemEl = listEl!.querySelector(`[data-comment-id="${commentId}"]`);
          if (itemEl) {
            const scoreEl = itemEl.querySelector('.vote-score');
            if (scoreEl) scoreEl.textContent = String(newUp - newDown);
            itemEl.querySelector('.up-btn')?.classList.toggle('is-voted', newUserVote === 1);
            itemEl.querySelector('.down-btn')?.classList.toggle('is-voted', newUserVote === -1);
          }

          if (itemEl?.parentElement === listEl) resortComments();

          // Persist
          if (hasVote) {
            await supabase.from('comment_votes').delete()
              .eq('comment_id', commentId).eq('user_id', session.user.id);
          } else {
            await supabase.from('comment_votes').insert(
              { comment_id: commentId, user_id: session.user.id, vote: voteVal }
            );
          }
        });
      });
    }

    async function loadComments() {
      const { data: comments } = await supabase
        .from('comments')
        .select('*, profiles(display_name)')
        .eq('bakery_slug', slug)
        .is('parent_comment_id', null)
        .order('created_at', { ascending: false });

      if (!comments || comments.length === 0) {
        listEl!.innerHTML = '<p class="comments-empty">No comments yet. Be the first to share your thoughts!</p>';
        return;
      }

      const commentIds = (comments as CommentRow[]).map(c => c.id);
      voteMap = {};
      await fetchVotes(commentIds);

      const sorted = [...(comments as CommentRow[])].sort((a, b) => {
        const va = voteMap[a.id] ?? { up: 0, down: 0, userVote: 0 as 0 };
        const vb = voteMap[b.id] ?? { up: 0, down: 0, userVote: 0 as 0 };
        return (vb.up - vb.down) - (va.up - va.down);
      });

      listEl!.innerHTML = sorted.map(c => commentHTML(c, false)).join('');
      bindDeleteBtns(listEl!);
      bindVoteBtns(listEl!);

      await Promise.all(sorted.map(c => {
        const repliesEl = listEl!.querySelector(`.comment-replies[data-parent="${c.id}"]`) as HTMLElement | null;
        return repliesEl ? loadReplies(c.id, repliesEl) : Promise.resolve();
      }));

      listEl!.querySelectorAll('.comment-reply-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const parentId = (btn as HTMLButtonElement).dataset.id!;
          const formWrapEl = listEl!.querySelector(`.reply-form-wrap[data-parent="${parentId}"]`) as HTMLElement | null;
          if (!formWrapEl) return;
          const isOpen = formWrapEl.style.display !== 'none';
          formWrapEl.style.display = isOpen ? 'none' : '';
          if (!isOpen) (formWrapEl.querySelector('.reply-input') as HTMLTextAreaElement | null)?.focus();
        });
      });

      listEl!.querySelectorAll('.reply-submit').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const submitEl = btn as HTMLButtonElement;
          const formWrapEl = submitEl.closest('.reply-form-wrap') as HTMLElement | null;
          if (!formWrapEl) return;
          const parentId = formWrapEl.dataset.parent!;
          const replyTextarea = formWrapEl.querySelector('.reply-input') as HTMLTextAreaElement | null;
          const replyText = replyTextarea?.value.trim();
          if (!replyText) return;
          submitEl.disabled = true;
          submitEl.textContent = 'Posting…';
          const { error } = await supabase.from('comments').insert({
            user_id: session!.user.id,
            bakery_slug: slug,
            content: replyText,
            parent_comment_id: parentId,
          });
          if (!error) {
            if (replyTextarea) replyTextarea.value = '';
            formWrapEl.style.display = 'none';
            const repliesEl = listEl!.querySelector(`.comment-replies[data-parent="${parentId}"]`) as HTMLElement | null;
            if (repliesEl) await loadReplies(parentId, repliesEl);
          }
          submitEl.disabled = false;
          submitEl.textContent = 'Post reply';
        });
      });
    }

    await loadComments();

    if (session && submitBtn && textarea) {
      submitBtn.onclick = async () => {
        const commentText = textarea.value.trim();
        if (!commentText) return;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Posting…';
        const { error } = await supabase.from('comments').insert({
          user_id: session.user.id,
          bakery_slug: slug,
          content: commentText,
        });
        if (!error) {
          textarea.value = '';
          await loadComments();
        }
        submitBtn.disabled = false;
        submitBtn.textContent = 'Post comment';
      };
    }
  }

  document.addEventListener('astro:page-load', initComments);
  initComments();
</script>

<script>
  import { initBakeryMap, destroyBakeryMap } from '../../scripts/map.js';

  function startMap() {
    if (!document.getElementById('bakery-map')) return;
    initBakeryMap();
  }

  document.addEventListener('astro:before-swap', destroyBakeryMap);

  document.addEventListener('astro:after-swap', function() {
    if (typeof (document as any).startViewTransition === 'function' && document.timeline) {
      requestAnimationFrame(function() {
        requestAnimationFrame(startMap);
      });
    } else {
      startMap();
    }
  });

  // Fresh (non-SPA) load:
  if (document.readyState !== 'loading') {
    startMap();
  } else {
    document.addEventListener('DOMContentLoaded', startMap);
  }
</script>

<script>
  import { supabase } from '../../lib/supabase';

  const SAVE_ICON_EMPTY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>';
  const SAVE_ICON_FULL  = '<svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>';

  async function initSaveAndRating() {
    const starEl      = document.getElementById('star-rating') as HTMLElement | null;
    const summaryEl   = document.getElementById('rating-summary') as HTMLElement | null;
    const saveBtn     = document.getElementById('save-btn') as HTMLButtonElement | null;
    if (!starEl && !saveBtn) return;

    const slug = (starEl?.dataset.slug || saveBtn?.dataset.slug)!;
    const { data: { session } } = await supabase.auth.getSession();

    // ── RATINGS ─────────────────────────────────────────────────
    async function loadAverage() {
      const { data } = await supabase
        .from('ratings')
        .select('rating')
        .eq('bakery_slug', slug);
      if (!summaryEl) return;
      if (!data || data.length === 0) {
        summaryEl.textContent = 'No ratings yet';
      } else {
        const avg = data.reduce((s: number, r: { rating: number }) => s + r.rating, 0) / data.length;
        summaryEl.textContent = avg.toFixed(1) + ' ★ · ' + data.length + (data.length === 1 ? ' rating' : ' ratings');
      }
    }

    await loadAverage();

    if (starEl) {
      const stars = Array.from(starEl.querySelectorAll('.star')) as HTMLElement[];
      let userRating = 0;

      function renderStars(value: number) {
        stars.forEach(s => s.classList.toggle('filled', parseInt(s.dataset.value || '0') <= value));
      }

      if (session) {
        const { data: existing } = await supabase
          .from('ratings')
          .select('rating')
          .eq('bakery_slug', slug)
          .eq('user_id', session.user.id)
          .maybeSingle();
        userRating = existing?.rating || 0;
        renderStars(userRating);

        stars.forEach(star => {
          const value = parseInt(star.dataset.value || '0');
          star.addEventListener('mouseenter', () => renderStars(value));
          star.addEventListener('mouseleave', () => renderStars(userRating));
          star.addEventListener('click', async () => {
            userRating = value;
            renderStars(value);
            await supabase.from('ratings').upsert(
              { user_id: session.user.id, bakery_slug: slug, rating: value },
              { onConflict: 'user_id,bakery_slug' }
            );
            await loadAverage();
          });
        });
      } else {
        renderStars(0);
        stars.forEach(s => (s.style.cursor = 'default'));
      }
    }

    // ── SAVE BUTTON ─────────────────────────────────────────────
    if (saveBtn) {
      function setSaved(saved: boolean) {
        saveBtn!.classList.toggle('is-saved', saved);
        saveBtn!.innerHTML = saved
          ? SAVE_ICON_FULL  + ' Saved ✓'
          : SAVE_ICON_EMPTY + ' Save to Recipe Book';
      }

      if (session) {
        const { data: existing, error: checkError } = await supabase
          .from('saves')
          .select('id')
          .eq('user_id', session.user.id)
          .eq('content_type', 'bakery')
          .eq('content_slug', slug)
          .maybeSingle();
        if (checkError) console.error('Save check error:', checkError);
        setSaved(!!existing);

        saveBtn.onclick = async () => {
          if (saveBtn.classList.contains('is-saved')) {
            const { error } = await supabase.from('saves')
              .delete()
              .eq('user_id', session.user.id)
              .eq('content_type', 'bakery')
              .eq('content_slug', slug);
            console.log('Save delete result:', error ?? 'ok');
            if (!error) setSaved(false);
          } else {
            const { data, error } = await supabase.from('saves').insert({
              user_id: session.user.id,
              content_type: 'bakery',
              content_slug: slug,
            });
            console.log('Save insert result:', data, error);
            if (!error) setSaved(true);
          }
        };
      } else {
        saveBtn.onclick = () => { window.location.href = '/auth/login'; };
      }
    }
  }

  document.addEventListener('astro:page-load', initSaveAndRating);
  initSaveAndRating();
</script>

<script>
  import { supabase } from '../../lib/supabase';

  async function initPreviewBanner() {
    const banner = document.getElementById('preview-banner');
    if (!banner) return;
    const params = new URLSearchParams(window.location.search);
    if (params.get('preview') !== 'true') { banner.style.display = 'none'; return; }
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { banner.style.display = 'none'; return; }
    const { data: profile } = await supabase
      .from('profiles').select('role').eq('id', session.user.id).single();
    banner.style.display = profile?.role === 'admin' ? '' : 'none';
  }

  document.addEventListener('astro:page-load', initPreviewBanner);
  initPreviewBanner();
</script>

<script is:inline>
function initMapLines() {
  document.querySelectorAll('.map-location-line').forEach(function(btn) {
    btn.onclick = function() {
      document.getElementById('map-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
      var idx = parseInt(btn.dataset.index, 10);
      if (window.__bakeryMapFocus) window.__bakeryMapFocus(idx);
    };
  });
  document.querySelectorAll('.aside-location-btn[data-index]').forEach(function(btn) {
    btn.onclick = function() {
      document.getElementById('map-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
      var idx = parseInt(btn.dataset.index, 10);
      setTimeout(function() {
        if (window.__bakeryMapFocus) window.__bakeryMapFocus(idx);
      }, 600);
    };
  });
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initMapLines);
} else {
  initMapLines();
}
</script>