---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const collectionBakeries = await getCollection('bakeries');

// Bakeries not yet in the content collection — supplemental data.
// Add a `locations` array to any entry that has multiple locations.
// If `locations` is present with 2+ entries it takes precedence over lat/lng/address.
const extraBakeries = [
  {
    name: 'Falco Bakery',
    slug: 'falco-bakery',
    suburb: 'Collingwood',
    address: '167 Smith St, Collingwood VIC 3066',
    category: 'Sourdough',
    hours: 'Mon–Fri 7am–4pm, Sat–Sun 8am–3pm',
    website: 'falcobakery.com.au',
    thumbnail: 'https://images.pexels.com/photos/263168/pexels-photo-263168.jpeg?auto=compress&cs=tinysrgb&w=800',
    lat: -37.8024,
    lng: 144.9869,
  },
  {
    name: 'To Be Frank',
    slug: 'to-be-frank',
    suburb: 'Thornbury',
    address: '756 High St, Thornbury VIC 3071',
    category: 'Focaccia',
    hours: 'Wed–Sun 8am–2pm',
    website: null,
    thumbnail: 'https://images.pexels.com/photos/30666809/pexels-photo-30666809.jpeg?auto=compress&cs=tinysrgb&w=800',
    lat: -37.7654,
    lng: 144.9984,
  },
  {
    name: 'Loafer Bread',
    slug: null,
    suburb: 'Yarraville',
    category: 'Sourdough',
    hours: 'Tue–Fri 7am–2pm, Sat–Sun 8am–1pm',
    website: 'loaferbread.com.au',
    thumbnail: 'https://images.pexels.com/photos/1775043/pexels-photo-1775043.jpeg?auto=compress&cs=tinysrgb&w=800',
    locations: [
      { addr: '63 Anderson St, Yarraville VIC 3013', lat: -37.8143, lng: 144.8943 },
      { addr: '36 Paisley St, Footscray VIC 3011',  lat: -37.8013, lng: 144.9010 },
    ],
  },
  {
    name: 'Beatrix',
    slug: null,
    suburb: 'North Melbourne',
    address: '28 Bignell Ln, North Melbourne VIC 3051',
    category: 'Pastry',
    hours: 'Tue–Sat 8am–4pm, Sun 9am–3pm',
    website: null,
    thumbnail: 'https://images.pexels.com/photos/2135/food-france-morning-breakfast.jpg?auto=compress&cs=tinysrgb&w=800',
    lat: -37.8008,
    lng: 144.9445,
  },
  {
    name: 'Dench Bakers',
    slug: null,
    suburb: 'Fitzroy North',
    address: '482 Brunswick St, Fitzroy North VIC 3068',
    category: 'Sourdough',
    hours: 'Daily 7am–3pm',
    website: 'denchbakers.com.au',
    thumbnail: 'https://images.pexels.com/photos/1084101/pexels-photo-1084101.jpeg?auto=compress&cs=tinysrgb&w=800',
    lat: -37.7810,
    lng: 144.9828,
  },
];

// ── Data normalisation ────────────────────────────────────────────────────────
// allBakeries = one entry per unique bakery → drives the sidebar (one row each)
//               and popup content (name, hours, website, etc.)
// allPins     = one entry per map marker    → drives Leaflet marker placement
//
// Each pin carries a bakeryIdx so clicking a marker can look up its bakery.
// Sidebar buttons are indexed by bakeryIdx.

type LocEntry = { addr: string; lat: number; lng: number };
interface BakeryInput {
  name: string; slug: string | null; suburb: string; category: string;
  hours: string | null; website: string | null; thumbnail: string;
  address?: string; lat?: number; lng?: number;
  locations?: LocEntry[];
}
interface BakeryEntry {
  name: string; slug: string | null; suburb: string; category: string;
  hours: string | null; website: string | null; thumbnail: string;
  locations: LocEntry[]; // always at least one entry
}
interface PinEntry {
  bakeryIdx: number; // index into allBakeries
  lat: number;
  lng: number;
  addr: string;      // address for this specific pin
}

function toBakeryEntry(b: BakeryInput): BakeryEntry {
  const locs: LocEntry[] = [];
  if (b.locations && b.locations.length > 0) {
    b.locations.forEach(l => locs.push({ addr: l.addr, lat: l.lat, lng: l.lng }));
  } else if (b.lat != null && b.lng != null) {
    locs.push({ addr: b.address ?? '', lat: b.lat, lng: b.lng });
  }
  return {
    name: b.name, slug: b.slug, suburb: b.suburb, category: b.category,
    hours: b.hours ?? null, website: b.website ?? null, thumbnail: b.thumbnail,
    locations: locs,
  };
}

const allBakeries: BakeryEntry[] = [
  ...collectionBakeries
    .filter(b =>
      (b.data.lat != null && b.data.lng != null) ||
      (b.data.locations && b.data.locations.length > 0)
    )
    .map(b => toBakeryEntry({
      name: b.data.name, slug: b.data.slug, suburb: b.data.suburb,
      category: b.data.category, hours: b.data.hours ?? null,
      website: b.data.website ?? null, thumbnail: b.data.thumbnail,
      address: b.data.address, lat: b.data.lat, lng: b.data.lng,
      locations: b.data.locations as LocEntry[] | undefined,
    })),
  ...extraBakeries.map(b => toBakeryEntry(b as BakeryInput)),
];

// Flat marker list — one pin per location, each pointing back to its bakery
const allPins: PinEntry[] = allBakeries.flatMap((bakery, bakeryIdx) =>
  bakery.locations.map(loc => ({ bakeryIdx, lat: loc.lat, lng: loc.lng, addr: loc.addr }))
);
---

<BaseLayout
  title="Find a Bakery"
  description="Every Melbourne bakery on one map — find addresses, opening hours and watch their story."
>
  <main>
    <div class="map-page-wrap" id="map-page">

      <!-- ── SIDEBAR ── -->
      <aside class="map-sidebar">
        <div class="map-sidebar-head">
          <div class="wf-eyebrow">Find a Bakery</div>
          <h1 class="map-sidebar-title">Melbourne's Bread Map</h1>
          <p class="map-sidebar-count">{allBakeries.length} {allBakeries.length === 1 ? 'bakery' : 'bakeries'}</p>
        </div>
        <div class="map-sidebar-list" id="map-sidebar-list">
          {allBakeries.map((b, i) => (
            <button
              class="map-bakery-item"
              data-index={String(i)}
              aria-label={`Select ${b.name}`}
            >
              <div class="map-bakery-num">{String(i + 1).padStart(2, '0')}</div>
              <img class="map-bakery-thumb" src={b.thumbnail} alt={b.name} loading="lazy" />
              <div class="map-bakery-info">
                <div class="map-bakery-cat">{b.category}</div>
                <div class="map-bakery-name">{b.name}</div>
                <div class="map-bakery-addr">
                  {b.suburb}
                  {b.locations.length > 1 && (
                    <span class="map-bakery-loc-count">&nbsp;· {b.locations.length} locations</span>
                  )}
                </div>
              </div>
            </button>
          ))}
        </div>
      </aside>

      <!-- ── MAP + POPUP ── -->
      <div class="map-canvas-wrap" id="map-canvas-wrap">
        <div id="kneed-map"></div>

        <!-- Popup card — positioned absolutely relative to the map canvas -->
        <div class="map-popup" id="map-popup" role="dialog" aria-modal="true" aria-label="Bakery details">
          <button class="map-popup-close" id="map-popup-close" aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
          <img class="map-popup-img" id="map-popup-img" src="" alt="" loading="lazy" />
          <div class="map-popup-body">
            <div class="map-popup-cat" id="map-popup-cat"></div>
            <div class="map-popup-name" id="map-popup-name"></div>
            <div class="map-popup-detail" id="map-popup-addr-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span id="map-popup-addr"></span>
            </div>
            <div class="map-popup-detail" id="map-popup-hours-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span id="map-popup-hours"></span>
            </div>
            <div class="map-popup-actions" id="map-popup-actions"></div>
          </div>
        </div>
      </div>

    </div>
  </main>
</BaseLayout>

<style>
/* ── Layout ── */
.map-page-wrap {
  display: grid;
  max-width: var(--max-w);
  margin: 0 auto;
  padding: clamp(1.5rem, 3vw, 2.5rem) var(--px) clamp(3rem, 5vw, 4rem);
  gap: 1.125rem;
  grid-template-columns: 1fr;
}
@media (min-width: 900px) {
  .map-page-wrap { grid-template-columns: 300px 1fr; }
}

/* ── Sidebar ── */
.map-sidebar {
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  overflow: hidden;
  max-height: clamp(300px, 40vh, 480px);
}
@media (min-width: 900px) {
  .map-sidebar { max-height: clamp(500px, 70vh, 780px); }
}
.map-sidebar-head {
  padding: 1.5rem 1.25rem 1rem;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.map-sidebar-title {
  font-family: var(--font-display);
  font-weight: 200;
  font-size: 1.1rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--parchment);
  margin-top: 0.35rem;
}
.map-sidebar-count {
  font-family: var(--font-cond);
  font-size: 0.58rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--p-35);
  margin-top: 0.4rem;
}
.map-sidebar-list { overflow-y: auto; flex: 1; }
.map-sidebar-list::-webkit-scrollbar { width: 4px; }
.map-sidebar-list::-webkit-scrollbar-track { background: transparent; }
.map-sidebar-list::-webkit-scrollbar-thumb { background: var(--border-md); border-radius: 99px; }
.map-sidebar-list::-webkit-scrollbar-thumb:hover { background: var(--p-35); }
/* Subtle "N locations" tag shown inline after the suburb for multi-location bakeries */
.map-bakery-loc-count { color: var(--amber); font-weight: 400; }

/* ── Map canvas ── */
/*
 * STACKING CONTEXT — DO NOT REMOVE these three properties:
 *
 *   position: relative  — required so the absolutely-positioned .map-popup
 *                         is measured relative to this wrapper, not the page.
 *
 *   z-index: 1          — establishes this element as a stacking context
 *                         participant. The LOW value (1) is intentional: it
 *                         keeps the entire map stack below the site header
 *                         (z-index: 100 in global.css). Do NOT raise this.
 *
 *   isolation: isolate  — creates a self-contained stacking context so all
 *                         Leaflet internal z-indexes (tiles 200, markers 600,
 *                         controls 1000, etc.) are contained WITHIN this
 *                         wrapper and never escape to compete with the header.
 *                         Without this, zoom controls at z-index 1000 float
 *                         above the nav bar.
 *
 *   overflow: visible   — must be visible (NOT hidden) so the popup card can
 *                         overflow the map edge. If you change this to hidden,
 *                         the popup will be clipped.
 */
.map-canvas-wrap {
  position: relative;
  z-index: 1;       /* LOW on purpose — keeps map below site header (z-index: 100). Do NOT raise. */
  isolation: isolate; /* Traps all Leaflet internal z-indexes inside this wrapper. Do NOT remove. */
  border-radius: var(--r-card);
  border: 1px solid var(--border);
  overflow: visible; /* Must be visible — popup card overflows the map edge. Do NOT set to hidden. */
}
#kneed-map {
  width: 100%;
  height: clamp(300px, 40vh, 480px);
  border-radius: calc(var(--r-card) - 1px);
  display: block;
}
@media (min-width: 900px) {
  #kneed-map { height: clamp(500px, 70vh, 780px); }
}
</style>

<!-- Map data — read by initMainMap() in src/scripts/map.js -->
<script type="application/json" id="kneed-map-data" is:inline set:html={JSON.stringify({ BAKERIES: allBakeries, PINS: allPins })}></script>

<script>
  // The map page always loads fresh (no ClientRouter) — init immediately.
  import { initMainMap } from '../scripts/map.js';
  if (document.getElementById('kneed-map')) initMainMap();
</script>

