---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const collectionBakeries = await getCollection('bakeries');

// Bakeries not yet in the content collection — supplemental data.
// Add a `locations` array to any entry that has multiple locations.
// If `locations` is present with 2+ entries it takes precedence over lat/lng/address.
const extraBakeries = [
  {
    name: 'Falco Bakery',
    slug: 'falco-bakery',
    suburb: 'Collingwood',
    address: '167 Smith St, Collingwood VIC 3066',
    category: 'Sourdough',
    hours: 'Mon–Fri 7am–4pm, Sat–Sun 8am–3pm',
    website: 'falcobakery.com.au',
    thumbnail: 'https://images.pexels.com/photos/263168/pexels-photo-263168.jpeg?auto=compress&cs=tinysrgb&w=800',
    lat: -37.8024,
    lng: 144.9869,
  },
  {
    name: 'To Be Frank',
    slug: 'to-be-frank',
    suburb: 'Thornbury',
    address: '756 High St, Thornbury VIC 3071',
    category: 'Focaccia',
    hours: 'Wed–Sun 8am–2pm',
    website: null,
    thumbnail: 'https://images.pexels.com/photos/30666809/pexels-photo-30666809.jpeg?auto=compress&cs=tinysrgb&w=800',
    lat: -37.7654,
    lng: 144.9984,
  },
  {
    name: 'Loafer Bread',
    slug: null,
    suburb: 'Yarraville',
    category: 'Sourdough',
    hours: 'Tue–Fri 7am–2pm, Sat–Sun 8am–1pm',
    website: 'loaferbread.com.au',
    thumbnail: 'https://images.pexels.com/photos/1775043/pexels-photo-1775043.jpeg?auto=compress&cs=tinysrgb&w=800',
    locations: [
      { addr: '63 Anderson St, Yarraville VIC 3013', lat: -37.8143, lng: 144.8943 },
      { addr: '36 Paisley St, Footscray VIC 3011',  lat: -37.8013, lng: 144.9010 },
    ],
  },
  {
    name: 'Beatrix',
    slug: null,
    suburb: 'North Melbourne',
    address: '28 Bignell Ln, North Melbourne VIC 3051',
    category: 'Pastry',
    hours: 'Tue–Sat 8am–4pm, Sun 9am–3pm',
    website: null,
    thumbnail: 'https://images.pexels.com/photos/2135/food-france-morning-breakfast.jpg?auto=compress&cs=tinysrgb&w=800',
    lat: -37.8008,
    lng: 144.9445,
  },
  {
    name: 'Dench Bakers',
    slug: null,
    suburb: 'Fitzroy North',
    address: '482 Brunswick St, Fitzroy North VIC 3068',
    category: 'Sourdough',
    hours: 'Daily 7am–3pm',
    website: 'denchbakers.com.au',
    thumbnail: 'https://images.pexels.com/photos/1084101/pexels-photo-1084101.jpeg?auto=compress&cs=tinysrgb&w=800',
    lat: -37.7810,
    lng: 144.9828,
  },
];

// ── Data normalisation ────────────────────────────────────────────────────────
// allBakeries = one entry per unique bakery → drives the sidebar (one row each)
//               and popup content (name, hours, website, etc.)
// allPins     = one entry per map marker    → drives Leaflet marker placement
//
// Each pin carries a bakeryIdx so clicking a marker can look up its bakery.
// Sidebar buttons are indexed by bakeryIdx.

type LocEntry = { addr: string; lat: number; lng: number };
interface BakeryInput {
  name: string; slug: string | null; suburb: string; category: string;
  hours: string | null; website: string | null; thumbnail: string;
  address?: string; lat?: number; lng?: number;
  locations?: LocEntry[];
}
interface BakeryEntry {
  name: string; slug: string | null; suburb: string; category: string;
  hours: string | null; website: string | null; thumbnail: string;
  locations: LocEntry[]; // always at least one entry
}
interface PinEntry {
  bakeryIdx: number; // index into allBakeries
  lat: number;
  lng: number;
  addr: string;      // address for this specific pin
}

function toBakeryEntry(b: BakeryInput): BakeryEntry {
  const locs: LocEntry[] = [];
  if (b.locations && b.locations.length > 0) {
    b.locations.forEach(l => locs.push({ addr: l.addr, lat: l.lat, lng: l.lng }));
  } else if (b.lat != null && b.lng != null) {
    locs.push({ addr: b.address ?? '', lat: b.lat, lng: b.lng });
  }
  return {
    name: b.name, slug: b.slug, suburb: b.suburb, category: b.category,
    hours: b.hours ?? null, website: b.website ?? null, thumbnail: b.thumbnail,
    locations: locs,
  };
}

const allBakeries: BakeryEntry[] = [
  ...collectionBakeries
    .filter(b =>
      (b.data.lat != null && b.data.lng != null) ||
      (b.data.locations && b.data.locations.length > 0)
    )
    .map(b => toBakeryEntry({
      name: b.data.name, slug: b.data.slug, suburb: b.data.suburb,
      category: b.data.category, hours: b.data.hours ?? null,
      website: b.data.website ?? null, thumbnail: b.data.thumbnail,
      address: b.data.address, lat: b.data.lat, lng: b.data.lng,
      locations: b.data.locations as LocEntry[] | undefined,
    })),
  ...extraBakeries.map(b => toBakeryEntry(b as BakeryInput)),
];

// Flat marker list — one pin per location, each pointing back to its bakery
const allPins: PinEntry[] = allBakeries.flatMap((bakery, bakeryIdx) =>
  bakery.locations.map(loc => ({ bakeryIdx, lat: loc.lat, lng: loc.lng, addr: loc.addr }))
);
---

<BaseLayout
  title="Find a Bakery"
  description="Every Melbourne bakery on one map — find addresses, opening hours and watch their story."
>
  <main>
    <div class="map-page-wrap" id="map-page">

      <!-- ── SIDEBAR ── -->
      <aside class="map-sidebar">
        <div class="map-sidebar-head">
          <div class="wf-eyebrow">Find a Bakery</div>
          <h1 class="map-sidebar-title">Melbourne's Bread Map</h1>
          <p class="map-sidebar-count">{allBakeries.length} {allBakeries.length === 1 ? 'bakery' : 'bakeries'}</p>
        </div>
        <div class="map-sidebar-list" id="map-sidebar-list">
          {allBakeries.map((b, i) => (
            <button
              class="map-bakery-item"
              data-index={String(i)}
              aria-label={`Select ${b.name}`}
            >
              <div class="map-bakery-num">{String(i + 1).padStart(2, '0')}</div>
              <img class="map-bakery-thumb" src={b.thumbnail} alt={b.name} loading="lazy" />
              <div class="map-bakery-info">
                <div class="map-bakery-cat">{b.category}</div>
                <div class="map-bakery-name">{b.name}</div>
                <div class="map-bakery-addr">
                  {b.suburb}
                  {b.locations.length > 1 && (
                    <span class="map-bakery-loc-count">&nbsp;· {b.locations.length} locations</span>
                  )}
                </div>
              </div>
            </button>
          ))}
        </div>
      </aside>

      <!-- ── MAP + POPUP ── -->
      <div class="map-canvas-wrap" id="map-canvas-wrap">
        <div id="kneed-map"></div>

        <!-- Popup card — positioned absolutely relative to the map canvas -->
        <div class="map-popup" id="map-popup" role="dialog" aria-modal="true" aria-label="Bakery details">
          <button class="map-popup-close" id="map-popup-close" aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
          <img class="map-popup-img" id="map-popup-img" src="" alt="" loading="lazy" />
          <div class="map-popup-body">
            <div class="map-popup-cat" id="map-popup-cat"></div>
            <div class="map-popup-name" id="map-popup-name"></div>
            <div class="map-popup-detail" id="map-popup-addr-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span id="map-popup-addr"></span>
            </div>
            <div class="map-popup-detail" id="map-popup-hours-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span id="map-popup-hours"></span>
            </div>
            <div class="map-popup-actions" id="map-popup-actions"></div>
          </div>
        </div>
      </div>

    </div>
  </main>
</BaseLayout>

<style>
/* ── Layout ── */
.map-page-wrap {
  display: grid;
  max-width: var(--max-w);
  margin: 0 auto;
  padding: clamp(1.5rem, 3vw, 2.5rem) var(--px) clamp(3rem, 5vw, 4rem);
  gap: 1.125rem;
  grid-template-columns: 1fr;
}
@media (min-width: 900px) {
  .map-page-wrap { grid-template-columns: 300px 1fr; }
}

/* ── Sidebar ── */
.map-sidebar {
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  overflow: hidden;
  max-height: clamp(300px, 40vh, 480px);
}
@media (min-width: 900px) {
  .map-sidebar { max-height: clamp(500px, 70vh, 780px); }
}
.map-sidebar-head {
  padding: 1.5rem 1.25rem 1rem;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.map-sidebar-title {
  font-family: var(--font-display);
  font-weight: 200;
  font-size: 1.1rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--parchment);
  margin-top: 0.35rem;
}
.map-sidebar-count {
  font-family: var(--font-cond);
  font-size: 0.58rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--p-35);
  margin-top: 0.4rem;
}
.map-sidebar-list { overflow-y: auto; flex: 1; }
/* Subtle "N locations" tag shown inline after the suburb for multi-location bakeries */
.map-bakery-loc-count { color: var(--amber); font-weight: 400; }

/* ── Map canvas ── */
/*
 * STACKING CONTEXT — DO NOT REMOVE these three properties:
 *
 *   position: relative  — required so the absolutely-positioned .map-popup
 *                         is measured relative to this wrapper, not the page.
 *
 *   z-index: 1          — establishes this element as a stacking context
 *                         participant. The LOW value (1) is intentional: it
 *                         keeps the entire map stack below the site header
 *                         (z-index: 100 in global.css). Do NOT raise this.
 *
 *   isolation: isolate  — creates a self-contained stacking context so all
 *                         Leaflet internal z-indexes (tiles 200, markers 600,
 *                         controls 1000, etc.) are contained WITHIN this
 *                         wrapper and never escape to compete with the header.
 *                         Without this, zoom controls at z-index 1000 float
 *                         above the nav bar.
 *
 *   overflow: visible   — must be visible (NOT hidden) so the popup card can
 *                         overflow the map edge. If you change this to hidden,
 *                         the popup will be clipped.
 */
.map-canvas-wrap {
  position: relative;
  z-index: 1;       /* LOW on purpose — keeps map below site header (z-index: 100). Do NOT raise. */
  isolation: isolate; /* Traps all Leaflet internal z-indexes inside this wrapper. Do NOT remove. */
  border-radius: var(--r-card);
  border: 1px solid var(--border);
  overflow: visible; /* Must be visible — popup card overflows the map edge. Do NOT set to hidden. */
}
#kneed-map {
  width: 100%;
  height: clamp(300px, 40vh, 480px);
  border-radius: calc(var(--r-card) - 1px);
  display: block;
}
@media (min-width: 900px) {
  #kneed-map { height: clamp(500px, 70vh, 780px); }
}
</style>

<script is:inline define:vars={{ BAKERIES: allBakeries, PINS: allPins }}>
  /*
   * ╔══════════════════════════════════════════════════════════════════╗
   * ║          ⚠️  MAP INITIALISATION — READ BEFORE EDITING  ⚠️       ║
   * ╠══════════════════════════════════════════════════════════════════╣
   * ║                                                                  ║
   * ║  This page uses Astro's ClientRouter (SPA View Transitions).     ║
   * ║  That means this <script is:inline> block RE-EXECUTES on every   ║
   * ║  SPA navigation back to /map — it is NOT a one-shot module.      ║
   * ║                                                                  ║
   * ║  DATA MODEL                                                       ║
   * ║  BAKERIES — one entry per unique bakery. Drives the sidebar       ║
   * ║             (one row each) and popup content.                     ║
   * ║  PINS     — one entry per map marker. Each pin has a bakeryIdx   ║
   * ║             that points back into BAKERIES. markers[] is indexed  ║
   * ║             the same way as PINS.                                 ║
   * ║                                                                  ║
   * ║  RULES — violating any of these has caused real bugs:            ║
   * ║                                                                  ║
   * ║  1. NEVER initialise the map outside of initMap().               ║
   * ║                                                                  ║
   * ║  2. NEVER capture DOM elements at the top level of this script.  ║
   * ║     Top-level DOM refs go STALE after a View Transition replaces ║
   * ║     the DOM. Always fetch them INSIDE initMap().                 ║
   * ║                                                                  ║
   * ║  3. Guard initMap() with the container._leaflet_id check.        ║
   * ║                                                                  ║
   * ║  4. ALWAYS call destroyMap() before re-initialising (handled by  ║
   * ║     the lifecycle registry in BaseLayout.astro).                 ║
   * ║     Do NOT add another astro:page-load listener here.            ║
   * ║                                                                  ║
   * ║  5. ALWAYS call map.invalidateSize() in a setTimeout(200).       ║
   * ║                                                                  ║
   * ║  6. Use onclick = fn (not addEventListener) for sidebar/close.   ║
   * ║                                                                  ║
   * ║  7. popup is null at parse time, assigned inside initMap() only. ║
   * ║                                                                  ║
   * ║  8. For z-index / stacking context, see .map-canvas-wrap CSS.   ║
   * ║                                                                  ║
   * ╚══════════════════════════════════════════════════════════════════╝
   */

  /* ── Module-level state ─────────────────────────────────────────────
   *
   * activePopupLatLng — the specific latlng the popup is anchored to (tracked so
   *                    onMapMove can reposition it without knowing which pin was
   *                    clicked — important for multi-location bakeries where the
   *                    sidebar click and a specific marker click may differ)
   * markers          — one Leaflet marker per PIN (same order as PINS array)
   */
  var activePopupLatLng = null;
  var markers           = [];
  var map               = null;
  var popup             = null; // assigned inside initMap() — see rule 2 above

  /* ── makeMarkerIcon(active) ─────────────────────────────────────────
   *
   * Returns a Leaflet divIcon. Active markers are larger and parchment-
   * coloured; inactive markers are smaller and amber.
   */
  function makeMarkerIcon(active) {
    var size   = active ? 16 : 12;
    var half   = size / 2;
    var bg     = active ? '#f2ede6' : '#c8833a';
    var border = active ? '#c8833a' : 'rgba(242,237,230,0.85)';
    var shadow = active
      ? '0 0 0 3px rgba(200,131,58,0.25), 0 2px 12px rgba(0,0,0,0.5)'
      : '0 2px 8px rgba(0,0,0,0.45)';
    return L.divIcon({
      className: '',
      html: '<div style="width:' + size + 'px;height:' + size + 'px;border-radius:50%;'
          + 'background:' + bg + ';border:2px solid ' + border + ';'
          + 'box-shadow:' + shadow + ';'
          + 'transition:width 0.2s,height 0.2s,background 0.2s,box-shadow 0.2s;'
          + 'cursor:pointer;"></div>',
      iconSize:   [size, size],
      iconAnchor: [half, half],
    });
  }

  /* ── fillPopup(bakery, addr) ────────────────────────────────────────
   *
   * Writes bakery data into the popup card's DOM elements.
   * `addr` is passed separately because for multi-location bakeries the
   * clicked pin's specific address may differ from bakery.locations[0].addr.
   *
   * Watch Story / Website buttons are always rendered — if slug/website is
   * null they are visually disabled so layout doesn't shift between bakeries.
   */
  function fillPopup(bakery, addr) {
    document.getElementById('map-popup-img').src = bakery.thumbnail;
    document.getElementById('map-popup-img').alt = bakery.name;
    document.getElementById('map-popup-cat').textContent  = bakery.category;
    document.getElementById('map-popup-name').textContent = bakery.name;

    var addrEl   = document.getElementById('map-popup-addr');
    addrEl.innerHTML = '';
    var addrLink = document.createElement('a');
    addrLink.href      = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(addr);
    addrLink.target    = '_blank';
    addrLink.rel       = 'noopener noreferrer';
    addrLink.textContent = addr;
    addrLink.className = 'map-popup-addr-link';
    addrEl.appendChild(addrLink);

    var hoursRow = document.getElementById('map-popup-hours-row');
    var hoursEl  = document.getElementById('map-popup-hours');
    if (bakery.hours) {
      hoursEl.textContent    = bakery.hours;
      hoursRow.style.display = '';
    } else {
      hoursRow.style.display = 'none';
    }

    var actions = document.getElementById('map-popup-actions');
    actions.innerHTML = '';

    var watchBtn = document.createElement('a');
    watchBtn.className   = 'map-popup-btn map-popup-btn-primary';
    watchBtn.textContent = 'Watch Story';
    if (bakery.slug) {
      watchBtn.href = '/bakeries/' + bakery.slug;
    } else {
      watchBtn.style.opacity       = '0.4';
      watchBtn.style.pointerEvents = 'none';
    }
    actions.appendChild(watchBtn);

    var webBtn = document.createElement('a');
    webBtn.className   = 'map-popup-btn map-popup-btn-ghost';
    webBtn.textContent = 'Website';
    if (bakery.website) {
      webBtn.href   = bakery.website.startsWith('http') ? bakery.website : 'https://' + bakery.website;
      webBtn.target = '_blank';
      webBtn.rel    = 'noopener noreferrer';
    } else {
      webBtn.style.opacity       = '0.4';
      webBtn.style.pointerEvents = 'none';
    }
    actions.appendChild(webBtn);
  }

  /* ── positionPopup(latlng) ─────────────────────────────────────────
   *
   * Positions the popup card next to a marker using pixel coordinates.
   * Prefers right-of-marker, flips left if not enough room, always clamped.
   * DO NOT cache mapW/mapH outside this function — they change on resize.
   */
  function positionPopup(latlng) {
    var pt   = map.latLngToContainerPoint(latlng);
    var mapEl = document.getElementById('kneed-map');
    var mapW = mapEl.offsetWidth;
    var mapH = mapEl.offsetHeight;
    var popW = popup.offsetWidth  || 300;
    var popH = popup.offsetHeight || 280;
    var gap  = 14;
    var half = 7; // half of the 14px active marker diameter

    var left, origin;
    if (pt.x + half + gap + popW < mapW - 8) {
      left = pt.x + half + gap; origin = 'left center';
    } else {
      left = pt.x - half - gap - popW; origin = 'right center';
    }
    left = Math.max(8, Math.min(left, mapW - popW - 8));

    var top = Math.round(pt.y - popH / 2);
    top = Math.max(8, Math.min(top, mapH - popH - 8));

    popup.style.left            = left + 'px';
    popup.style.top             = top  + 'px';
    popup.style.transformOrigin = origin;
  }

  /* ── showPopup / hidePopup ─────────────────────────────────────────
   *
   * showPopup tracks activePopupLatLng so onMapMove can reposition the
   * popup correctly while the user pans — regardless of whether the popup
   * was opened via a sidebar click or a specific marker click.
   */
  function showPopup(bakery, addr, latlng) {
    fillPopup(bakery, addr);
    activePopupLatLng = latlng;
    positionPopup(latlng);
    popup.classList.add('visible');
  }

  function hidePopup() {
    popup.classList.remove('visible');
    activePopupLatLng = null;
  }

  /* ── selectBakery(bakeryIdx, addr, latlng) ──────────────────────────
   *
   * Central selection handler — called from both marker clicks and sidebar
   * clicks. Updates marker icons for ALL pins of the selected bakery (so
   * multi-location bakeries show all their pins as active), highlights the
   * single sidebar row, and shows the popup.
   *
   * bakeryIdx — index into BAKERIES
   * addr      — the specific location address to show in the popup
   * latlng    — the map position to anchor the popup to
   */
  function selectBakery(bakeryIdx, addr, latlng) {
    // Highlight all pins that belong to this bakery; dim everything else.
    markers.forEach(function(m, pinIdx) {
      var isSelected = PINS[pinIdx].bakeryIdx === bakeryIdx;
      m.setIcon(makeMarkerIcon(isSelected));
      m.setOpacity(isSelected ? 1 : 0.50);
    });

    // One sidebar row per bakery — highlight by bakeryIdx.
    document.querySelectorAll('.map-bakery-item').forEach(function(el, i) {
      el.classList.toggle('active', i === bakeryIdx);
    });
    var activeItem = document.querySelector('.map-bakery-item[data-index="' + bakeryIdx + '"]');
    if (activeItem) activeItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    showPopup(BAKERIES[bakeryIdx], addr, latlng);
  }

  /* ── onMapMove() ───────────────────────────────────────────────────
   *
   * Re-positions the popup to stay next to its marker while the user pans
   * or zooms. Uses activePopupLatLng (set by showPopup) so it works for
   * both single and multi-location bakeries.
   */
  function onMapMove() {
    if (!activePopupLatLng || !popup.classList.contains('visible')) return;
    positionPopup(activePopupLatLng);
  }

  /* ── clearSelection() ──────────────────────────────────────────────
   *
   * Resets all selection state. Resets every marker icon (not just the
   * active bakery's pins) because with multi-location bakeries multiple
   * markers may be in the active state.
   */
  function clearSelection() {
    markers.forEach(function(m) { m.setIcon(makeMarkerIcon(false)); m.setOpacity(1); });
    activePopupLatLng = null;
    document.querySelectorAll('.map-bakery-item').forEach(function(el) {
      el.classList.remove('active');
    });
  }

  /* ── initMap() ─────────────────────────────────────────────────────
   *
   * Creates the Leaflet map, tile layer, one marker per PIN, and all
   * event listeners. Called once per page-load via the lifecycle registry.
   *
   * GUARD: container._leaflet_id — Leaflet sets this automatically; it
   *   resets when the DOM is replaced on SPA navigation so we never need
   *   a manual window.* flag. DO NOT replace this guard.
   *
   * Markers are built from PINS (not BAKERIES) so multi-location bakeries
   * produce one dot per location. Each marker's click handler captures the
   * pin's bakeryIdx + addr to open the correct popup content.
   *
   * Sidebar clicks:
   *   • Single-location: pan to zoom ≥14 and open popup.
   *   • Multi-location: fitBounds to show all the bakery's pins, open popup
   *     anchored to the primary (index 0) pin's address.
   *
   * invalidateSize setTimeout(200): DO NOT remove — tiles won't fill the
   *   canvas if layout hasn't settled when Leaflet first measures the container.
   */
  function initMap() {
    var container = document.getElementById('kneed-map');
    if (!container || container._leaflet_id) return;
    if (container.offsetHeight === 0) return;

    popup = document.getElementById('map-popup');
    if (!popup) return;

    map = L.map('kneed-map', {
      center: [-37.814, 144.970],
      zoom: 12,
      zoomControl: true,
      attributionControl: false,
      scrollWheelZoom: false,
      dragging: true,
      touchZoom: true,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      maxZoom: 19,
    }).addTo(map);

    // One Leaflet marker per PIN. Each closure captures its own `pin` object
    // so the click handler always references the correct bakery + address.
    PINS.forEach(function(pin) {
      var marker = L.marker([pin.lat, pin.lng], { icon: makeMarkerIcon(false) }).addTo(map);
      markers.push(marker);

      marker.on('click', function(e) {
        // stopPropagation prevents the map background 'click' (which closes
        // the popup) from firing immediately after this opens it.
        L.DomEvent.stopPropagation(e);
        selectBakery(pin.bakeryIdx, pin.addr, marker.getLatLng());
      });
    });

    // Sidebar: one button per bakery (indexed by bakeryIdx, not pinIdx).
    // Use onclick = (not addEventListener) to avoid stacking listeners on
    // repeated SPA navigations back to this page.
    document.querySelectorAll('.map-bakery-item').forEach(function(item) {
      item.onclick = function() {
        var bakeryIdx = parseInt(item.dataset.index, 10);

        // Collect all pins for this bakery.
        var bakeryPins = PINS.filter(function(p) { return p.bakeryIdx === bakeryIdx; });
        if (!bakeryPins.length) return;

        var primaryPin = bakeryPins[0];
        var primaryLL  = L.latLng(primaryPin.lat, primaryPin.lng);

        selectBakery(bakeryIdx, primaryPin.addr, primaryLL);

        if (bakeryPins.length > 1) {
          // Multi-location: fit the map to show all this bakery's pins.
          var bounds = L.latLngBounds(bakeryPins.map(function(p) { return [p.lat, p.lng]; }));
          map.fitBounds(bounds, { padding: [60, 60], animate: true });
        } else {
          // Single location: pan to at least zoom 14.
          map.setView(primaryLL, Math.max(map.getZoom(), 14), { animate: true, duration: 0.5 });
        }
      };
    });

    document.getElementById('map-popup-close').onclick = function() {
      hidePopup();
      clearSelection();
    };

    map.on('click', function() {
      hidePopup();
      clearSelection();
    });

    map.on('move zoom', onMapMove);

    setTimeout(function() { map.invalidateSize(); }, 200);
  }

  /* ── loadLeaflet(cb) ────────────────────────────────────────────────
   *
   * Lazy-loads Leaflet CSS + JS from CDN on first use. Subsequent calls
   * (e.g. navigating back to /map) find window.L already defined and call
   * cb() synchronously — no extra network request.
   * Version pinned at 1.9.4 — do not upgrade without testing z-index behaviour.
   */
  function loadLeaflet(cb) {
    if (window.L) { cb(); return; }
    var css = document.createElement('link');
    css.rel  = 'stylesheet';
    css.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
    document.head.appendChild(css);
    var js = document.createElement('script');
    js.src    = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
    js.onload = cb;
    document.head.appendChild(js);
  }

  /* ── destroyMap() ───────────────────────────────────────────────────
   *
   * Called on astro:before-swap. Tears down Leaflet and resets all state.
   * map.remove() is try/caught because Leaflet can throw if the container
   * was already removed from the DOM before destroy runs.
   */
  function destroyMap() {
    if (map) { try { map.remove(); } catch(e) {} map = null; }
    popup             = null;
    markers           = [];
    activePopupLatLng = null;
  }

  /*
   * ── Lifecycle registration ──────────────────────────────────────────
   * ⚠️  DO NOT add another astro:page-load listener here. The registry in
   *     BaseLayout.astro is the single place — a second listener causes
   *     double-init and two overlapping Leaflet instances.
   */
  window.registerPageInit('map', function() {
    if (!document.getElementById('kneed-map')) return;
    loadLeaflet(initMap);
  }, destroyMap);
</script>
