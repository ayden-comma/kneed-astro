---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';
import { env } from 'cloudflare:workers';

// A token no longer auto-unsubscribes: it lands on a confirmation form that POSTs to
// /api/unsubscribe. The actual status change happens server-side on submit.
const token = Astro.url.searchParams.get('token');
const done = Astro.url.searchParams.has('done');
const mode: 'confirm' | 'done' | 'form' = token ? 'confirm' : done ? 'done' : 'form';

// Show the token holder WHICH address this link unsubscribes, masked
// ("ay***@commafilms.com.au") — a person with multiple addresses otherwise can't
// tell which subscription they're about to end. Look-up is display-only and
// best-effort: any failure (bad token, missing grant, network) leaves
// maskedEmail null and the page renders exactly as before. The full address is
// never rendered; possession of the email itself is the only way to hold the
// token, so the mask leaks nothing the holder doesn't already have.
function maskEmail(addr: string): string {
  const at = addr.indexOf('@');
  if (at <= 0) return '***';
  const local = addr.slice(0, at);
  const keep = local.length > 3 ? 2 : 1;
  return `${local.slice(0, keep)}***${addr.slice(at)}`;
}

let maskedEmail: string | null = null;
if (mode === 'confirm' && token) {
  try {
    const serviceKey = env.SUPABASE_SERVICE_ROLE_KEY;
    if (serviceKey) {
      const svc = createClient(import.meta.env.PUBLIC_SUPABASE_URL as string, serviceKey);
      const { data } = await svc
        .from('email_subscribers')
        .select('email')
        .eq('unsubscribe_token', token)
        .maybeSingle();
      if (data?.email) maskedEmail = maskEmail(String(data.email));
    }
  } catch { /* display-only — never block the page */ }
}

const REASONS = [
  { value: 'too_many',        label: 'Too many emails' },
  { value: 'not_relevant',    label: 'Not relevant to me' },
  { value: 'never_signed_up', label: 'I never signed up' },
  { value: 'not_expected',    label: 'Not what I expected' },
  { value: 'other',           label: 'Other' },
];
---

<BaseLayout title="Unsubscribe" description="Manage your (K)Need newsletter subscription." robots="noindex, follow">
  <main class="wf-container py-page" style="display:flex;justify-content:center;">

    <!-- U1 "Quiet exit card": contained card, masked address as a chip, reasons as
         selectable rows, keep-subscribed as the primary action, calm confirm. -->
    <div class="unsub-card">

      {mode === 'confirm' && (
        <>
          <div class="wf-eyebrow">Newsletter</div>
          <h1 class="unsub-h1">Before you go</h1>
          {maskedEmail && (
            <div class="unsub-chip">
              <svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/></svg>
              <span>{maskedEmail}</span>
            </div>
          )}
          <p class="unsub-lead">Tell us why, if you have a moment &mdash; it's optional.</p>
          <form method="POST" action="/api/unsubscribe" class="unsub-form">
            <input type="hidden" name="token" value={token} />
            <div class="unsub-reasons">
              {REASONS.map((r) => (
                <label class="unsub-row">
                  <input type="radio" name="reason" value={r.value} />
                  <span class="unsub-dot" aria-hidden="true"></span>
                  <span class="unsub-row-label">{r.label}</span>
                </label>
              ))}
            </div>
            <textarea class="unsub-comment" name="comment" rows="3" placeholder="Anything else? (optional)"></textarea>
            <div class="unsub-actions">
              <a href="/" class="unsub-btn unsub-btn-primary">No, keep me subscribed</a>
              <button type="submit" class="unsub-btn unsub-btn-ghost">Confirm unsubscribe</button>
            </div>
          </form>
          <p class="unsub-foot">The films stay free either way.</p>
        </>
      )}

      {mode === 'done' && (
        <>
          <div class="wf-eyebrow">Newsletter</div>
          <h1 class="unsub-h1">You're unsubscribed</h1>
          <p class="unsub-lead">You won't receive any more emails from us. You can resubscribe anytime at <a href="/" style="color:var(--amber);">kneed.tv</a>.</p>
          <p class="unsub-foot">The films stay free either way.</p>
        </>
      )}

      {mode === 'form' && (
        <>
          <div class="wf-eyebrow">Newsletter</div>
          <h1 class="unsub-h1">Unsubscribe</h1>
          <p class="unsub-lead">Enter your email address to stop receiving updates from (K)Need.</p>
          <form method="POST" action="/api/unsubscribe" class="unsub-form">
            <input class="auth-input" type="email" name="email" required placeholder="your@email.com" autocomplete="email" />
            <div class="unsub-actions">
              <button type="submit" class="unsub-btn unsub-btn-ghost">Unsubscribe</button>
            </div>
          </form>
        </>
      )}

    </div>

  </main>
</BaseLayout>

<style>
  .unsub-card{
    width:100%;max-width:460px;
    background:var(--surface-2,#171310);
    border:1px solid var(--border-md);border-radius:12px;
    padding:42px 44px 34px;
    display:flex;flex-direction:column;gap:16px;
  }
  .unsub-h1{
    font-family:var(--font-display);font-weight:200;font-size:1.6rem;
    letter-spacing:.09em;text-transform:uppercase;color:var(--parchment);margin:0;
  }
  .unsub-chip{
    display:inline-flex;align-items:center;gap:9px;align-self:flex-start;
    border:1px solid var(--border-md);border-radius:100px;padding:7px 15px;
    font-size:.82rem;color:var(--p-50);
  }
  .unsub-lead{font-weight:300;font-size:.9rem;line-height:1.6;color:var(--p-50);margin:0;}
  .unsub-form{display:flex;flex-direction:column;gap:16px;}
  .unsub-reasons{display:flex;flex-direction:column;gap:10px;}
  .unsub-row{
    display:flex;align-items:center;gap:12px;cursor:pointer;
    border:1px solid var(--border-md);border-radius:6px;padding:12px 16px;
    transition:border-color .15s;
  }
  .unsub-row:hover{border-color:var(--p-50);}
  .unsub-row input{position:absolute;opacity:0;pointer-events:none;}
  .unsub-dot{
    width:14px;height:14px;border-radius:50%;flex-shrink:0;
    border:1.5px solid var(--p-50);
    display:flex;align-items:center;justify-content:center;
    transition:border-color .15s;
  }
  .unsub-dot::after{
    content:"";width:6px;height:6px;border-radius:50%;
    background:transparent;transition:background .15s;
  }
  .unsub-row-label{font-size:.9rem;font-weight:300;color:var(--p-70);transition:color .15s;}
  .unsub-row:has(input:checked){border-color:var(--amber);}
  .unsub-row:has(input:checked) .unsub-dot{border-color:var(--amber);}
  .unsub-row:has(input:checked) .unsub-dot::after{background:var(--amber);}
  .unsub-row:has(input:checked) .unsub-row-label{color:var(--parchment);}
  .unsub-comment{
    background:none;border:1px solid var(--border-md);border-radius:6px;
    padding:12px 16px;font-family:inherit;font-size:.88rem;font-weight:300;
    color:var(--parchment);resize:vertical;min-height:64px;
  }
  .unsub-comment::placeholder{color:var(--p-30,#57504a);}
  .unsub-comment:focus{outline:none;border-color:var(--p-50);}
  .unsub-actions{display:flex;flex-direction:column;gap:11px;margin-top:2px;}
  .unsub-btn{
    display:block;width:100%;text-align:center;cursor:pointer;
    font-weight:600;letter-spacing:.24em;text-transform:uppercase;
    border-radius:6px;padding:14px 0;text-decoration:none;
    transition:filter .15s,color .15s,border-color .15s;
  }
  .unsub-btn-primary{background:var(--amber);color:#0E0C0A;border:1px solid var(--amber);font-size:.78rem;}
  .unsub-btn-primary:hover{filter:brightness(1.08);}
  .unsub-btn-ghost{background:none;color:var(--p-50);border:1px solid var(--border-md);font-size:.74rem;}
  .unsub-btn-ghost:hover{color:var(--parchment);border-color:var(--p-50);}
  .unsub-foot{text-align:center;font-weight:300;font-size:.8rem;color:var(--p-30,#57504a);margin:4px 0 0;}
  @media(max-width:480px){.unsub-card{padding:32px 26px 28px;}}
</style>
