---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';
import { env } from 'cloudflare:workers';

// A token no longer auto-unsubscribes: it lands on a confirmation form that POSTs to
// /api/unsubscribe. The actual status change happens server-side on submit.
const token = Astro.url.searchParams.get('token');
const done = Astro.url.searchParams.has('done');
const mode: 'confirm' | 'done' | 'form' = token ? 'confirm' : done ? 'done' : 'form';

// Show the token holder WHICH address this link unsubscribes, masked
// ("ay***@commafilms.com.au") — a person with multiple addresses otherwise can't
// tell which subscription they're about to end. Look-up is display-only and
// best-effort: any failure (bad token, missing grant, network) leaves
// maskedEmail null and the page renders exactly as before. The full address is
// never rendered; possession of the email itself is the only way to hold the
// token, so the mask leaks nothing the holder doesn't already have.
function maskEmail(addr: string): string {
  const at = addr.indexOf('@');
  if (at <= 0) return '***';
  const local = addr.slice(0, at);
  const keep = local.length > 3 ? 2 : 1;
  return `${local.slice(0, keep)}***${addr.slice(at)}`;
}

let maskedEmail: string | null = null;
if (mode === 'confirm' && token) {
  try {
    const serviceKey = env.SUPABASE_SERVICE_ROLE_KEY;
    if (serviceKey) {
      const svc = createClient(import.meta.env.PUBLIC_SUPABASE_URL as string, serviceKey);
      const { data } = await svc
        .from('email_subscribers')
        .select('email')
        .eq('unsubscribe_token', token)
        .maybeSingle();
      if (data?.email) maskedEmail = maskEmail(String(data.email));
    }
  } catch { /* display-only — never block the page */ }
}

const REASONS = [
  { value: 'too_many',        label: 'Too many emails' },
  { value: 'not_relevant',    label: 'Not relevant to me' },
  { value: 'never_signed_up', label: 'I never signed up' },
  { value: 'not_expected',    label: 'Not what I expected' },
  { value: 'other',           label: 'Other' },
];
---

<BaseLayout title="Unsubscribe" description="Manage your (K)Need newsletter subscription." robots="noindex, follow">
  <main class="wf-container py-page">

    {mode === 'confirm' && (
      <div class="wf-page-head">
        <div class="wf-eyebrow">Newsletter</div>
        <h1 class="wf-page-h1">Before you go</h1>
        <p class="wf-page-intro">
          {maskedEmail
            ? <>Confirm you'd like to stop emails from (K)Need to <strong style="color:var(--parchment);">{maskedEmail}</strong>. If you have a moment, telling us why helps — but it's optional.</>
            : <>Confirm you'd like to stop receiving emails from (K)Need. If you have a moment, telling us why helps — but it's optional.</>}
        </p>
      </div>
    )}

    {mode === 'confirm' && (
      <div class="simple-body">
        <form method="POST" action="/api/unsubscribe" style="display:flex;flex-direction:column;gap:1.25rem;max-width:28rem;">
          <input type="hidden" name="token" value={token} />

          <fieldset style="border:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.6rem;">
            <legend style="padding:0;margin-bottom:0.25rem;font-size:0.9rem;color:var(--p-70);">Reason (optional)</legend>
            {REASONS.map((r) => (
              <label style="display:flex;align-items:center;gap:0.6rem;cursor:pointer;font-size:0.95rem;">
                <input type="radio" name="reason" value={r.value} />
                <span>{r.label}</span>
              </label>
            ))}
          </fieldset>

          <textarea class="auth-input" name="comment" rows="3" placeholder="Anything else? (optional)" style="resize:vertical;"></textarea>

          <button type="submit" class="wf-pill pill-dark">Confirm unsubscribe</button>
          <a href="/" style="text-align:center;font-size:0.9rem;color:var(--amber);text-decoration:none;">No, keep me subscribed</a>
        </form>
      </div>
    )}

    {mode === 'done' && (
      <div class="wf-page-head">
        <div class="wf-eyebrow">Newsletter</div>
        <h1 class="wf-page-h1">You're unsubscribed</h1>
        <p class="wf-page-intro">You won't receive any more emails from us. You can resubscribe anytime at <a href="/" style="color:var(--amber);">kneed.tv</a>.</p>
      </div>
    )}

    {mode === 'form' && (
      <div class="wf-page-head">
        <div class="wf-eyebrow">Newsletter</div>
        <h1 class="wf-page-h1">Unsubscribe</h1>
        <p class="wf-page-intro">Enter your email address to stop receiving updates from (K)Need.</p>
      </div>
    )}

    {mode === 'form' && (
      <div class="simple-body">
        <form method="POST" action="/api/unsubscribe" style="display:flex;flex-direction:column;gap:1rem;max-width:22rem;">
          <input class="auth-input" type="email" name="email" required placeholder="your@email.com" autocomplete="email" />
          <button type="submit" class="wf-pill pill-dark">Unsubscribe</button>
        </form>
      </div>
    )}

  </main>
</BaseLayout>
