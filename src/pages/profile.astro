---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="My Recipe Book" description="Your (K)Need recipe book.">
  <main class="wf-container py-page">

    <!-- Skeleton -->
    <div id="rb-skeleton">
      <div class="rb-skel-hcard">
        <div class="rb-skel-hcard-top">
          <div class="skeleton rb-skel-hcard-avatar"></div>
          <div class="rb-skel-hcard-lines">
            <div class="skeleton rb-skel-line-xs"></div>
            <div class="skeleton rb-skel-line-lg"></div>
            <div class="skeleton rb-skel-line-sm"></div>
          </div>
        </div>
        <div class="rb-skel-hcard-stats">
          <div class="skeleton rb-skel-stat"></div>
          <div class="skeleton rb-skel-stat"></div>
          <div class="skeleton rb-skel-stat"></div>
        </div>
      </div>
      <div class="rb-skel-grid">
        {[0,1,2].map(() => (
          <div class="rb-skel-card">
            <div class="skeleton" style="height:140px;"></div>
            <div class="rb-skel-card-body">
              <div class="skeleton rb-skel-card-line"></div>
              <div class="skeleton rb-skel-card-line-sm"></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Content -->
    <div id="rb-content" style="display:none; opacity:0;">

      <div class="rb-header-card">
        <div class="rb-deco-circle"></div>
        <div class="rb-header-main">
          <div class="rb-avatar" id="rb-avatar"></div>
          <div class="rb-header-text">
            <div class="rb-eyebrow">(K)NEED</div>
            <div class="rb-heading" id="rb-heading"></div>
            <div class="rb-since" id="rb-since"></div>
          </div>
          <a href="/profile/edit" class="rb-edit-btn" aria-label="Edit profile">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </a>
        </div>
        <div class="rb-stats-row">
          <div class="rb-stat">
            <span class="rb-stat-num" id="rb-stat-saves">—</span>
            <span class="rb-stat-label">Saved</span>
          </div>
          <div class="rb-stat">
            <span class="rb-stat-num" id="rb-stat-ratings">—</span>
            <span class="rb-stat-label">Ratings</span>
          </div>
          <div class="rb-stat">
            <span class="rb-stat-num" id="rb-stat-comments">—</span>
            <span class="rb-stat-label">Comments</span>
          </div>
        </div>
      </div>

      <div class="rb-grid" id="rb-grid"></div>

      <div class="rb-empty" id="rb-empty" style="display:none">
        <p class="rb-empty-msg">Your recipe book is empty.</p>
        <a href="/bakeries" class="rb-empty-btn">Explore bakeries →</a>
      </div>

    </div>

  </main>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function starsHTML(rating: number): string {
    return Array.from({ length: 5 }, (_, i) =>
      `<span class="rb-card-star${i < rating ? ' filled' : ''}">★</span>`
    ).join('');
  }

  type CardItem = { href: string; slug: string; name: string; suburb: string; category: string; thumbnail: string };

  function cardHTML(item: CardItem, rating: number, delay: string): string {
    const stars = rating > 0 ? `<div class="rb-card-stars">${starsHTML(rating)}</div>` : '';
    return `<a href="${esc(item.href)}" class="rb-card" style="animation-delay:${delay}">
      <div class="rb-card-img-wrap">
        <img class="rb-card-img" src="${esc(item.thumbnail)}" alt="${esc(item.name)}" loading="lazy" />
        <div class="rb-card-badge">
          <svg viewBox="0 0 24 24" width="9" height="9" fill="var(--amber)" stroke="none"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        </div>
      </div>
      <div class="rb-card-body">
        <div class="rb-card-cat">${esc(item.category)}</div>
        <div class="rb-card-name">${esc(item.name)}</div>
        <div class="rb-card-footer">
          <span class="rb-card-suburb">${esc(item.suburb)}</span>
          ${stars}
        </div>
      </div>
    </a>`;
  }

  function addCardHTML(delay: string): string {
    return `<a href="/bakeries" class="rb-card-add" style="animation-delay:${delay}">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      <span class="rb-card-add-text">Explore bakeries</span>
    </a>`;
  }

  async function initProfile() {
    const skeletonEl = document.getElementById('rb-skeleton');
    const contentEl  = document.getElementById('rb-content');
    if (!contentEl) return;

    type SessionVal = Awaited<ReturnType<typeof supabase.auth.getSession>>['data']['session'];
    const session = await new Promise<SessionVal>((resolve) => {
      const { data: { subscription } } = supabase.auth.onAuthStateChange((event, sess) => {
        if (event === 'INITIAL_SESSION' || event === 'SIGNED_IN') {
          subscription.unsubscribe();
          resolve(sess);
        }
      });
    });
    if (!session) { window.location.href = '/auth/login'; return; }

    // Fetch all saves + profile + ratings + comment count in parallel
    const [profileRes, savesRes, ratingsRes, commentsRes] = await Promise.all([
      supabase.from('profiles').select('display_name').eq('id', session.user.id).maybeSingle(),
      supabase.from('saves').select('content_slug, content_type').eq('user_id', session.user.id).order('created_at', { ascending: false }),
      supabase.from('ratings').select('bakery_slug, rating').eq('user_id', session.user.id),
      supabase.from('comments').select('*', { count: 'exact', head: true }).eq('user_id', session.user.id).is('parent_comment_id', null),
    ]);

    const saves        = (savesRes.data    ?? []) as { content_slug: string; content_type: string }[];
    const ratings      = (ratingsRes.data  ?? []) as { bakery_slug: string; rating: number }[];
    const commentCount = (commentsRes as { count: number | null }).count ?? 0;

    const ratingsMap: Record<string, number> = {};
    for (const r of ratings) ratingsMap[r.bakery_slug] = r.rating;

    // Profile header
    const displayName = ((profileRes.data as { display_name: string | null } | null)?.display_name)
      || (session.user.user_metadata?.full_name as string | undefined)
      || session.user.email?.split('@')[0] || 'User';
    const firstName = displayName.trim().split(/\s+/)[0] || 'User';
    const initials  = displayName.trim().split(/\s+/).map((n: string) => n[0] || '').filter(Boolean).join('').slice(0, 2).toUpperCase() || '?';
    const memberSince = 'Member since ' + new Date(session.user.created_at).toLocaleDateString('en-AU', { month: 'long', year: 'numeric' });

    const avatarEl  = document.getElementById('rb-avatar');
    const headingEl = document.getElementById('rb-heading');
    const sinceEl   = document.getElementById('rb-since');
    if (avatarEl)  avatarEl.textContent  = initials;
    if (headingEl) headingEl.textContent = `${firstName}'s Recipe Book`;
    if (sinceEl)   sinceEl.textContent   = memberSince;

    // Stats — saves counts both bakeries and articles
    const statSaves    = document.getElementById('rb-stat-saves');
    const statRatings  = document.getElementById('rb-stat-ratings');
    const statComments = document.getElementById('rb-stat-comments');
    if (statSaves)    statSaves.textContent    = String(saves.length);
    if (statRatings)  statRatings.textContent  = String(ratings.length);
    if (statComments) statComments.textContent = String(commentCount);

    // Resolve metadata from Supabase for saved items
    const gridEl  = document.getElementById('rb-grid');
    const emptyEl = document.getElementById('rb-empty');

    if (gridEl && emptyEl) {
      const bakerySlugs  = saves.filter(s => s.content_type === 'bakery').map(s => s.content_slug);
      const articleSlugs = saves.filter(s => s.content_type === 'article').map(s => s.content_slug);

      type BakeryRow  = { slug: string; name: string; suburb: string | null; category: string; thumbnail: string };
      type ArticleRow = { slug: string; title: string; category: string; thumbnail: string };

      const [bakeryResult, articleResult] = await Promise.all([
        bakerySlugs.length > 0
          ? supabase.from('bakeries_cms').select('slug, name, suburb, category, thumbnail').in('slug', bakerySlugs)
          : Promise.resolve({ data: [] as BakeryRow[] }),
        articleSlugs.length > 0
          ? supabase.from('articles_cms').select('slug, title, category, thumbnail').in('slug', articleSlugs)
          : Promise.resolve({ data: [] as ArticleRow[] }),
      ]);

      const bakeryMetaMap  = Object.fromEntries(((bakeryResult.data  ?? []) as BakeryRow[]).map(b => [b.slug,  { href: `/bakeries/${b.slug}`,        slug: b.slug, name: b.name,    suburb: b.suburb ?? '',       category: b.category, thumbnail: b.thumbnail } satisfies CardItem]));
      const articleMetaMap = Object.fromEntries(((articleResult.data ?? []) as ArticleRow[]).map(a => [a.slug, { href: `/kneed-to-know/${a.slug}`,    slug: a.slug, name: a.title,   suburb: '(K)Need to Know',    category: a.category, thumbnail: a.thumbnail } satisfies CardItem]));

      // Preserve saves order (newest first)
      const items = saves
        .map(s => s.content_type === 'bakery' ? (bakeryMetaMap[s.content_slug] ?? null) : (articleMetaMap[s.content_slug] ?? null))
        .filter((item): item is CardItem => item !== null);

      if (items.length === 0) {
        emptyEl.style.display = '';
      } else {
        gridEl.innerHTML = items
          .map((item, i) => cardHTML(item, ratingsMap[item.slug] ?? 0, `${(i + 1) * 0.05}s`))
          .join('') + addCardHTML(`${(items.length + 1) * 0.05}s`);
      }
    }

    if (skeletonEl) skeletonEl.style.display = 'none';
    contentEl.style.display = '';
    requestAnimationFrame(() => {
      contentEl.style.transition = 'opacity 0.3s ease';
      contentEl.style.opacity = '1';
    });
  }

  document.addEventListener('astro:page-load', initProfile);
  initProfile();
</script>
