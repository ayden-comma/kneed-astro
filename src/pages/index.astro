<script is:inline>
  // HERO SLIDESHOW
  var HERO_SLIDES = JSON.parse(document.getElementById('hero-slides-data').textContent);

  function initHomePage() {
    // Idempotency guard: absorb the first-load double-fire (see where the flag is
    // set below). Cleared in destroyHomePage() so genuine SPA re-entry re-inits.
    if (window._heroInited) return;

    // Clear any hero timer left over from a previous visit
    if (window._heroTimer) { clearInterval(window._heroTimer); window._heroTimer = null; }

    // Fresh DOM refs on every call
    var bottomEl   = document.getElementById('hero-img-bg');
    var topEl      = document.getElementById('hero-img-next');
    var innerEl    = document.getElementById('hero-content-inner');
    var bgWordEl   = document.getElementById('hero-bg-word');
    var tagEl      = document.getElementById('hero-eyebrow-tag');
    var metaEl     = document.getElementById('hero-eyebrow-meta');
    var titleEl    = document.getElementById('hero-title');
    var bakeryEl   = document.getElementById('hero-bakery-line');
    var subtitleEl = document.getElementById('hero-subtitle');

    if (!bottomEl || !topEl) return; // not on homepage

    // Mark this DOM instance initialized. On first load init fires twice — the
    // module script's immediate tryInitHome() AND the astro:page-load listener
    // (which also fires on initial load). Without this guard the second run re-ran
    // initHero()'s reset+replay, snapping the Ken Burns zoom back to scale(1.0) and
    // replaying the reveal — the visible "bounce" — and also re-ran startAutoplay()
    // / applySlide(0) and re-bound the touch/wheel listeners. The flag is cleared in
    // destroyHomePage() (astro:before-swap), so a real SPA nav away-and-back still
    // re-inits. Mirrors the _navArmed teardown pattern in consent.ts.
    window._heroInited = true;

    var currentSlide = 0;
    var heroTransitioning = false;
    var activeIsTop = false;

    function applySlide(idx) {
      var s = HERO_SLIDES[idx];
      if (tagEl) tagEl.textContent = s.tag;
      if (metaEl) metaEl.textContent = 'Ep. ' + String(idx + 1).padStart(2, '0') + ' · Now Playing';
      if (titleEl) titleEl.textContent = s.title;
      if (bakeryEl) bakeryEl.textContent = s.bakery;
      if (subtitleEl) subtitleEl.textContent = s.subtitle;
      var ctaBtn = document.getElementById('hero-cta-btn');
      if (ctaBtn && s.slug) ctaBtn.href = s.slug;
      document.querySelectorAll('.bottom-dot').forEach(function(d, i) {
        d.classList.toggle('active', i === idx);
      });
    }

    function initHero() {
      if (!HERO_SLIDES.length) return;
      var first = HERO_SLIDES[0];
      // Reset any leftover state from a previous visit
      bottomEl.classList.remove('zooming');
      topEl.classList.remove('zooming');
      if (innerEl) innerEl.classList.remove('visible', 'fading');
      if (bgWordEl) bgWordEl.classList.remove('bg-visible', 'bg-fading');
      bottomEl.style.opacity = '1';
      topEl.style.opacity = '0';
      bottomEl.style.backgroundImage = "url('" + first.image + "')";
      applySlide(0);
      if (bgWordEl) bgWordEl.textContent = first.bgWord;
      setTimeout(function() {
        if (innerEl) innerEl.classList.add('visible');
        if (bgWordEl) setTimeout(function() { bgWordEl.classList.add('bg-visible'); }, 400);
        bottomEl.classList.add('zooming');
      }, 100);
    }

    function goToSlide(idx) {
      if (heroTransitioning || idx === currentSlide) return;
      heroTransitioning = true;
      var s = HERO_SLIDES[idx];
      var outgoingEl = activeIsTop ? topEl : bottomEl;
      var incomingEl = activeIsTop ? bottomEl : topEl;

      incomingEl.style.transition = 'none';
      incomingEl.style.opacity = '0';
      incomingEl.classList.remove('zooming');
      incomingEl.style.backgroundImage = "url('" + s.image + "')";
      void incomingEl.offsetHeight;

      if (innerEl) { innerEl.classList.remove('visible'); innerEl.classList.add('fading'); }

      if (!activeIsTop) {
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            incomingEl.style.transition = 'opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1)';
            incomingEl.style.opacity = '1';
            incomingEl.classList.add('zooming');
          });
        });
      } else {
        incomingEl.style.opacity = '1';
        incomingEl.classList.add('zooming');
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            outgoingEl.style.transition = 'opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1)';
            outgoingEl.style.opacity = '0';
          });
        });
      }

      if (bgWordEl) {
        bgWordEl.classList.add('bg-fading');
        bgWordEl.classList.remove('bg-visible');
        setTimeout(function() {
          bgWordEl.textContent = s.bgWord;
          bgWordEl.classList.remove('bg-fading');
          bgWordEl.classList.add('bg-visible');
        }, 700);
      }

      setTimeout(function() {
        applySlide(idx);
        if (innerEl) { innerEl.classList.remove('fading'); innerEl.classList.add('visible'); }
      }, 1200);

      setTimeout(function() {
        activeIsTop = !activeIsTop;
        outgoingEl.style.transition = 'none';
        outgoingEl.style.opacity = '0';
        outgoingEl.classList.remove('zooming');
        currentSlide = idx;
        heroTransitioning = false;
      }, 1600);
    }

    function startAutoplay() {
      if (window._heroTimer) clearInterval(window._heroTimer);
      window._heroTimer = setInterval(function() {
        goToSlide((currentSlide + 1) % HERO_SLIDES.length);
      }, 6000);
    }

    initHero();
    startAutoplay();

    // Hero click + swipe + trackpad wheel
    var heroSection = document.getElementById('hero-section');
    var _heroSwiped = false;
    if (heroSection) {
      heroSection.style.cursor = 'pointer';
      heroSection.onclick = function() {
        if (_heroSwiped) { _heroSwiped = false; return; }
        var s = HERO_SLIDES[currentSlide];
        if (s && s.slug) window.location.href = s.slug;
      };

      // ── Touch swipe ──────────────────────────────────────────
      var _hX = 0, _hY = 0, _hMoved = false;
      function _hTouchStart(e) {
        _hX = e.touches[0].clientX;
        _hY = e.touches[0].clientY;
        _hMoved = false;
        _heroSwiped = false;
      }
      function _hTouchMove(e) {
        var dx = e.touches[0].clientX - _hX;
        var dy = e.touches[0].clientY - _hY;
        if (Math.abs(dx) > 10) _hMoved = true;
        if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) e.preventDefault();
      }
      function _hTouchEnd(e) {
        var dx = e.changedTouches[0].clientX - _hX;
        var len = HERO_SLIDES.length;
        if (_hMoved && Math.abs(dx) > 40) {
          _heroSwiped = true;
          goToSlide(dx < 0 ? (currentSlide + 1) % len : (currentSlide - 1 + len) % len);
          startAutoplay();
        }
      }
      heroSection.addEventListener('touchstart', _hTouchStart, { passive: true });
      heroSection.addEventListener('touchmove',  _hTouchMove,  { passive: false });
      heroSection.addEventListener('touchend',   _hTouchEnd,   { passive: true });

      // ── Trackpad horizontal scroll ───────────────────────────
      var _hWheelLocked = false;
      function _hWheel(e) {
        var ax = Math.abs(e.deltaX), ay = Math.abs(e.deltaY);
        if (ax > ay && ax > 20) {
          e.preventDefault();
          if (_hWheelLocked) return;
          _hWheelLocked = true;
          var len = HERO_SLIDES.length;
          goToSlide(e.deltaX > 0 ? (currentSlide + 1) % len : (currentSlide - 1 + len) % len);
          startAutoplay();
          window._heroWheelCd = setTimeout(function() { _hWheelLocked = false; }, 600);
        }
        // vertical: fall through, page scrolls normally
      }
      heroSection.addEventListener('wheel', _hWheel, { passive: false });

      // Store refs for cleanup in destroyHomePage
      window._heroEvt = { el: heroSection, ts: _hTouchStart, tm: _hTouchMove, te: _hTouchEnd, wh: _hWheel };
    }

    // Dots — change slide
    document.querySelectorAll('.bottom-dot').forEach(function(dot) {
      dot.onclick = function(e) {
        e.stopPropagation();
        var idx = parseInt(this.dataset.slide, 10);
        goToSlide(idx);
        startAutoplay();
      };
    });

    // NEWSLETTER — submit handler lives in the module script below (needs supabase
    // for the real POST + session check). Close/join handlers stay here.

    // NEWSLETTER MODAL
    var nlModalOverlay = document.getElementById('nl-modal-overlay');
    var nlModalSkip = document.getElementById('nl-modal-skip');
    var nlModalJoin = document.getElementById('nl-modal-join');

    function closeNlModal() {
      var modal = document.getElementById('nl-modal');
      if (modal) {
        modal.style.display = 'none';
        var s1 = document.getElementById('nl-modal-s1');
        var s2 = document.getElementById('nl-modal-s2');
        if (s1) s1.style.display = '';
        if (s2) s2.style.display = 'none';
      }
    }

    if (nlModalOverlay) nlModalOverlay.onclick = closeNlModal;
    if (nlModalSkip) nlModalSkip.onclick = closeNlModal;
    if (nlModalJoin) {
      nlModalJoin.onclick = function(e) {
        e.preventDefault();
        var s1 = document.getElementById('nl-modal-s1');
        var s2 = document.getElementById('nl-modal-s2');
        if (s1) s1.style.display = 'none';
        if (s2) s2.style.display = '';
      };
    }

    // FILM RAIL LOOPING CAROUSEL
    (function() {
      var rail    = document.getElementById('film-rail');
      var prevBtn = document.getElementById('film-prev');
      var nextBtn = document.getElementById('film-next');
      if (!rail || !prevBtn || !nextBtn) return;
      if (rail.dataset.loopInit) return;
      rail.dataset.loopInit = '1';

      var originals = Array.from(rail.children);
      var N = originals.length;
      if (N === 0) return;

      // Prepend + append one full set of clones
      var pre = document.createDocumentFragment();
      var post = document.createDocumentFragment();
      originals.forEach(function(tile) {
        var a = tile.cloneNode(true);
        a.setAttribute('aria-hidden', 'true');
        a.setAttribute('tabindex', '-1');
        pre.appendChild(a);
        var b = tile.cloneNode(true);
        b.setAttribute('aria-hidden', 'true');
        b.setAttribute('tabindex', '-1');
        post.appendChild(b);
      });
      rail.insertBefore(pre, rail.firstChild);
      rail.appendChild(post);

      function getStep() {
        var tile = rail.children[N];
        var gap = parseFloat(getComputedStyle(rail).gap) || 16;
        return tile.offsetWidth + gap;
      }

      // Position scrollLeft so first REAL tile is in view
      function initPos() {
        var tile = rail.children[N];
        var isCenter = getComputedStyle(tile).scrollSnapAlign.includes('center');
        var off = isCenter ? Math.max(0, (rail.clientWidth - tile.offsetWidth) / 2) : 0;
        rail.scrollLeft = tile.offsetLeft - off;
      }
      initPos();

      // Loop reset: after scroll settles, jump instantly if in clone zone
      var _t = null;
      var _busy = false;
      function checkLoop() {
        if (_busy) return;
        var firstReal = rail.children[N];
        var lastReal  = rail.children[2 * N - 1];
        var step = getStep();
        var lo = firstReal.offsetLeft - step / 2;
        var hi = lastReal.offsetLeft  + step / 2;
        if (rail.scrollLeft < lo) {
          _busy = true;
          rail.scrollLeft += N * step;
          requestAnimationFrame(function() { requestAnimationFrame(function() { _busy = false; }); });
        } else if (rail.scrollLeft > hi) {
          _busy = true;
          rail.scrollLeft -= N * step;
          requestAnimationFrame(function() { requestAnimationFrame(function() { _busy = false; }); });
        }
      }

      rail.addEventListener('scroll', function() {
        if (_busy) return;
        clearTimeout(_t);
        _t = setTimeout(checkLoop, 150);
      }, { passive: true });

      prevBtn.onclick = function() { rail.scrollBy({ left: -getStep(), behavior: 'smooth' }); };
      nextBtn.onclick = function() { rail.scrollBy({ left:  getStep(), behavior: 'smooth' }); };
    })();

  }

  function destroyHomePage() {
    window._heroInited = false; // re-arm init for a genuine SPA re-entry to home
    if (window._heroTimer) { clearInterval(window._heroTimer); window._heroTimer = null; }
    clearTimeout(window._heroWheelCd); window._heroWheelCd = null;
    if (window._heroEvt) {
      var ev = window._heroEvt;
      ev.el.removeEventListener('touchstart', ev.ts);
      ev.el.removeEventListener('touchmove',  ev.tm);
      ev.el.removeEventListener('touchend',   ev.te);
      ev.el.removeEventListener('wheel',      ev.wh);
      window._heroEvt = null;
    }
  }

  // Expose so the module script below can call these on astro:page-load /
  // astro:before-swap without relying on registerPageInit timing.
  window.__kneedInitHome    = initHomePage;
  window.__kneedDestroyHome = destroyHomePage;
</script>

<script>
  import { supabase } from '../lib/supabase';

  function tryInitHome() {
    if (!document.getElementById('hero-section')) return;
    const fn = (window as any).__kneedInitHome;
    if (typeof fn === 'function') fn();
  }

  function initModalAuth() {
    if (!document.getElementById('nl-modal')) return;
    const googleBtn = document.getElementById('nl-modal-google') as HTMLButtonElement | null;
    const signupBtn = document.getElementById('nl-modal-create') as HTMLButtonElement | null;
    const errorEl   = document.getElementById('nl-modal-err')    as HTMLElement | null;
    const emailEl   = document.getElementById('nl-modal-email')  as HTMLInputElement | null;
    const pwEl      = document.getElementById('nl-modal-pw')     as HTMLInputElement | null;

    if (googleBtn) googleBtn.onclick = async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + '/auth/callback' }
      });
      if (error && errorEl) errorEl.textContent = error.message;
    };

    async function doSignup() {
      const email    = emailEl?.value.trim() ?? '';
      const password = pwEl?.value ?? '';
      if (errorEl) errorEl.textContent = '';
      if (!email || !password) { if (errorEl) errorEl.textContent = 'Please fill in all fields.'; return; }
      if (password.length < 6) { if (errorEl) errorEl.textContent = 'Password must be at least 6 characters.'; return; }
      if (signupBtn) { signupBtn.disabled = true; signupBtn.textContent = 'Creating account…'; }
      const { data, error } = await supabase.auth.signUp({ email, password });
      if (error) {
        if (errorEl) errorEl.textContent = error.message;
        if (signupBtn) { signupBtn.disabled = false; signupBtn.textContent = 'Create account'; }
      } else {
        // Mailing-list opt-in — never blocks account creation. Email already reached
        // email_subscribers via the homepage form (consent_source 'homepage_form') when
        // this modal opened, so this signup_checkbox call typically returns already:true
        // and does not re-link user_id (see HANDOFF). Google OAuth not covered (redirects).
        const optin = document.getElementById('nl-modal-optin') as HTMLInputElement | null;
        if (optin?.checked) {
          try {
            await fetch('/api/newsletter-signup', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                ...(data.session?.access_token ? { Authorization: `Bearer ${data.session.access_token}` } : {}),
              },
              body: JSON.stringify({ email, consent_source: 'signup_checkbox' }),
            });
          } catch (e) { console.error('[nl-modal] opt-in subscribe failed (non-blocking):', e); }
        }
        if (errorEl) { errorEl.style.color = 'var(--amber)'; errorEl.textContent = 'Check your email to confirm your account.'; }
        if (signupBtn) { signupBtn.disabled = true; signupBtn.textContent = 'Email sent'; }
      }
    }

    if (signupBtn) signupBtn.onclick = doSignup;
    if (pwEl) pwEl.onkeydown = (e) => { if (e.key === 'Enter') doSignup(); };
  }

  function initNewsletter() {
    const nlBtn   = document.getElementById('nl-btn')   as HTMLButtonElement | null;
    const nlEmail = document.getElementById('nl-email') as HTMLInputElement | null;
    const nlError = document.getElementById('nl-error') as HTMLElement | null;
    if (!nlBtn || !nlEmail) return;

    const showError = (msg: string) => {
      nlEmail.style.borderColor = '#c0392b';
      if (nlError) { nlError.textContent = msg; nlError.style.display = 'block'; }
    };
    const clearError = () => {
      nlEmail.style.borderColor = '';
      if (nlError) { nlError.textContent = ''; nlError.style.display = 'none'; }
    };

    function openModal(email: string, loggedIn: boolean) {
      const modal = document.getElementById('nl-modal');
      if (!modal) return;
      const modalEmail = document.getElementById('nl-modal-email') as HTMLInputElement | null;
      if (modalEmail) modalEmail.value = email;
      // Reset to the confirmation step.
      const s1 = document.getElementById('nl-modal-s1');
      const s2 = document.getElementById('nl-modal-s2');
      if (s1) s1.style.display = '';
      if (s2) s2.style.display = 'none';
      // Signed-in users already have an account: skip the account-creation prompt.
      const question = modal.querySelector('.nl-modal-question') as HTMLElement | null;
      const join     = document.getElementById('nl-modal-join') as HTMLElement | null;
      if (question) question.style.display = loggedIn ? 'none' : '';
      if (join)     join.style.display     = loggedIn ? 'none' : '';
      modal.style.display = 'flex';
    }

    nlBtn.onclick = async () => {
      const email = nlEmail.value.trim();
      clearError();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Please enter a valid email address.');
        return;
      }
      const original = nlBtn.textContent;
      nlBtn.disabled = true;
      nlBtn.textContent = 'Signing up…';
      try {
        const res = await fetch('/api/newsletter-signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, consent_source: 'homepage_form' }),
        });
        const data = await res.json().catch(() => ({})) as { error?: string };
        if (!res.ok) {
          showError(data.error || 'Something went wrong. Please try again.');
          return;
        }
        let loggedIn = false;
        try {
          const { data: { session } } = await supabase.auth.getSession();
          loggedIn = !!session;
        } catch { /* treat as logged-out on failure */ }
        openModal(email, loggedIn);
      } catch {
        showError('Network error. Please try again.');
      } finally {
        nlBtn.disabled = false;
        nlBtn.textContent = original;
      }
    };
  }

  document.addEventListener('astro:before-swap', function() {
    const fn = (window as any).__kneedDestroyHome;
    if (typeof fn === 'function') fn();
  });

  document.addEventListener('astro:page-load', function() {
    tryInitHome();
    initModalAuth();
    initNewsletter();
  });

  tryInitHome();
  initModalAuth();
  initNewsletter();
</script>