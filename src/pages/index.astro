<style>
/* ── HERO ───────────────────────────────────────────────────── */
.hero-section {
  position: relative;
  width: 100%;
  height: 92vh;
  min-height: 580px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
@media (max-width: 640px) {
  .hero-section { min-height: 480px; }
}
.hero-img-bg, .hero-img-next {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center 30%;
  pointer-events: none;
  will-change: transform, opacity;
}
.hero-img-next { opacity: 0; }
@keyframes heroZoom {
  from { transform: scale(1.0); }
  to   { transform: scale(1.08); }
}
.hero-img-bg.zooming, .hero-img-next.zooming {
  animation: heroZoom 22s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}
.hero-grade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(14,12,10,0.92) 0%, rgba(14,12,10,0.4) 45%, transparent 100%);
}
.hero-text-scrim {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 80% 60% at 50% 60%, rgba(14,12,10,0.5) 0%, transparent 70%);
}
.hero-tone {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 70% 40%, rgba(200,131,58,0.08) 0%, transparent 70%);
}
.hero-bg-word {
  position: absolute;
  top: 42%;
  left: 0;
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(12rem, 26vw, 32rem);
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: transparent;
  -webkit-text-stroke: 2px rgba(242,237,230,0.11);
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  user-select: none;
  opacity: 0;
  z-index: 1;
  transition: opacity 0.7s ease;
  animation: bgWordDrift 45s linear 0.3s infinite alternate;
}
.hero-bg-word.bg-visible { opacity: 1; }
.hero-bg-word.bg-fading { opacity: 0; transition: opacity 0.4s ease; }
@keyframes bgWordDrift {
  0%   { transform: translateY(-50%) translateX(6%); }
  100% { transform: translateY(-50%) translateX(-22%); }
}
.hero-ticker-wrap {
  position: absolute;
  top: clamp(2rem, 6vw, 4rem);
  left: 0;
  right: 0;
  overflow: hidden;
  z-index: 2;
  opacity: 0.5;
}
.hero-ticker {
  display: flex;
  white-space: nowrap;
  animation: tickerScroll 40s linear infinite;
  font-family: var(--font-cond);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--p-50);
}
.hero-ticker-item {
  flex-shrink: 0;
}
@keyframes tickerScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.hero-content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--px) clamp(5rem, 10vw, 8rem);
}
.hero-content-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 50rem;
  margin: 0 auto;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.hero-content-inner.visible {
  opacity: 1;
  transform: translateY(0);
}
.hero-content-inner.fading {
  opacity: 0;
  transform: translateY(-8px);
}
.hero-eyebrow-row {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 1rem;
}
.eyebrow-dot {
  width: 6px;
  height: 6px;
