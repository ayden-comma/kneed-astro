---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const bakeries = await getCollection('bakeries');
const kneedToKnow = await getCollection('kneedToKnow');
---

<BaseLayout title="Home" description="(K)Need — a cinematic exploration of Melbourne's best bakeries.">
  <main>

    <!-- CINEMATIC HERO -->
    <section class="hero-section" id="hero-section">
      <div class="hero-img-bg" id="hero-img-bg"></div>
      <div class="hero-img-next" id="hero-img-next"></div>
      <div class="hero-grade"></div>
      <div class="hero-text-scrim"></div>
      <div class="hero-tone"></div>

      <div class="hero-bg-word" id="hero-bg-word">KNEAD</div>

      <div class="hero-ticker-wrap">
        <div class="hero-ticker">
          <span class="hero-ticker-item">Sourdough &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Fermentation &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Melbourne Bakeries &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Craft Bread &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Documentary &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Stone Milled &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Sourdough &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Fermentation &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Melbourne Bakeries &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Craft Bread &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Documentary &nbsp;·&nbsp; </span>
          <span class="hero-ticker-item">Stone Milled &nbsp;·&nbsp; </span>
        </div>
      </div>

      <div class="hero-content">
        <div class="hero-content-inner" id="hero-content-inner">
          <div class="hero-eyebrow-row">
            <span class="eyebrow-dot"></span>
            <span class="eyebrow-tag" id="hero-eyebrow-tag">Sourdough</span>
            <span class="eyebrow-rule"></span>
            <span class="eyebrow-meta" id="hero-eyebrow-meta">Now Playing · Ep. 01</span>
          </div>
          <h1 class="hero-title" id="hero-title"></h1>
          <span class="hero-bakery-line" id="hero-bakery-line"></span>
          <p class="hero-subtitle" id="hero-subtitle"></p>
          <div class="hero-cta-row">
<a href="/bakeries" class="wf-pill pill-dark" id="hero-cta-btn">
              <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><polygon points="6,4 20,12 6,20"/></svg>
              Watch Now
            </a>
          </div>
        </div>
      </div>

      <div class="hero-bottom-bar">
        <div class="bottom-dots" id="hero-dots">
          <button class="bottom-dot active" data-slide="0" aria-label="Slide 1"></button>
          <button class="bottom-dot" data-slide="1" aria-label="Slide 2"></button>
          <button class="bottom-dot" data-slide="2" aria-label="Slide 3"></button>
          <button class="bottom-dot" data-slide="3" aria-label="Slide 4"></button>
          <button class="bottom-dot" data-slide="4" aria-label="Slide 5"></button>
        </div>
      </div>
    </section>

<!-- MEET THE BAKERS -->
    <section class="wf-container mt-section">
      <div class="wf-section-head">
        <div>
          <div class="wf-eyebrow">New Episodes</div>
          <h2>Meet the Bakers</h2>
        </div>
        <div style="display:flex; align-items:center; gap:1rem;">
          <div class="film-nav">
            <button class="film-nav-btn" id="film-prev" aria-label="Previous">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button class="film-nav-btn" id="film-next" aria-label="Next">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
          <a href="/bakeries" class="see-all-btn">
            See all
            <span class="arrow-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </span>
          </a>
        </div>
      </div>
      <div style="margin-top: clamp(0.75rem,1.5vw,1.25rem);">
        <div class="film-rail-wrap">
          <div class="film-rail" id="film-rail">
{bakeries.map((bakery) => (
              <a href={'/bakeries/' + bakery.data.slug} class="film-card film-card-side">
                <img class="film-card-img" src={bakery.data.thumbnail} alt={bakery.data.name} loading="lazy" />
                <div class="film-card-grade"></div>
                {bakery.data.duration && <div class="film-card-dur">{bakery.data.duration}</div>}
                <div class="film-card-body">
                  <div class="film-card-tag">{bakery.data.category}</div>
                  <div class="film-card-title">{bakery.data.name}</div>
                  <div class="film-card-bakery">{bakery.data.suburb}</div>
                </div>
                <div class="film-card-play">
                  <svg viewBox="0 0 24 24"><polygon points="6,4 20,12 6,20"/></svg>
                </div>
                <div class="film-card-accent"></div>
              </a>
            ))}        
            </div>
          </div>
      </div>
    </section>

    <!-- STORIES -->
    <section class="wf-container mt-section">
      <div class="wf-section-head">
        <div>
          <div class="wf-eyebrow">Latest</div>
          <h2>(K)Need to Know</h2>
        </div>
        <a href="/kneed-to-know" class="see-all-btn">
          See all
          <span class="arrow-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>
      <div class="home-grid">
        {kneedToKnow.slice(0, 3).map((story) => (
          <a href={'/kneed-to-know/' + story.data.slug} class="film-card">
            <img class="film-card-img" src={story.data.thumbnail} alt={story.data.name} loading="lazy" />
            <div class="film-card-grade"></div>
            <div class="film-card-dur">{story.data.duration}</div>
            <div class="film-card-body">
              <div class="film-card-tag">{story.data.category}</div>
              <div class="film-card-title">{story.data.name}</div>
              <div class="film-card-bakery">{story.data.suburb}</div>
            </div>
            <div class="film-card-play">
              <svg viewBox="0 0 24 24"><polygon points="6,4 20,12 6,20"/></svg>
            </div>
            <div class="film-card-accent"></div>
          </a>
        ))}
      </div>
    </section>

    <!-- MAP TEASER + NEWSLETTER -->
    <section class="wf-container mt-section" style="padding-bottom: clamp(2rem,4vw,3rem);">
      <div class="two-card-row">

        <!-- MAP CARD -->
        <a href="/map" class="map-card">
          <img src="/images/map-preview.jpg" alt="Melbourne bakery map" class="map-card-img" />
          <div class="map-card-overlay"></div>
          <div class="map-card-top">
            <div class="map-card-eyebrow">Find Good Bread</div>
            <div class="map-card-title">MELBOURNE'S BEST BREAD</div>
            <div class="map-card-ghost">Explore the map →</div>
          </div>
        </a>

        <!-- NEWSLETTER CARD -->
        <div class="nl-card">
          <img src="https://images.unsplash.com/photo-1613396874083-2d5fbe59ae79?q=80&w=1319&auto=format&fit=crop" alt="" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.18;z-index:0;" loading="lazy" />
          <div style="position:absolute;inset:0;background:rgba(14,12,10,0.75);z-index:1;"></div>
          <div style="position:relative;z-index:2;">
            <div class="nl-eyebrow">Stay in the know</div>
            <h2 class="nl-title">Good bread is worth<br/>knowing about.</h2>
            <p class="nl-sub">New bakery films, the stories behind the bakers, and places worth visiting — straight to your inbox.</p>
          </div>
          <div class="nl-form" style="position:relative;z-index:2;">
            <input type="email" id="nl-email" placeholder="Your email address" class="nl-input" />
            <button class="nl-btn" id="nl-btn">Get updates</button>
          </div>
        </div>

      </div>
    </section>

  <!-- NEWSLETTER MODAL -->
  <div id="nl-modal" class="nl-modal" style="display:none;" aria-modal="true" role="dialog">
    <div class="nl-modal-overlay" id="nl-modal-overlay"></div>
    <div class="nl-modal-card">
      <button id="nl-modal-skip" class="nl-modal-close" aria-label="Close">×</button>
      <div id="nl-modal-s1">
        <div class="nl-modal-check">YOU'RE ON THE LIST!</div>
        <p class="nl-modal-question">Want to save bakeries and join the discussion?</p>
        <a id="nl-modal-join" href="#" class="nl-modal-join">Create a free account</a>
      </div>
      <div id="nl-modal-s2" style="display:none;">
        <div class="auth-card-logo">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 179.04 38.1" style="height:2rem;width:auto;"><defs><style>.as-fill{fill:currentColor;}</style></defs><g><path class="as-fill" d="M9.45,13.44c.48-1.74,1.1-3.29,1.86-4.67.76-1.37,1.56-2.5,2.4-3.41l.57.81c-.76.88-1.49,1.97-2.19,3.26-.7,1.29-1.27,2.74-1.69,4.36-.43,1.62-.65,3.38-.65,5.28s.21,3.63.65,5.25c.43,1.62.99,3.07,1.69,4.35.7,1.28,1.43,2.36,2.19,3.24l-.57.81c-.84-.88-1.64-2.01-2.4-3.38-.76-1.37-1.38-2.93-1.86-4.67-.48-1.74-.72-3.62-.72-5.64s.24-3.87.72-5.61Z"/><path class="as-fill" d="M47.76,24.69c-.48,1.74-1.1,3.29-1.85,4.67-.75,1.37-1.54,2.49-2.38,3.38l-.6-.81c.78-.88,1.52-1.96,2.21-3.24.69-1.28,1.25-2.73,1.68-4.35.43-1.62.65-3.37.65-5.25s-.21-3.66-.65-5.28-.99-3.07-1.68-4.35c-.69-1.28-1.43-2.36-2.21-3.24l.6-.84c.84.9,1.63,2.04,2.38,3.41.75,1.37,1.37,2.92,1.85,4.67.48,1.74.72,3.62.72,5.64s-.24,3.87-.72,5.61Z"/></g><g><path class="as-fill" d="M81.9,30.11l-16.8-19.65.27-.3.03,19.5h-1.02V8.09h.06l16.89,19.83-.36.06V8.48h.96v21.63h-.03Z"/><path class="as-fill" d="M97.89,8.48h12.84v.99h-11.82v9.03h10.65v.96h-10.65v9.21h12.24v.99h-13.26V8.48Z"/><path class="as-fill" d="M125.94,8.48h12.84v.99h-11.82v9.03h10.65v.96h-10.65v9.21h12.24v.99h-13.26V8.48Z"/><path class="as-fill" d="M153.99,29.66V8.48h5.04c2.02,0,3.75.33,5.19.98,1.44.65,2.6,1.5,3.5,2.55.89,1.05,1.54,2.2,1.96,3.45s.63,2.49.63,3.71c0,1.6-.28,3.04-.84,4.33-.56,1.29-1.32,2.4-2.28,3.31-.96.92-2.05,1.63-3.29,2.12-1.23.49-2.52.74-3.88.74h-6.03ZM155.01,28.67h4.68c1.32,0,2.56-.22,3.72-.66,1.16-.44,2.17-1.07,3.04-1.91.87-.83,1.55-1.83,2.05-3.01.5-1.18.75-2.51.75-3.99,0-1.18-.2-2.34-.6-3.48-.4-1.14-1.02-2.17-1.85-3.11-.83-.93-1.89-1.67-3.18-2.21s-2.82-.81-4.58-.81h-4.05v19.17Z"/></g><g><path class="as-fill" d="M23.46,18.35l-.06,1.02v-.18l11.04-10.71h1.32l-8.76,8.55,9.9,12.63h-1.29l-9.39-11.97-2.79,2.67.03,9.3h-1.05V8.48h1.05v9.87Z"/></g></svg>
        </div>
        <div id="nl-modal-err" class="auth-error"></div>
        <button id="nl-modal-google" class="auth-google-btn" type="button">
          <svg viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Continue with Google
        </button>
        <div class="auth-or"><span>or</span></div>
        <div class="auth-field">
          <label class="auth-label" for="nl-modal-email">Email</label>
          <input class="auth-input" type="email" id="nl-modal-email" placeholder="your@email.com" autocomplete="email" />
        </div>
        <div class="auth-field">
          <label class="auth-label" for="nl-modal-pw">Password</label>
          <input class="auth-input" type="password" id="nl-modal-pw" placeholder="••••••••" autocomplete="new-password" />
        </div>
        <button id="nl-modal-create" class="auth-submit" type="button">Create account</button>
        <div class="auth-footer">Already have an account? <a href="/auth/login">Sign in</a></div>
      </div>
    </div>
  </div>

  </main>
</BaseLayout>

<style>
/* ── HERO ───────────────────────────────────────────────────── */
.hero-section {
  position: relative;
  width: 100%;
  height: 92vh;
  min-height: 580px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
@media (max-width: 640px) {
  .hero-section { min-height: 480px; }
}
.hero-img-bg, .hero-img-next {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center 30%;
  pointer-events: none;
  will-change: transform, opacity;
}
.hero-img-next { opacity: 0; }
@keyframes heroZoom {
  from { transform: scale(1.0); }
  to   { transform: scale(1.08); }
}
.hero-img-bg.zooming, .hero-img-next.zooming {
  animation: heroZoom 22s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}
.hero-grade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(14,12,10,0.92) 0%, rgba(14,12,10,0.4) 45%, transparent 100%);
}
.hero-text-scrim {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 80% 60% at 50% 60%, rgba(14,12,10,0.5) 0%, transparent 70%);
}
.hero-tone {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 70% 40%, rgba(200,131,58,0.08) 0%, transparent 70%);
}
.hero-bg-word {
  position: absolute;
  top: 42%;
  left: 0;
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(12rem, 26vw, 32rem);
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: transparent;
  -webkit-text-stroke: 2px rgba(242,237,230,0.11);
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  user-select: none;
  opacity: 0;
  z-index: 1;
  transition: opacity 0.7s ease;
  animation: bgWordDrift 45s linear 0.3s infinite alternate;
}
.hero-bg-word.bg-visible { opacity: 1; }
.hero-bg-word.bg-fading { opacity: 0; transition: opacity 0.4s ease; }
@keyframes bgWordDrift {
  0%   { transform: translateY(-50%) translateX(6%); }
  100% { transform: translateY(-50%) translateX(-22%); }
}
.hero-ticker-wrap {
  position: absolute;
  top: clamp(2rem, 6vw, 4rem);
  left: 0;
  right: 0;
  overflow: hidden;
  z-index: 2;
  opacity: 0.5;
}
.hero-ticker {
  display: flex;
  white-space: nowrap;
  animation: tickerScroll 40s linear infinite;
  font-family: var(--font-cond);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--p-50);
}
.hero-ticker-item {
  flex-shrink: 0;
}
@keyframes tickerScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.hero-content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--px) clamp(5rem, 10vw, 8rem);
}
.hero-content-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 50rem;
  margin: 0 auto;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.hero-content-inner.visible {
  opacity: 1;
  transform: translateY(0);
}
.hero-content-inner.fading {
  opacity: 0;
  transform: translateY(-8px);
}
.hero-eyebrow-row {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 1rem;
}
.eyebrow-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--amber);
  flex-shrink: 0;
}
.eyebrow-tag {
  font-family: var(--font-cond);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--amber);
}
.eyebrow-rule {
  width: 2rem;
  height: 1px;
  background: var(--p-35);
}
.eyebrow-meta {
  font-family: var(--font-cond);
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--p-50);
}
.hero-title {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(2.25rem, 6vw, 5rem);
  letter-spacing: 0.02em;
  line-height: 1.05;
  color: var(--parchment);
  text-transform: uppercase;
}
.hero-bakery-line {
  display: block;
  margin-top: 0.875rem;
  font-family: var(--font-display);
  font-weight: 200;
  font-size: clamp(1.1rem, 2.5vw, 1.75rem);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--amber);
}
.hero-subtitle {
  margin-top: 1.5rem;
  font-size: clamp(0.95rem, 1.3vw, 1.05rem);
  line-height: 1.7;
  font-weight: 300;
  color: var(--p-70);
  max-width: 38rem;
}
.hero-cta-row {
  margin-top: 2rem;
}
.hero-bottom-bar {
  position: absolute;
  bottom: 2rem;
  left: 0;
  right: 0;
  z-index: 4;
  display: flex;
  justify-content: center;
}
.bottom-dots {
  display: flex;
  gap: 0.5rem;
}
.bottom-dot {
  width: 28px;
  height: 3px;
  border-radius: 2px;
  background: rgba(242,237,230,0.25);
  border: none;
  cursor: pointer;
  transition: background 0.25s, width 0.25s;
  padding: 0;
}
.bottom-dot:hover { background: rgba(242,237,230,0.5); }
.bottom-dot.active {
  background: var(--amber);
  width: 40px;
}

/* ── GRIDS ──────────────────────────────────────────────────── */
.home-grid {
  display: grid;
  gap: 1.125rem;
  grid-template-columns: 1fr;
}
@media (min-width: 600px) { .home-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 900px) { .home-grid { grid-template-columns: repeat(3, 1fr); } }

/* ── FILM CARDS ─────────────────────────────────────────────── */
.film-card {
  position: relative;
  display: block;
  border-radius: var(--r-card);
  overflow: hidden;
  border: 1px solid var(--border);
  cursor: pointer;
  transition: border-color 0.22s, transform 0.25s var(--ease-out);
}
.film-card:hover { border-color: var(--border-md); transform: translateY(-4px); }
.home-grid .film-card { aspect-ratio: 16/10; }
.film-card-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.72) saturate(0.85);
  transition: filter 0.4s, transform 0.6s var(--ease-out);
  display: block;
}
.film-card:hover .film-card-img { filter: brightness(0.88) saturate(1); transform: scale(1.04); }
.film-card-grade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(14,12,10,0.94) 0%, rgba(14,12,10,0.28) 45%, transparent 100%);
  pointer-events: none;
}
.film-card-dur {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  font-family: var(--font-cond);
  font-size: 0.6rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  background: rgba(14,12,10,0.72);
  color: var(--p-70);
  padding: 0.22rem 0.55rem;
  border-radius: var(--r-pill);
  border: 1px solid var(--border);
  backdrop-filter: blur(6px);
}
.film-card-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.film-card-tag {
  font-family: var(--font-cond);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--amber);
}
.film-card-title {
  font-family: var(--font-display);
  font-weight: 200;
  font-size: clamp(0.95rem, 1.8vw, 1.35rem);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--parchment);
  line-height: 1.25;
}
.film-card-bakery {
  font-family: var(--font-display);
  font-weight: 100;
  font-size: clamp(0.7rem, 1vw, 0.85rem);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--p-35);
  margin-top: 0.15rem;
}
.film-card-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  background: rgba(242,237,230,0.08);
  border: 1px solid rgba(242,237,230,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.25s, transform 0.25s var(--ease-out);
  pointer-events: none;
}
.film-card-play svg { width: 1rem; height: 1rem; fill: #fff; margin-left: 0.12em; }
.film-card:hover .film-card-play { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
.film-card-accent {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 2px;
  width: 0;
  background: var(--amber);
  transition: width 0.5s var(--ease-out);
}
.film-card:hover .film-card-accent { width: 100%; }

/* ── FILM RAIL ──────────────────────────────────────────────── */
.film-rail-wrap {
  position: relative;
}
.film-rail {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 2px;
}
.film-rail::-webkit-scrollbar { display: none; }
.film-card-main {
  flex: 0 0 clamp(320px, 52vw, 680px);
  scroll-snap-align: start;
  aspect-ratio: 4/3;
}
.film-card-side {
  flex: 0 0 280px;
  width: 280px;
  scroll-snap-align: start;
  aspect-ratio: 3/4;
}

</style>

<script is:inline>
  // HERO SLIDESHOW
  var HERO_SLIDES = [
    {
      tag: 'Sourdough',
      title: 'Country Sourdough Loaf',
      bakery: 'Tivoli Road Bakery',
      subtitle: "South Yarra's most enduring sourdough — a country-style loaf built on a 14-year-old starter and stone-milled Victorian wheat.",
      image: 'https://images.pexels.com/photos/36445170/pexels-photo-36445170.jpeg?auto=compress&cs=tinysrgb&w=1920',
      bgWord: 'COUNTRY',
      slug: '/bakeries/tivoli-road-bakery'
    },
    {
      tag: 'Pastry',
      title: 'The Twice-Baked Croissant',
      bakery: 'Lune Croissanterie',
      subtitle: 'A scientific obsession with laminated dough — hundreds of paper-thin layers built one fold at a time.',
      image: 'https://images.pexels.com/photos/2245295/pexels-photo-2245295.jpeg?auto=compress&cs=tinysrgb&w=1920',
      bgWord: 'CROISSANT',
      slug: '/bakeries/lune-croissanterie'
    },
    {
      tag: 'Sourdough',
      title: 'Stone-Milled Loaves',
      bakery: 'Baker Bleu',
      subtitle: 'A neighbourhood sourdough built on Australian-grown grain and slow overnight fermentation.',
      image: 'https://images.pexels.com/photos/7447297/pexels-photo-7447297.jpeg?auto=compress&cs=tinysrgb&w=1920',
      bgWord: 'STONE',
      slug: '/bakeries/baker-bleu'
    },
    {
      tag: 'Oat Bread',
      title: 'Oat Porridge Loaf',
      bakery: 'Falco Bakery',
      subtitle: 'A distinctive Smith Street loaf folded with fermented oats and cooked porridge for a custard-soft crumb.',
      image: 'https://images.pexels.com/photos/263168/pexels-photo-263168.jpeg?auto=compress&cs=tinysrgb&w=1920',
      bgWord: 'OAT',
      slug: '/bakeries/falco-bakery'
    },
    {
      tag: 'Focaccia',
      title: 'Focaccia with Rosemary',
      bakery: 'To Be Frank',
      subtitle: 'Organic wheat, Frattali olive oil, rosemary and sea salt — out of the oven at 10am, not before.',
      image: 'https://images.pexels.com/photos/30666809/pexels-photo-30666809.jpeg?auto=compress&cs=tinysrgb&w=1920',
      bgWord: 'FOCACCIA',
      slug: '/bakeries/to-be-frank'
    }
  ];

  function initHomePage() {
    // Clear any hero timer left over from a previous visit
    if (window._heroTimer) { clearInterval(window._heroTimer); window._heroTimer = null; }

    // Fresh DOM refs on every call
    var bottomEl   = document.getElementById('hero-img-bg');
    var topEl      = document.getElementById('hero-img-next');
    var innerEl    = document.getElementById('hero-content-inner');
    var bgWordEl   = document.getElementById('hero-bg-word');
    var tagEl      = document.getElementById('hero-eyebrow-tag');
    var metaEl     = document.getElementById('hero-eyebrow-meta');
    var titleEl    = document.getElementById('hero-title');
    var bakeryEl   = document.getElementById('hero-bakery-line');
    var subtitleEl = document.getElementById('hero-subtitle');

    if (!bottomEl || !topEl) return; // not on homepage

    var currentSlide = 0;
    var heroTransitioning = false;
    var activeIsTop = false;

    function applySlide(idx) {
      var s = HERO_SLIDES[idx];
      if (tagEl) tagEl.textContent = s.tag;
      if (metaEl) metaEl.textContent = 'Ep. ' + String(idx + 1).padStart(2, '0') + ' · Now Playing';
      if (titleEl) titleEl.textContent = s.title;
      if (bakeryEl) bakeryEl.textContent = s.bakery;
      if (subtitleEl) subtitleEl.textContent = s.subtitle;
      var ctaBtn = document.getElementById('hero-cta-btn');
      if (ctaBtn && s.slug) ctaBtn.href = s.slug;
      document.querySelectorAll('.bottom-dot').forEach(function(d, i) {
        d.classList.toggle('active', i === idx);
      });
    }

    function initHero() {
      if (!HERO_SLIDES.length) return;
      var first = HERO_SLIDES[0];
      // Reset any leftover state from a previous visit
      bottomEl.classList.remove('zooming');
      topEl.classList.remove('zooming');
      if (innerEl) innerEl.classList.remove('visible', 'fading');
      if (bgWordEl) bgWordEl.classList.remove('bg-visible', 'bg-fading');
      bottomEl.style.opacity = '1';
      topEl.style.opacity = '0';
      bottomEl.style.backgroundImage = "url('" + first.image + "')";
      applySlide(0);
      if (bgWordEl) bgWordEl.textContent = first.bgWord;
      setTimeout(function() {
        if (innerEl) innerEl.classList.add('visible');
        if (bgWordEl) setTimeout(function() { bgWordEl.classList.add('bg-visible'); }, 400);
        bottomEl.classList.add('zooming');
      }, 100);
    }

    function goToSlide(idx) {
      if (heroTransitioning || idx === currentSlide) return;
      heroTransitioning = true;
      var s = HERO_SLIDES[idx];
      var outgoingEl = activeIsTop ? topEl : bottomEl;
      var incomingEl = activeIsTop ? bottomEl : topEl;

      incomingEl.style.transition = 'none';
      incomingEl.style.opacity = '0';
      incomingEl.classList.remove('zooming');
      incomingEl.style.backgroundImage = "url('" + s.image + "')";
      void incomingEl.offsetHeight;

      if (innerEl) { innerEl.classList.remove('visible'); innerEl.classList.add('fading'); }

      if (!activeIsTop) {
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            incomingEl.style.transition = 'opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1)';
            incomingEl.style.opacity = '1';
            incomingEl.classList.add('zooming');
          });
        });
      } else {
        incomingEl.style.opacity = '1';
        incomingEl.classList.add('zooming');
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            outgoingEl.style.transition = 'opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1)';
            outgoingEl.style.opacity = '0';
          });
        });
      }

      if (bgWordEl) {
        bgWordEl.classList.add('bg-fading');
        bgWordEl.classList.remove('bg-visible');
        setTimeout(function() {
          bgWordEl.textContent = s.bgWord;
          bgWordEl.classList.remove('bg-fading');
          bgWordEl.classList.add('bg-visible');
        }, 700);
      }

      setTimeout(function() {
        applySlide(idx);
        if (innerEl) { innerEl.classList.remove('fading'); innerEl.classList.add('visible'); }
      }, 1200);

      setTimeout(function() {
        activeIsTop = !activeIsTop;
        outgoingEl.style.transition = 'none';
        outgoingEl.style.opacity = '0';
        outgoingEl.classList.remove('zooming');
        currentSlide = idx;
        heroTransitioning = false;
      }, 1600);
    }

    function startAutoplay() {
      if (window._heroTimer) clearInterval(window._heroTimer);
      window._heroTimer = setInterval(function() {
        goToSlide((currentSlide + 1) % HERO_SLIDES.length);
      }, 6000);
    }

    initHero();
    startAutoplay();

    // Hero click — navigate to current slide
    var heroSection = document.getElementById('hero-section');
    if (heroSection) {
      heroSection.style.cursor = 'pointer';
      heroSection.onclick = function() {
        var s = HERO_SLIDES[currentSlide];
        if (s && s.slug) window.location.href = s.slug;
      };
    }

    // Dots — change slide
    document.querySelectorAll('.bottom-dot').forEach(function(dot) {
      dot.onclick = function(e) {
        e.stopPropagation();
        var idx = parseInt(this.dataset.slide, 10);
        goToSlide(idx);
        startAutoplay();
      };
    });

    // NEWSLETTER
    var nlBtn = document.getElementById('nl-btn');
    var nlEmail = document.getElementById('nl-email');
    if (nlBtn && nlEmail) {
      nlBtn.onclick = function() {
        var email = nlEmail.value.trim();
        if (!email || !email.includes('@')) {
          nlEmail.style.borderColor = '#c0392b';
          setTimeout(function() { nlEmail.style.borderColor = ''; }, 2000);
          return;
        }
        var nlModal = document.getElementById('nl-modal');
        if (nlModal) {
          var modalEmail = document.getElementById('nl-modal-email');
          if (modalEmail) modalEmail.value = email;
          nlModal.style.display = 'flex';
        }
      };
    }

    // NEWSLETTER MODAL
    var nlModalOverlay = document.getElementById('nl-modal-overlay');
    var nlModalSkip = document.getElementById('nl-modal-skip');
    var nlModalJoin = document.getElementById('nl-modal-join');

    function closeNlModal() {
      var modal = document.getElementById('nl-modal');
      if (modal) {
        modal.style.display = 'none';
        var s1 = document.getElementById('nl-modal-s1');
        var s2 = document.getElementById('nl-modal-s2');
        if (s1) s1.style.display = '';
        if (s2) s2.style.display = 'none';
      }
    }

    if (nlModalOverlay) nlModalOverlay.onclick = closeNlModal;
    if (nlModalSkip) nlModalSkip.onclick = closeNlModal;
    if (nlModalJoin) {
      nlModalJoin.onclick = function(e) {
        e.preventDefault();
        var s1 = document.getElementById('nl-modal-s1');
        var s2 = document.getElementById('nl-modal-s2');
        if (s1) s1.style.display = 'none';
        if (s2) s2.style.display = '';
      };
    }

    // FILM RAIL NAV
    var rail = document.getElementById('film-rail');
    var prevBtn = document.getElementById('film-prev');
    var nextBtn = document.getElementById('film-next');
    if (rail && prevBtn && nextBtn) {
      nextBtn.onclick = function() { rail.scrollBy({ left: 340, behavior: 'smooth' }); };
      prevBtn.onclick = function() { rail.scrollBy({ left: -340, behavior: 'smooth' }); };
    }

  }

  function destroyHomePage() {
    if (window._heroTimer) { clearInterval(window._heroTimer); window._heroTimer = null; }
  }

  // Expose so the module script below can call these on astro:page-load /
  // astro:before-swap without relying on registerPageInit timing.
  window.__kneedInitHome    = initHomePage;
  window.__kneedDestroyHome = destroyHomePage;
</script>

<script>
  import { supabase } from '../lib/supabase';

  function tryInitHome() {
    if (!document.getElementById('hero-section')) return;
    const fn = (window as any).__kneedInitHome;
    if (typeof fn === 'function') fn();
  }

  function initModalAuth() {
    if (!document.getElementById('nl-modal')) return;
    const googleBtn = document.getElementById('nl-modal-google') as HTMLButtonElement | null;
    const signupBtn = document.getElementById('nl-modal-create') as HTMLButtonElement | null;
    const errorEl   = document.getElementById('nl-modal-err')    as HTMLElement | null;
    const emailEl   = document.getElementById('nl-modal-email')  as HTMLInputElement | null;
    const pwEl      = document.getElementById('nl-modal-pw')     as HTMLInputElement | null;

    if (googleBtn) googleBtn.onclick = async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + '/auth/callback' }
      });
      if (error && errorEl) errorEl.textContent = error.message;
    };

    async function doSignup() {
      const email    = emailEl?.value.trim() ?? '';
      const password = pwEl?.value ?? '';
      if (errorEl) errorEl.textContent = '';
      if (!email || !password) { if (errorEl) errorEl.textContent = 'Please fill in all fields.'; return; }
      if (password.length < 6) { if (errorEl) errorEl.textContent = 'Password must be at least 6 characters.'; return; }
      if (signupBtn) { signupBtn.disabled = true; signupBtn.textContent = 'Creating account…'; }
      const { error } = await supabase.auth.signUp({ email, password });
      if (error) {
        if (errorEl) errorEl.textContent = error.message;
        if (signupBtn) { signupBtn.disabled = false; signupBtn.textContent = 'Create account'; }
      } else {
        if (errorEl) { errorEl.style.color = 'var(--amber)'; errorEl.textContent = 'Check your email to confirm your account.'; }
        if (signupBtn) { signupBtn.disabled = true; signupBtn.textContent = 'Email sent'; }
      }
    }

    if (signupBtn) signupBtn.onclick = doSignup;
    if (pwEl) pwEl.onkeydown = (e) => { if (e.key === 'Enter') doSignup(); };
  }

  document.addEventListener('astro:before-swap', function() {
    const fn = (window as any).__kneedDestroyHome;
    if (typeof fn === 'function') fn();
  });

  document.addEventListener('astro:page-load', function() {
    tryInitHome();
    initModalAuth();
  });

  tryInitHome();
  initModalAuth();
</script>