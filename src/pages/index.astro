        <div class="auth-or"><span>or</span></div>
        <div class="auth-field">
          <label class="auth-label" for="nl-modal-email">Email</label>
          <input class="auth-input" type="email" id="nl-modal-email" placeholder="your@email.com" autocomplete="email" />
