---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const bakeries = await getCollection('bakeries');
const stories = await getCollection('stories');
---

<BaseLayout title="Home" description="(K)Need — a cinematic exploration of Melbourne's best bakeries.">
  <main>

    <!-- HERO -->
    <section class="home-hero">
      <div class="home-hero-inner wf-container">
        <div class="wf-eyebrow">Melbourne Bakeries</div>
        <h1 class="home-hero-h1">Good bread is worth<br/>knowing about.</h1>
        <p class="home-hero-sub">Short films and stories about the bakers, ovens and neighbourhoods that make Melbourne's bread worth eating.</p>
        <div class="home-hero-actions">
          <a href="/bakeries" class="wf-pill pill-dark">Explore Bakeries</a>
          <a href="/kneed-to-know" class="wf-pill pill-light">Watch Films</a>
        </div>
      </div>
    </section>

    <!-- BAKERIES -->
    <section class="wf-container mt-section">
      <div class="wf-section-head">
        <div>
          <div class="wf-eyebrow">Featured</div>
          <h2>Bakeries</h2>
        </div>
        <a href="/bakeries" class="see-all-btn">
          See all
          <span class="arrow-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>
      <div class="home-grid">
        {bakeries.slice(0, 3).map((bakery) => (
          <a href={'/bakeries/' + bakery.data.slug} class="bak-card">
            <div class="bak-card-img-wrap">
              <img class="bak-card-img" src={bakery.data.thumbnail} alt={bakery.data.name} loading="lazy" />
              <div class="bak-card-grade"></div>
              <div class="bak-card-cat">{bakery.data.category}</div>
            </div>
            <div class="bak-card-body">
              <div class="bak-card-eyebrow">{bakery.data.suburb}</div>
              <div class="bak-card-title">{bakery.data.name}</div>
              <div class="bak-card-bakery">{bakery.data.hours}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- STORIES -->
    <section class="wf-container mt-section" style="padding-bottom: clamp(3rem,5vw,5rem);">
      <div class="wf-section-head">
        <div>
          <div class="wf-eyebrow">Latest</div>
          <h2>(K)Need to Know</h2>
        </div>
        <a href="/kneed-to-know" class="see-all-btn">
          See all
          <span class="arrow-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>
      <div class="home-grid">
        {stories.slice(0, 3).map((story) => (
          <a href={'/kneed-to-know/' + story.data.slug} class="film-card">
            <img class="film-card-img" src={story.data.thumbnail} alt={story.data.title} loading="lazy" />
            <div class="film-card-grade"></div>
            <div class="film-card-dur">{story.data.duration}</div>
            <div class="film-card-body">
              <div class="film-card-tag">{story.data.category}</div>
              <div class="film-card-title">{story.data.title}</div>
              <div class="film-card-bakery">{story.data.bakery}</div>
            </div>
            <div class="film-card-play">
              <svg viewBox="0 0 24 24"><polygon points="6,4 20,12 6,20"/></svg>
            </div>
            <div class="film-card-accent"></div>
          </a>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>

<style>
.home-hero {
  min-height: 60vh;
  display: flex;
  align-items: center;
  padding: clamp(4rem, 10vw, 8rem) 0;
  border-bottom: 1px solid var(--border);
}
.home-hero-inner {
  max-width: 52rem;
}
.home-hero-h1 {
  font-family: var(--font-display);
  font-weight: 200;
  font-size: clamp(2rem, 6vw, 4.5rem);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.1;
  color: var(--parchment);
  margin-top: 0.75rem;
}
.home-hero-sub {
  margin-top: 1.5rem;
  font-size: clamp(1rem, 1.5vw, 1.125rem);
  line-height: 1.8;
  font-weight: 300;
  color: var(--p-50);
  max-width: 38rem;
}
.home-hero-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 2.5rem;
  flex-wrap: wrap;
}

.home-grid {
  display: grid;
  gap: 1.125rem;
  grid-template-columns: 1fr;
}
@media (min-width: 600px) {
  .home-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 900px) {
  .home-grid { grid-template-columns: repeat(3, 1fr); }
}

.film-card {
  position: relative;
  display: block;
  border-radius: var(--r-card);
  overflow: hidden;
  border: 1px solid var(--border);
  aspect-ratio: 16/10;
  cursor: pointer;
  transition: border-color 0.22s, transform 0.25s var(--ease-out);
}
.film-card:hover { border-color: var(--border-md); transform: translateY(-4px); }
.film-card-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.72) saturate(0.85);
  transition: filter 0.4s, transform 0.6s var(--ease-out);
  display: block;
}
.film-card:hover .film-card-img { filter: brightness(0.88) saturate(1); transform: scale(1.04); }
.film-card-grade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(14,12,10,0.94) 0%, rgba(14,12,10,0.28) 45%, transparent 100%);
  pointer-events: none;
}
.film-card-dur {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  font-family: var(--font-cond);
  font-size: 0.6rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  background: rgba(14,12,10,0.72);
  color: var(--p-70);
  padding: 0.22rem 0.55rem;
  border-radius: var(--r-pill);
  border: 1px solid var(--border);
  backdrop-filter: blur(6px);
}
.film-card-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.film-card-tag {
  font-family: var(--font-cond);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--amber);
}
.film-card-title {
  font-family: var(--font-display);
  font-weight: 200;
  font-size: clamp(0.95rem, 1.8vw, 1.35rem);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--parchment);
  line-height: 1.25;
}
.film-card-bakery {
  font-family: var(--font-display);
  font-weight: 100;
  font-size: clamp(0.7rem, 1vw, 0.85rem);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--p-35);
  margin-top: 0.15rem;
}
.film-card-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  background: rgba(242,237,230,0.08);
  border: 1px solid rgba(242,237,230,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.25s, transform 0.25s var(--ease-out);
  pointer-events: none;
}
.film-card-play svg { width: 1rem; height: 1rem; fill: #fff; margin-left: 0.12em; }
.film-card:hover .film-card-play { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
.film-card-accent {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 2px;
  width: 0;
  background: var(--amber);
  transition: width 0.5s var(--ease-out);
}
.film-card:hover .film-card-accent { width: 100%; }
</style>