export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About (K)Need — a cultural and culinary exploration of breads and pastries through the eyes of passionate bakers.">
  <main class="wf-container py-page">

    <div class="wf-page-head">
      <div class="wf-eyebrow">About</div>
      <h1 class="wf-page-h1">(K)Need is a love letter to good bread.</h1>
      <p class="wf-page-intro">A cultural and culinary exploration of breads and pastries told through the eyes of passionate bakers.</p>
    </div>

    <div class="simple-body">
      <p>We believe the best bakeries are more than places to buy bread — they are neighbourhood anchors, living archives of craft, and windows into the people who shape the food we eat. (K)Need exists to document them.</p>
      <p>Each film is a short portrait of a baker and their space — the early mornings, the flour-dusted hands, the ovens that never cool. We travel across Melbourne to find the people doing it properly, and we tell their stories with the care they deserve.</p>
      <p>(K)Need is a production of <a href="https://commafilms.com.au" target="_blank" rel="noopener" style="color:var(--amber);">Comma Films</a>, a Melbourne-based film company.</p>
    </div>

  </main>
</BaseLayout>

