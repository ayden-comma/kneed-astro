---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Recipe Book" description="Your saved bakeries and articles on (K)Need.">
  <main class="wf-container py-page">

    <a href="/" class="back-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back home
    </a>

    <div class="wf-page-head" style="margin-bottom:2rem; margin-top:1.5rem;">
      <div class="wf-eyebrow">Your Collection</div>
      <h1 class="wf-page-h1" style="margin-top:0.35rem;">Recipe Book</h1>
    </div>

    <!-- Loading -->
    <div id="rb-loading" style="color:var(--p-35); font-size:0.875rem; font-weight:300;">Loading…</div>

    <!-- Logged out -->
    <div id="rb-loggedout" style="display:none; text-align:center; padding:4rem 0;">
      <p style="font-family:var(--font-display); font-weight:200; font-size:clamp(1rem,2vw,1.35rem); letter-spacing:0.1em; text-transform:uppercase; color:var(--p-50); margin-bottom:1.5rem;">Sign in to view your Recipe Book</p>
      <a href="/auth/login" class="wf-pill pill-amber">Sign in</a>
    </div>

    <!-- Empty state -->
    <div id="rb-empty" style="display:none; padding:3rem 0;">
      <p style="font-size:0.9375rem; font-weight:300; color:var(--p-50); line-height:1.75; max-width:32rem;">You haven't saved any bakeries or articles yet. Start exploring and save the ones you love.</p>
      <a href="/bakeries" class="wf-pill pill-amber" style="margin-top:1.5rem; display:inline-flex;">Explore bakeries</a>
    </div>

    <!-- Saved grid -->
    <div id="rb-grid" class="grid-3" style="display:none;"></div>

  </main>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  type CardItem = { href: string; name: string; category: string; thumbnail: string; subtitle: string };

  function cardHTML(item: CardItem): string {
    return `<a href="${esc(item.href)}" class="bak-card">
      <div class="bak-card-img-wrap">
        <img class="bak-card-img" src="${esc(item.thumbnail)}" alt="${esc(item.name)}" loading="lazy" />
        <div class="bak-card-grade"></div>
        <div class="bak-card-cat">${esc(item.category)}</div>
        <div class="bak-card-watch">
          <div class="bak-watch-pill">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="var(--ink)"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Watch Now
          </div>
        </div>
      </div>
      <div class="bak-card-body">
        <div class="bak-card-eyebrow">${esc(item.category)}</div>
        <div class="bak-card-title">${esc(item.name)}</div>
        <div class="bak-card-bakery">${esc(item.subtitle)}</div>
      </div>
    </a>`;
  }

  async function initRecipeBook() {
    const loadingEl = document.getElementById('rb-loading');
    const loggedout = document.getElementById('rb-loggedout');
    const emptyEl   = document.getElementById('rb-empty');
    const gridEl    = document.getElementById('rb-grid');
    if (!loadingEl || !loggedout || !emptyEl || !gridEl) return;

    const { data: { session } } = await supabase.auth.getSession();

    loadingEl.style.display = 'none';

    if (!session) {
      loggedout.style.display = '';
      return;
    }

    // Fetch all saves for this user, newest first
    const { data: saves } = await supabase
      .from('saves')
      .select('content_slug, content_type, created_at')
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false });

    if (!saves || saves.length === 0) {
      emptyEl.style.display = '';
      return;
    }

    // Split slugs by type
    const bakerySlugs  = saves.filter((s: { content_type: string }) => s.content_type === 'bakery').map((s: { content_slug: string }) => s.content_slug);
    const articleSlugs = saves.filter((s: { content_type: string }) => s.content_type === 'article').map((s: { content_slug: string }) => s.content_slug);

    // Fetch metadata in parallel — only the slugs the user saved
    const [bakeryResult, articleResult] = await Promise.all([
      bakerySlugs.length > 0
        ? supabase.from('bakeries_cms').select('slug, name, suburb, category, thumbnail').in('slug', bakerySlugs)
        : Promise.resolve({ data: [] }),
      articleSlugs.length > 0
        ? supabase.from('articles_cms').select('slug, title, category, thumbnail').in('slug', articleSlugs)
        : Promise.resolve({ data: [] }),
    ]);

    // Build lookup maps
    type BakeryRow  = { slug: string; name: string; suburb: string | null; category: string; thumbnail: string };
    type ArticleRow = { slug: string; title: string; category: string; thumbnail: string };

    const bakeryMap  = Object.fromEntries(((bakeryResult.data  ?? []) as BakeryRow[]).map(b => [b.slug, b]));
    const articleMap = Object.fromEntries(((articleResult.data ?? []) as ArticleRow[]).map(a => [a.slug, a]));

    // Map each save (in saves order = newest first) to a CardItem
    const cards = (saves as { content_slug: string; content_type: string }[])
      .map(s => {
        if (s.content_type === 'bakery') {
          const b = bakeryMap[s.content_slug];
          if (!b) return null;
          return { href: `/bakeries/${b.slug}`, name: b.name, category: b.category, thumbnail: b.thumbnail, subtitle: b.suburb ?? '' } satisfies CardItem;
        }
        if (s.content_type === 'article') {
          const a = articleMap[s.content_slug];
          if (!a) return null;
          return { href: `/kneed-to-know/${a.slug}`, name: a.title, category: a.category, thumbnail: a.thumbnail, subtitle: '(K)Need to Know' } satisfies CardItem;
        }
        return null;
      })
      .filter((item): item is CardItem => item !== null)
      .map(cardHTML)
      .join('');

    if (!cards) {
      emptyEl.style.display = '';
      return;
    }

    gridEl.innerHTML = cards;
    gridEl.style.display = '';
  }

  document.addEventListener('astro:page-load', initRecipeBook);
  initRecipeBook();
</script>
