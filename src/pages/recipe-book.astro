---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const bakeries = await getCollection('bakeries');
const bakeryMap = Object.fromEntries(
  bakeries.map(b => [b.data.slug, {
    slug:      b.data.slug,
    name:      b.data.name,
    suburb:    b.data.suburb,
    category:  b.data.category,
    thumbnail: b.data.thumbnail,
  }])
);
---

<BaseLayout title="Recipe Book" description="Your saved bakeries on (K)Need.">
  <main class="wf-container py-page">

    <a href="/" class="back-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back home
    </a>

    <div class="wf-page-head" style="margin-bottom:2rem; margin-top:1.5rem;">
      <div class="wf-eyebrow">Your Collection</div>
      <h1 class="wf-page-h1" style="margin-top:0.35rem;">Recipe Book</h1>
    </div>

    <!-- Loading -->
    <div id="rb-loading" style="color:var(--p-35); font-size:0.875rem; font-weight:300;">Loading…</div>

    <!-- Logged out -->
    <div id="rb-loggedout" style="display:none; text-align:center; padding:4rem 0;">
      <p style="font-family:var(--font-display); font-weight:200; font-size:clamp(1rem,2vw,1.35rem); letter-spacing:0.1em; text-transform:uppercase; color:var(--p-50); margin-bottom:1.5rem;">Sign in to view your Recipe Book</p>
      <a href="/auth/login" class="wf-pill pill-amber">Sign in</a>
    </div>

    <!-- Empty state -->
    <div id="rb-empty" style="display:none; padding:3rem 0;">
      <p style="font-size:0.9375rem; font-weight:300; color:var(--p-50); line-height:1.75; max-width:32rem;">You haven't saved any bakeries yet. Start exploring and save the ones you love.</p>
      <a href="/bakeries" class="wf-pill pill-amber" style="margin-top:1.5rem; display:inline-flex;">Explore bakeries</a>
    </div>

    <!-- Saved grid -->
    <div id="rb-grid" class="grid-3" style="display:none;"></div>

  </main>

  <!-- Bakery data for client-side lookup -->
  <div id="rb-bakery-data" data-json={JSON.stringify(bakeryMap)} style="display:none"></div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function cardHTML(b: { slug: string; name: string; suburb: string; category: string; thumbnail: string }): string {
    return `<a href="/bakeries/${esc(b.slug)}" class="bak-card">
      <div class="bak-card-img-wrap">
        <img class="bak-card-img" src="${esc(b.thumbnail)}" alt="${esc(b.name)}" loading="lazy" />
        <div class="bak-card-grade"></div>
        <div class="bak-card-cat">${esc(b.category)}</div>
        <div class="bak-card-watch">
          <div class="bak-watch-pill">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="var(--ink)"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Watch Now
          </div>
        </div>
      </div>
      <div class="bak-card-body">
        <div class="bak-card-eyebrow">${esc(b.category)}</div>
        <div class="bak-card-title">${esc(b.name)}</div>
        <div class="bak-card-bakery">${esc(b.suburb)}</div>
      </div>
    </a>`;
  }

  async function initRecipeBook() {
    const loadingEl  = document.getElementById('rb-loading');
    const loggedout  = document.getElementById('rb-loggedout');
    const emptyEl    = document.getElementById('rb-empty');
    const gridEl     = document.getElementById('rb-grid');
    const dataEl     = document.getElementById('rb-bakery-data');
    if (!loadingEl || !loggedout || !emptyEl || !gridEl || !dataEl) return;

    const bakeryMap: Record<string, { slug: string; name: string; suburb: string; category: string; thumbnail: string }> =
      JSON.parse(dataEl.dataset.json || '{}');

    const { data: { session } } = await supabase.auth.getSession();

    loadingEl.style.display = 'none';

    if (!session) {
      loggedout.style.display = '';
      return;
    }

    const { data: saves } = await supabase
      .from('saves')
      .select('content_slug, created_at')
      .eq('user_id', session.user.id)
      .eq('content_type', 'bakery')
      .order('created_at', { ascending: false });

    if (!saves || saves.length === 0) {
      emptyEl.style.display = '';
      return;
    }

    const cards = saves
      .map((s: { content_slug: string }) => bakeryMap[s.content_slug])
      .filter(Boolean)
      .map(cardHTML)
      .join('');

    if (!cards) {
      emptyEl.style.display = '';
      return;
    }

    gridEl.innerHTML = cards;
    gridEl.style.display = '';
  }

  document.addEventListener('astro:page-load', initRecipeBook);
  initRecipeBook();
</script>
