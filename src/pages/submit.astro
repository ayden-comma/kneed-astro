---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Submit a Bakery" description="Is your bakery a story worth telling? Submit to (K)Need.">
  <main class="wf-container py-page" style="max-width: 56rem;">

    <a href="/" class="back-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back home
    </a>

    <div class="wf-eyebrow">Submit Your Bakery</div>
    <h1 class="wf-page-h1" style="margin-top:0.5rem;">Is your bakery a story<br/>worth telling?</h1>
    <p class="wf-page-intro">(K)Need is a journal for neighbourhood bakeries, the people behind the bench and the culture of daily bread.</p>

    <div class="submit-overview">
      <p>If you think your bakery belongs in the journal, we'd love to hear from you. Fill in the form below and we'll be in touch if your story feels like a fit.</p>
      <p>Submissions are reviewed on a rolling basis. We don't charge for coverage and we're not a directory. Every story we publish is editorial.</p>
    </div>

    <div style="border-top: 1px solid var(--border); margin: 2rem 0;"></div>

    <!-- TAB SWITCHER -->
    <div class="submit-tabs">
      <button class="submit-tab-btn wf-pill pill-dark" id="tab-bakery" data-tab="bakery">Submit your bakery</button>
      <button class="submit-tab-btn wf-pill pill-light" id="tab-suggest" data-tab="suggest">Recommend a bakery</button>
    </div>

    <!-- SUBMIT YOUR BAKERY FORM -->
    <div id="form-bakery">
      <div id="submit-form-wrap">
        <div class="wf-eyebrow" style="margin-bottom: 1.5rem;">Your details</div>
        <div class="submit-form">
          <div class="form-row">
            <div class="form-field">
              <label class="form-label" for="f-name">Name</label>
              <input class="form-input" type="text" id="f-name" placeholder="Your full name" />
            </div>
            <div class="form-field">
              <label class="form-label" for="f-email">Email</label>
              <input class="form-input" type="email" id="f-email" placeholder="hello@yourbakery.com" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <div style="display:flex; align-items:baseline; gap:0.5rem;">
                <label class="form-label" for="f-phone">Phone</label>
                <span style="font-size:0.65rem; color:var(--p-35); letter-spacing:0.1em;">Optional</span>
              </div>
              <input class="form-input" type="tel" id="f-phone" placeholder="+61 4XX XXX XXX" />
            </div>
            <div class="form-field">
              <label class="form-label" for="f-bakery">Bakery Name</label>
              <input class="form-input" type="text" id="f-bakery" placeholder="The name of your bakery" />
            </div>
          </div>
          <div class="form-field">
            <label class="form-label" for="f-address">Address</label>
            <div style="position:relative;">
              <input class="form-input" type="text" id="f-address" placeholder="Street, suburb" autocomplete="off" />
              <ul id="f-addr-suggestions" style="display:none; position:absolute; z-index:100; top:100%; margin-top:2px; background:var(--surface); border:1px solid var(--border); border-radius:0.5rem; list-style:none; padding:0.25rem 0; margin-top:2px; width:100%;"></ul>
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label class="form-label" for="f-website">Website</label>
              <input class="form-input" type="text" id="f-website" placeholder="https://yourbakery.com" />
            </div>
            <div class="form-field">
              <div style="display:flex; align-items:baseline; gap:0.5rem;">
                <label class="form-label" for="f-instagram">Instagram</label>
                <span style="font-size:0.65rem; color:var(--p-35); letter-spacing:0.1em;">Optional</span>
              </div>
              <input class="form-input" type="text" id="f-instagram" placeholder="@handle" />
            </div>
          </div>
          <div class="form-field">
            <label class="form-label" for="f-desc">
              Short Description
              <span class="form-label-note">Tell us what makes your bakery worth a story. 100–200 words.</span>
            </label>
            <textarea class="form-input form-textarea" id="f-desc" placeholder="What's the story behind your bakery?..."></textarea>
          </div>
          <div class="form-actions">
            <button type="button" class="wf-pill pill-dark" id="submit-bakery-btn">
              Send submission
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </button>
            <p class="form-note">We read every submission. We'll be in touch within two weeks if your bakery feels like a fit.</p>
          </div>
        </div>
      </div>

      <div id="submit-success" style="display:none;">
        <div class="submit-success-block">
          <div class="success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h2 class="success-title">Submission received</h2>
          <p class="success-body">Thank you for reaching out. We've received your submission and will review it carefully.</p>
          <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:2rem;">
            <button class="wf-pill pill-light" id="btn-submit-another">Submit another</button>
            <a class="wf-pill pill-light" href="/">Back to home</a>
          </div>
        </div>
      </div>
    </div>

    <!-- RECOMMEND A BAKERY FORM -->
    <div id="form-suggest" style="display:none;">
      <div class="wf-eyebrow" style="margin-bottom:0.5rem;">Know a bakery we should visit?</div>
      <p style="font-size:0.9rem; font-weight:300; color:var(--p-50); line-height:1.65; margin-bottom:1.75rem; max-width:42rem;">If you know a bakery with a story worth telling, let us know. The best tips go straight onto our filming list.</p>
      <div class="submit-form" style="max-width:42rem;">
        <div class="form-field">
          <label class="form-label" for="sg-name">Bakery name <span class="form-required">*</span></label>
          <input class="form-input" type="text" id="sg-name" placeholder="Name of the bakery" />
        </div>
        <div class="form-field">
          <label class="form-label" for="sg-addr">Address or suburb <span class="form-required">*</span></label>
          <input class="form-input" type="text" id="sg-addr" placeholder="Where are they?" />
        </div>
        <div class="form-field">
          <label class="form-label" for="sg-why">
            Why should we film them?
            <span class="form-label-note">What makes them special?</span>
          </label>
          <textarea class="form-input form-textarea" id="sg-why" placeholder="Tell us what makes this bakery worth a story..."></textarea>
        </div>
        <div class="form-field">
          <label class="form-label" for="sg-email">Your Email <span class="form-label-note">Optional — so we can get back to you</span></label>
          <input class="form-input" type="email" id="sg-email" placeholder="hello@youremail.com" />
        </div>
        <div class="form-actions">
          <button type="button" class="wf-pill pill-dark" id="submit-suggest-btn">
            Send recommendation
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <div id="suggest-success" style="display:none;">
        <div class="submit-success-block">
          <div class="success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h2 class="success-title">Thanks for the tip</h2>
          <p class="success-body">We've got your recommendation and will look into it for our filming list.</p>
          <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:2rem;">
            <button class="wf-pill pill-light" id="btn-suggest-another">Submit another</button>
            <a class="wf-pill pill-light" href="/">Back to home</a>
          </div>
        </div>
      </div>
    </div>

  </main>
</BaseLayout>

<style>
.submit-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}
.submit-tab-btn {
  font-size: 0.65rem;
  cursor: pointer;
}
.submit-overview {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  margin-top: 1.25rem;
  font-size: 0.9375rem;
  line-height: 1.75;
  font-weight: 300;
  color: var(--p-50);
}
.submit-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  margin-top: 0.5rem;
}
.form-row {
  display: grid;
  gap: 1.25rem;
  grid-template-columns: 1fr;
}
@media (min-width: 640px) {
  .form-row { grid-template-columns: 1fr 1fr; }
}
.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.form-label-note {
  display: block;
  font-size: 0.75rem;
  font-weight: 300;
  color: var(--p-35);
  margin-top: 0.2rem;
  letter-spacing: 0;
  text-transform: none;
}
.form-required { color: var(--amber); }
.form-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: 0.5rem;
}
.form-note {
  font-size: 0.8rem;
  font-weight: 300;
  color: var(--p-35);
  line-height: 1.6;
}
.submit-success-block {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
}
.success-icon {
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  background: rgba(200,131,58,0.1);
  border: 1px solid rgba(200,131,58,0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--amber);
  margin-bottom: 0.5rem;
}
.success-icon svg { width: 1.25rem; height: 1.25rem; }
.success-title {
  font-family: var(--font-display);
  font-weight: 200;
  font-size: 1.5rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--parchment);
}
.success-body {
  font-size: 0.9375rem;
  font-weight: 300;
  line-height: 1.75;
  color: var(--p-50);
}
</style>

<script>
  import { supabase } from '../lib/supabase';

  // ── DOM refs ──────────────────────────────────────────────────
  const tabBakery   = document.getElementById('tab-bakery')!   as HTMLButtonElement;
  const tabSuggest  = document.getElementById('tab-suggest')!  as HTMLButtonElement;
  const formBakery  = document.getElementById('form-bakery')!;
  const formSuggest = document.getElementById('form-suggest')!;
  const bakeryBtn   = document.getElementById('submit-bakery-btn')!  as HTMLButtonElement;
  const suggestBtn  = document.getElementById('submit-suggest-btn')! as HTMLButtonElement;

  // ── Tab switching (onclick = prevents duplicate listeners) ────
  function showTab(tab: string) {
    if (tab === 'bakery') {
      formBakery.style.display  = '';
      formSuggest.style.display = 'none';
      tabBakery.className  = 'submit-tab-btn wf-pill pill-dark';
      tabSuggest.className = 'submit-tab-btn wf-pill pill-light';
    } else {
      formBakery.style.display  = 'none';
      formSuggest.style.display = '';
      tabBakery.className  = 'submit-tab-btn wf-pill pill-light';
      tabSuggest.className = 'submit-tab-btn wf-pill pill-dark';
    }
  }
  tabBakery.onclick  = () => showTab('bakery');
  tabSuggest.onclick = () => showTab('suggest');

  // ── Helpers ───────────────────────────────────────────────────
  function val(id: string) {
    return (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value.trim();
  }
  function clearFields(...ids: string[]) {
    ids.forEach(id => {
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value = '';
    });
  }
  function setLoading(btn: HTMLButtonElement, loading: boolean, savedHTML: string) {
    btn.disabled = loading;
    btn.innerHTML = loading ? 'Sending…' : savedHTML;
  }

  // ── Address autocomplete ──────────────────────────────────────
  const PLACES_KEY   = 'AIzaSyB6Dv_E_XEjozZqi_Tenk4AepcpYWHNUas';
  const addrInput    = document.getElementById('f-address')!        as HTMLInputElement;
  const addrList     = document.getElementById('f-addr-suggestions')! as HTMLUListElement;
  let   addrTimer: ReturnType<typeof setTimeout>;

  addrInput.addEventListener('input', () => {
    clearTimeout(addrTimer);
    const q = addrInput.value.trim();
    if (q.length < 3) { addrList.style.display = 'none'; return; }
    addrTimer = setTimeout(async () => {
      try {
        const res   = await fetch('https://places.googleapis.com/v1/places:autocomplete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Goog-Api-Key': PLACES_KEY },
          body: JSON.stringify({ input: q, includedRegionCodes: ['au'], includedPrimaryTypes: ['street_address', 'premise'] }),
        });
        const data  = await res.json();
        const preds = (data.suggestions || []) as any[];
        addrList.innerHTML = '';
        if (!preds.length) { addrList.style.display = 'none'; return; }
        preds.slice(0, 5).forEach(s => {
          const text = s.placePrediction?.text?.text || '';
          const li   = document.createElement('li');
          li.textContent   = text;
          li.style.cssText = 'padding:0.5rem 0.75rem; cursor:pointer; color:var(--parchment); font-size:0.875rem;';
          li.onmouseenter  = () => { li.style.background = 'rgba(255,255,255,0.06)'; };
          li.onmouseleave  = () => { li.style.background = ''; };
          li.onclick       = () => { addrInput.value = text; addrList.style.display = 'none'; };
          addrList.appendChild(li);
        });
        addrList.style.display = 'block';
      } catch (_) { addrList.style.display = 'none'; }
    }, 300);
  });
  document.addEventListener('click', e => {
    if (!addrInput.contains(e.target as Node) && !addrList.contains(e.target as Node)) {
      addrList.style.display = 'none';
    }
  });

  // ── Bakery form ───────────────────────────────────────────────
  function resetBakeryForm() {
    clearFields('f-name', 'f-email', 'f-phone', 'f-bakery', 'f-address', 'f-website', 'f-instagram', 'f-desc');
    document.getElementById('submit-success')!.style.display   = 'none';
    document.getElementById('submit-form-wrap')!.style.display = '';
  }

  bakeryBtn.onclick = async () => {
    console.log('submit clicked');
    const name   = val('f-name');
    const email  = val('f-email');
    const bakery = val('f-bakery');
    if (!name || !email || !bakery) {
      alert('Please fill in your name, email and bakery name.');
      return;
    }

    const savedHTML = bakeryBtn.innerHTML;
    setLoading(bakeryBtn, true, savedHTML);

    const { error } = await supabase.from('submissions').insert({
      bakery_name:    bakery,
      submitted_name: val('f-name')      || null,
      email:          email              || null,
      phone:          val('f-phone')     || null,
      suburb:         null,
      address:        val('f-address')   || null,
      website:        val('f-website')   || null,
      instagram:      val('f-instagram') || null,
      notes:          val('f-desc')      || null,
      status:         'pending',
    });

    if (error) {
      setLoading(bakeryBtn, false, savedHTML);
      alert('Something went wrong: ' + error.message);
      return;
    }

    setLoading(bakeryBtn, false, savedHTML);
    clearFields('f-name', 'f-email', 'f-phone', 'f-bakery', 'f-address', 'f-website', 'f-instagram', 'f-desc');
    document.getElementById('submit-form-wrap')!.style.display = 'none';
    document.getElementById('submit-success')!.style.display   = 'block';
  };

  document.getElementById('btn-submit-another')!.onclick = resetBakeryForm;

  // ── Suggest form ──────────────────────────────────────────────
  function resetSuggestForm() {
    clearFields('sg-name', 'sg-addr', 'sg-why', 'sg-email');
    document.getElementById('suggest-success')!.style.display  = 'none';
    (document.querySelector('#form-suggest .submit-form') as HTMLElement).style.display = '';
  }

  suggestBtn.onclick = async () => {
    console.log('suggest clicked');
    const name = val('sg-name');
    const addr = val('sg-addr');
    if (!name || !addr) {
      alert('Please fill in the bakery name and address.');
      return;
    }

    const savedHTML = suggestBtn.innerHTML;
    setLoading(suggestBtn, true, savedHTML);

    const { error } = await supabase.from('submissions').insert({
      bakery_name: name,
      email:       val('sg-email') || null,
      suburb:      null,
      address:     addr || null,
      website:     null,
      instagram:   null,
      notes:       val('sg-why') || null,
      status:      'pending',
    });

    if (error) {
      setLoading(suggestBtn, false, savedHTML);
      alert('Something went wrong: ' + error.message);
      return;
    }

    setLoading(suggestBtn, false, savedHTML);
    clearFields('sg-name', 'sg-addr', 'sg-why', 'sg-email');
    (document.querySelector('#form-suggest .submit-form') as HTMLElement).style.display = 'none';
    document.getElementById('suggest-success')!.style.display = 'block';
  };

  document.getElementById('btn-suggest-another')!.onclick = resetSuggestForm;
</script>