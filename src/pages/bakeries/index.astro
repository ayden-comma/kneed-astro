---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const bakeries = await getCollection('bakeries');
---

<BaseLayout title="Bakeries" description="Every bakery we've visited — neighbourhood rooms, old ovens and places worth travelling for.">

  <main class="wf-container py-page">

    <div class="wf-page-head">
      <div class="wf-eyebrow">Explore</div>
      <h1 class="wf-page-h1">Bakeries</h1>
      <p class="wf-page-intro">Neighbourhood rooms, old ovens and places worth travelling for.</p>
    </div>

    <div class="bakery-search-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" style="color:var(--p-35); flex-shrink:0;"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="bakery-search" type="search" placeholder="Search bakeries…" style="flex:1; background:transparent; border:none; outline:none; color:var(--parchment); font-family:var(--font-body); font-size:0.875rem; font-weight:300; min-width:0;" />
    </div>

    <div class="bak-grid" id="bak-grid">
      {bakeries.map((bakery) => (
        <a href={'/bakeries/' + bakery.data.slug} class="bak-card" data-name={bakery.data.name.toLowerCase()} data-suburb={bakery.data.suburb.toLowerCase()} data-category={bakery.data.category.toLowerCase()}>
          <div class="bak-card-img-wrap">
            <img class="bak-card-img" src={bakery.data.thumbnail} alt={bakery.data.name} loading="lazy" />
            <div class="bak-card-grade"></div>
            <div class="bak-card-cat">{bakery.data.category}</div>
            <div class="bak-card-watch">
              <div class="bak-watch-pill">
                <svg viewBox="0 0 24 24"><polygon points="6,4 20,12 6,20"/></svg>
                View Bakery
              </div>
            </div>
          </div>
          <div class="bak-card-body">
            <div class="bak-card-eyebrow">{bakery.data.suburb}</div>
            <div class="bak-card-title">{bakery.data.name}</div>
            <div class="bak-card-bakery">{bakery.data.hours}</div>
          </div>
        </a>
      ))}
    </div>

    <div id="bak-no-results" style="display:none;" class="bak-no-results">
      No bakeries found matching your search.
    </div>

  </main>

</BaseLayout>

<style>
.bakery-search-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-pill);
  padding: 0.75rem 1.25rem;
  margin-bottom: 2rem;
  margin-top: 1.75rem;
  max-width: 28rem;
  transition: border-color 0.2s;
}
.bakery-search-wrap:focus-within {
  border-color: var(--amber);
}
.bak-grid {
  display: grid;
  gap: 1.125rem;
  grid-template-columns: 1fr;
}
@media (min-width: 600px) {
  .bak-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 900px) {
  .bak-grid { grid-template-columns: repeat(3, 1fr); }
}
.bak-no-results {
  text-align: center;
  padding: 3rem 1rem;
  font-size: 0.9rem;
  font-weight: 300;
  color: var(--p-35);
}
</style>

<script is:inline>
  var searchInput = document.getElementById('bakery-search');
  var noResults = document.getElementById('bak-no-results');
  searchInput.addEventListener('input', function() {
    var query = this.value.toLowerCase().trim();
    var cards = document.querySelectorAll('.bak-card');
    var visible = 0;
    cards.forEach(function(card) {
      var name = card.dataset.name || '';
      var suburb = card.dataset.suburb || '';
      var category = card.dataset.category || '';
      var matches = name.includes(query) || suburb.includes(query) || category.includes(query);
      card.style.display = matches ? '' : 'none';
      if (matches) visible++;
    });
    noResults.style.display = visible === 0 ? 'block' : 'none';
  });
</script>