---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const bakeries = await getCollection('bakeries');
  return bakeries.map((bakery) => ({
    params: { slug: bakery.data.slug },
    props: { bakery },
  }));
}

const { bakery } = Astro.props;
const { data } = bakery;
const { Content } = await render(bakery);
---

<BaseLayout title={data.name} description={`${data.name} — ${data.category} bakery in ${data.suburb}, Melbourne.`}>
  <main>
    <a href="/bakeries">← Back to Bakeries</a>
    <img src={data.thumbnail} alt={data.name} />
    <p>{data.category}</p>
    <h1>{data.name}</h1>
    <p>{data.address}</p>
    <p>{data.hours}</p>
    {data.website && <a href={`https://${data.website}`} target="_blank">{data.website}</a>}
    {data.instagram && <a href={`https://instagram.com/${data.instagram}`} target="_blank">@{data.instagram}</a>}
    {data.mapLink && <a href={data.mapLink} target="_blank">Open in Maps</a>}
    <Content />
  </main>
</BaseLayout>