---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.get('preview') === 'true';

let q = supabase.from('bakeries_cms').select('*').eq('slug', slug);
if (!isPreview) q = q.eq('published', true);
const { data: rows } = await q.limit(1);
const row = rows?.[0];
if (!row) return new Response(null, { status: 404 });

const { data: bakeryLocations } = await supabase
  .from('locations')
  .select('label, address, lat, lng, hours, place_id')
  .eq('bakery_slug', slug)
  .order('sort_order');
const locationRows = (bakeryLocations ?? []) as { label: string | null; address: string | null; lat: number | null; lng: number | null; hours: string | null; place_id: string | null }[];

// Prev/next by name order
const { data: allRows } = await supabase
  .from('bakeries_cms').select('slug').eq('published', true).order('name');
const slugList = (allRows ?? []).map((r: any) => r.slug as string);
const ci = slugList.indexOf(slug as string);
const prevSlug = ci > 0 ? slugList[ci - 1] : null;
const nextSlug = ci < slugList.length - 1 ? slugList[ci + 1] : null;

const { data: prevData } = prevSlug ? await supabase.from('bakeries_cms').select('name').eq('slug', prevSlug).single() : { data: null };
const { data: nextData } = nextSlug ? await supabase.from('bakeries_cms').select('name').eq('slug', nextSlug).single() : { data: null };
const prevName = (prevData as any)?.name || '';
const nextName = (nextData as any)?.name || '';

const data = {
  name:           row.name,
  slug:           row.slug,
  suburb:         row.suburb,
  category:       row.category,
  hours:          row.hours,
  website:        row.website,
  instagram:      row.instagram,
  thumbnail:      row.thumbnail,
  lat:            row.lat,
  lng:            row.lng,
  description:    row.description,
  address:        row.address,
  videoId:        (row as any).video_id        ?? null,
  mapLink:        (row as any).map_link        ?? null,
  images:         (row as any).images          ?? [],
  locations:      (row as any).locations       ?? null,
  quote:          (row as any).quote           ?? null,
  date:           (row as any).date            ?? null,
  duration:       (row as any).duration        ?? null,
  episode_number: (row as any).episode_number  ?? null,
  director:       (row as any).director        ?? null,
  camera:         (row as any).camera          ?? null,
  sound:          (row as any).sound           ?? null,
  edit:           (row as any).edit            ?? null,
  credits:        (row as any).credits         ?? null,
  hero_image_url: (row as any).hero_image_url  ?? null,
  hero_tag:       (row as any).hero_tag        ?? null,
  hero_title:     (row as any).hero_title      ?? null,
  hero_bg_word:   (row as any).hero_bg_word    ?? null,
  loop_video_url: (row as any).loop_video_url  ?? null,
};

const heroImage = data.hero_image_url || data.thumbnail || '';
const locationLabel = locationRows[0]?.label || '';

const websiteDisplay = data.website ? data.website.replace(/^https?:\/\//, '') : null;
const websiteHref = data.website
  ? data.website.startsWith('http') ? data.website : 'https://' + data.website
  : null;
const igHandle = data.instagram ? data.instagram.replace('@', '') : null;
const hasMapLink = !!data.mapLink;
const mapPins = locationRows.filter(r => r.lat !== null && r.lng !== null);
const hasMultiLocations = mapPins.length > 1;
const hasLat = mapPins.length > 0;
const hasVideo = !!data.videoId;
const images = data.images || [];
const mapLocationsJson = hasMultiLocations ? JSON.stringify(mapPins.map(r => ({ lat: r.lat, lng: r.lng, addr: r.address ?? '', hours: r.hours ?? '', label: r.label ?? '', place_id: r.place_id ?? '' }))) : '';
const mapLat  = !hasMultiLocations ? String(mapPins[0]?.lat ?? '') : '';
const mapLng  = !hasMultiLocations ? String(mapPins[0]?.lng ?? '') : '';

const credits: { role: string; name: string }[] = [];
if (data.director) credits.push({ role: 'Director', name: data.director });
if (data.camera)   credits.push({ role: 'Camera',   name: data.camera });
if (data.sound)    credits.push({ role: 'Sound',     name: data.sound });
if (data.edit)     credits.push({ role: 'Edit',      name: data.edit });

const bodyHtml = (row as any).body ?? '';
---

<script is:inline>
  if (history.scrollRestoration) history.scrollRestoration = 'manual';
  window.scrollTo(0, 0);
  if (window.location.hash) {
    history.replaceState(null, '', window.location.pathname + window.location.search);
  }
</script>
<BaseLayout
  title={data.name}
  description={data.description || data.name + ' — ' + data.category + ' bakery in ' + data.suburb + ', Melbourne.'}
  image={data.thumbnail}
>
  <div id="preview-banner" style="display:none; position:fixed; top:0; left:0; right:0; z-index:9999; background:var(--amber); color:var(--ink); text-align:center; padding:0.5rem 1rem; font-size:0.75rem; font-family:var(--font-cond); letter-spacing:0.1em; text-transform:uppercase; font-weight:600;">
    Preview mode — not yet published &nbsp;·&nbsp;
    <a href="/admin/bakeries" style="color:var(--ink); text-decoration:underline;">← Back to admin</a>
  </div>
  <main>

    <!-- ── NEW HERO ──────────────────────────────────────────────────── -->
    <section class="v2-hero">
      <div class="v2-story-nav">
        {prevSlug ? (
          <a href={`/bakeries/${prevSlug}`} class="v2-story-nav-item v2-story-nav-prev">
            <span class="v2-story-nav-arrow">←</span>
            <span class="v2-story-nav-meta">
              <span class="v2-story-nav-label">Previous</span>
              <span class="v2-story-nav-name">{prevName}</span>
            </span>
          </a>
        ) : (
          <a href="/bakeries" class="v2-story-nav-item v2-story-nav-prev">
            <span class="v2-story-nav-arrow">←</span>
            <span class="v2-story-nav-meta">
              <span class="v2-story-nav-label">Back to</span>
              <span class="v2-story-nav-name">All Bakeries</span>
            </span>
          </a>
        )}
        {nextSlug ? (
          <a href={`/bakeries/${nextSlug}`} class="v2-story-nav-item v2-story-nav-next">
            <span class="v2-story-nav-meta" style="text-align:right;">
              <span class="v2-story-nav-label">Next</span>
              <span class="v2-story-nav-name">{nextName}</span>
            </span>
            <span class="v2-story-nav-arrow">→</span>
          </a>
        ) : (
          <a href="/bakeries" class="v2-story-nav-item v2-story-nav-next">
            <span class="v2-story-nav-meta" style="text-align:right;">
              <span class="v2-story-nav-label">Back to</span>
              <span class="v2-story-nav-name">All Bakeries</span>
            </span>
            <span class="v2-story-nav-arrow">→</span>
          </a>
        )}
      </div>
      <div class="v2-hero-bg" style={`background-image: url('${heroImage}')`}></div>
      <video
        class="v2-hero-loop-video"
        autoplay
        muted
        loop
        playsinline
        poster={heroImage}
        id="v2-loop-video"
      >
        {data.loop_video_url && <source src={data.loop_video_url} type="video/mp4" />}
      </video>
      <div class="v2-hero-overlay"></div>
      <div class="v2-hero-bottom-fade"></div>
      {data.hero_bg_word && <div class="v2-hero-bgword">{data.hero_bg_word}</div>}

      <div class="v2-hero-content">
        <div class="v2-hero-eyebrow">
          <span class="v2-hero-dot"></span>
          {data.category && <span class="v2-eyebrow-tag">{data.category}</span>}
          {data.date && <><span class="v2-eyebrow-dash">——</span><span class="v2-eyebrow-meta">{data.date}</span></>}
          {locationLabel && <><span class="v2-eyebrow-dash">·</span><span class="v2-eyebrow-meta">{locationLabel}</span></>}
        </div>

        <h1 class="v2-hero-title">{data.hero_title || data.name}</h1>

        {data.name && data.hero_title && <div class="v2-hero-bakery">{data.name}</div>}

        {data.description && (
          <p class="v2-hero-desc">{data.description}</p>
        )}

        <div class="v2-hero-actions">
          {hasVideo && (
            <button id="v2-watch-btn" class="v2-btn-watch" data-video-id={data.videoId}>
              <span class="v2-btn-watch-icon"></span>
              Watch Now
            </button>
          )}
          <button id="save-btn" class="v2-btn-save" type="button" data-slug={data.slug}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            Save
          </button>

        </div>
      </div>

    </section>

    <!-- BODY: ASIDE + ARTICLE -->
    <div class="story-body-section">
      <aside>
        <div class="story-aside">

          <div>
            <span class="aside-label">Bakery</span>
            <span class="aside-value">{data.name}</span>
          </div>

          <div>
            <span class="aside-label">Address</span>
            {locationRows.length > 1 ? (
              <button class="aside-addr-scroll" onclick="document.getElementById('map-section').scrollIntoView({behavior:'smooth',block:'center'})">Various locations</button>
            ) : locationRows.length === 1 ? (
              hasLat ? (
                <button class="aside-addr-scroll aside-location-btn" data-index="0">{locationRows[0].address || data.address}</button>
              ) : (
                <span style="color:var(--p-70);">{locationRows[0].address || data.address}</span>
              )
            ) : (
              (hasLat && data.address) ? (
                <button class="aside-addr-scroll aside-location-btn" data-index="0">{data.address}</button>
              ) : data.address ? (
                <span style="color:var(--p-70);">{data.address}</span>
              ) : null
            )}
          </div>

          {websiteHref && (
            <div>
              <span class="aside-label">Website</span>
              <a class="aside-link" href={websiteHref} target="_blank" rel="noopener">{websiteDisplay}</a>
            </div>
          )}

          {igHandle && (
            <div>
              <span class="aside-label">Instagram</span>
              <a class="aside-link aside-instagram" href={'https://instagram.com/' + igHandle} target="_blank" rel="noopener">{igHandle}</a>
            </div>
          )}

          {data.credits && Array.isArray(data.credits) && data.credits.length > 0 && (
            <div class="story-credits">
              <span class="aside-label">Credits</span>
              {(data.credits as { title: string; name: string }[]).map((credit) => (
                <div class="story-credit-row">
                  <span class="story-credit-title">{credit.title}</span>
                  <span class="story-credit-name">{credit.name}</span>
                </div>
              ))}
            </div>
          )}

          <hr class="aside-divider" />

          <div class="aside-label">Rate this film</div>
          <div class="v2-aside-stars" id="v2-aside-stars" data-slug={data.slug}>
            {[1,2,3,4,5].map(n => (
              <button class="v2-aside-star" data-value={String(n)} aria-label={`Rate ${n} stars`}>★</button>
            ))}
          </div>
          <div class="v2-aside-rating-count" id="v2-aside-rating-count"></div>

          <div class="aside-label" style="margin-top: 1.25rem;">Share</div>
          <div class="v2-aside-share">
            <button class="v2-aside-share-btn" id="v2-aside-fb" aria-label="Share on Facebook">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </button>
            <button class="v2-aside-share-btn" id="v2-aside-wa" aria-label="Share on WhatsApp">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </button>
            <button class="v2-aside-share-btn" id="v2-aside-li" aria-label="Share on LinkedIn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </button>
            <button class="v2-aside-share-btn" id="v2-aside-copy" aria-label="Copy link">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
          </div>

        </div>
      </aside>

      <article class="story-article">

        {data.quote && (
          <blockquote class="story-quote">{data.quote}</blockquote>
        )}

        <div class="story-body-content" set:html={bodyHtml} />

        {images.length > 0 && (
          <div class="bakery-inline-photos">
            {images.map((img: any) => (
              <figure class="story-inline-photo">
                <img src={img.src} alt={img.caption || data.name} loading="lazy" />
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}

      </article>
    </div>

    <!-- COMMENTS SECTION -->
    <section class="comments-section wf-container" data-slug={data.slug}>
      <div class="comments-header">
        <div class="wf-eyebrow">Community</div>
        <h2 class="comments-title">Discussion</h2>
      </div>

      <div id="comment-form-wrap">
        <textarea id="comment-input" class="comment-input" placeholder="Share your thoughts about this bakery..." rows="3"></textarea>
        <button id="comment-submit" class="wf-pill pill-amber" type="button">Post comment</button>
      </div>

      <div id="comment-signin-prompt" style="display:none">
        <a href="/auth/login" class="wf-pill pill-light">Sign in to comment</a>
      </div>

      <div id="comments-list" class="comments-list"></div>
    </section>

    <!-- MAP SECTION -->
    {hasLat && (
      <section id="map-section" class="wf-container story-map-section" style="padding-bottom: clamp(3rem,5vw,5rem);">
        <div class="wf-section-head">
          <div>
            <div class="wf-eyebrow">Find this Bakery</div>
            <h2>Visit the Bakery</h2>
          </div>
          <a href="/map" class="see-all-btn">
            Full map
            <span class="arrow-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </span>
          </a>
        </div>
        <div class="story-map-panel">
          <div class="story-map-info">
            <div class="story-map-info-top">
              <div class="wf-eyebrow">{data.category}</div>
              <div class="story-map-info-name">{data.name}</div>
              <div class="story-map-details">
                {locationRows.length === 0 && data.address && (hasMapLink ? (
                  <a class="story-map-detail" data-location-index="0" href={data.mapLink!} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {data.address}
                  </a>
                ) : (
                  <button class="story-map-detail aside-location-btn" data-index="0" style="background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit;font-size:0.82rem;font-weight:inherit;color:var(--amber);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {data.address}
                  </button>
                ))}
                {locationRows.length === 1 && locationRows[0].address && (
                  <button class="story-map-detail aside-location-btn" data-index="0" style="background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit;font-size:0.82rem;font-weight:inherit;color:var(--amber);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {locationRows[0].address}
                  </button>
                )}
                {hasMultiLocations && mapPins.map((loc, i) => (
                  <button class="map-location-line" data-index={i} data-address={loc.address || ''} data-hours={loc.hours || data.hours || ''} data-label={loc.label || ''}>
                    {loc.address || loc.label}
                  </button>
                ))}
                {websiteHref && (
                  <a class="story-map-detail" href={websiteHref} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10z"/></svg>
                    {websiteDisplay}
                  </a>
                )}
                {igHandle && (
                  <a class="story-map-detail" href={'https://instagram.com/' + igHandle} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    @{igHandle}
                  </a>
                )}
              </div>
            </div>
          </div>
          <div class="story-map-canvas-wrap">
            <div
              id="bakery-map"
              data-lat={mapLat}
              data-lng={mapLng}
              data-locations={mapLocationsJson}
              data-name={data.name}
              data-thumbnail={data.thumbnail || ''}
              data-suburb={data.suburb || ''}
              data-addr={!hasMultiLocations ? (mapPins[0]?.address ?? data.address ?? '') : ''}
              data-hours={!hasMultiLocations ? (mapPins[0]?.hours ?? data.hours ?? '') : ''}
              data-place-id={!hasMultiLocations ? (mapPins[0]?.place_id ?? '') : ''}
            ></div>
          </div>
        </div>
      </section>
    )}

    <div class="v2-modal-overlay" id="v2-modal-overlay">
      <div class="v2-modal-inner">
        <button class="v2-modal-close" id="v2-modal-close" aria-label="Close video">×</button>
        <div class="v2-modal-frame">
          <iframe
            id="v2-modal-iframe"
            width="100%"
            height="100%"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>

  </main>

</BaseLayout>

<style>
/* ── V2 HERO ────────────────────────────────────────────────────────── */
.v2-hero {
  position: relative;
  width: 100%;
  height: calc(100vh - 280px);
  min-height: 400px;
  max-height: 680px;
  overflow: hidden;
  background: var(--ink);
}
.v2-hero-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
}
.v2-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.45) 55%, rgba(0,0,0,0.15) 100%);
}
.v2-hero-bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 45%;
  background: linear-gradient(to bottom, transparent 0%, var(--ink) 100%);
  z-index: 1;
  pointer-events: none;
}
@keyframes v2WordDrift {
  0%   { transform: translateY(-50%) translateX(6%); }
  100% { transform: translateY(-50%) translateX(-22%); }
}
.v2-hero-bgword {
  position: absolute;
  right: -0.02em;
  top: 50%;
  transform: translateY(-50%);
  animation: v2WordDrift 45s linear 0.3s infinite alternate;
  font-family: var(--font-display);
  font-size: clamp(5rem, 12vw, 10rem);
  font-weight: 200;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,255,255,0.07);
  white-space: nowrap;
  line-height: 1;
  pointer-events: none;
  z-index: 1;
}
.v2-story-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  z-index: 5;
  background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 100%);
}
.v2-story-nav-item {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  padding: 0.875rem clamp(1rem, 3vw, 2rem);
  text-decoration: none;
  flex: 1;
