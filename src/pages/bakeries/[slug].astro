---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const bakeries = await getCollection('bakeries');
  return bakeries.map((bakery, index) => ({
    params: { slug: bakery.data.slug },
    props: {
      bakery,
      prevSlug: index > 0 ? bakeries[index - 1].data.slug : null,
      nextSlug: index < bakeries.length - 1 ? bakeries[index + 1].data.slug : null,
    },
  }));
}

const { bakery, prevSlug, nextSlug } = Astro.props;
const { data } = bakery;
const { Content } = await render(bakery);

const websiteDisplay = data.website ? data.website.replace(/^https?:\/\//, '') : null;
const websiteHref = data.website
  ? data.website.startsWith('http') ? data.website : 'https://' + data.website
  : null;
const igHandle = data.instagram ? data.instagram.replace('@', '') : null;
const hasMapLink = !!data.mapLink;
const hasMultiLocations = !!(data.locations && data.locations.length > 1);
const hasLat = (!!data.lat && !!data.lng) || hasMultiLocations || !!(data.locations && data.locations.length === 1);
const hasVideo = !!data.videoId;
const images = data.images || [];
// For multi-location: pass JSON; for single: pass lat/lng directly as data-attributes
const mapLocationsJson = hasMultiLocations ? JSON.stringify(data.locations) : '';
const mapLat  = !hasMultiLocations ? String(data.locations?.[0]?.lat ?? data.lat ?? '') : '';
const mapLng  = !hasMultiLocations ? String(data.locations?.[0]?.lng ?? data.lng ?? '') : '';

const credits = [];
if (data.director) credits.push({ role: 'Director', name: data.director });
if (data.camera)   credits.push({ role: 'Camera',   name: data.camera });
if (data.sound)    credits.push({ role: 'Sound',     name: data.sound });
if (data.edit)     credits.push({ role: 'Edit',      name: data.edit });
---

<script is:inline>
  if (history.scrollRestoration) history.scrollRestoration = 'manual';
  window.scrollTo(0, 0);
  // Clear any hash that matches an element on this page (e.g. #bakery-map)
  // to prevent the browser jumping to it on load.
  if (window.location.hash) {
    history.replaceState(null, '', window.location.pathname + window.location.search);
  }
</script>
<BaseLayout
  title={data.name}
  description={data.description || data.name + ' — ' + data.category + ' bakery in ' + data.suburb + ', Melbourne.'}
>
  <main>

    <!-- VIDEO SHELL -->
    <div class="story-video-shell">
      <div class="story-video-inner">

        <!-- SHARE RAIL -->
        <div class="story-share-rail">
          <button class="share-btn" id="share-fb" aria-label="Share on Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </button>
          <button class="share-btn" id="share-ig" aria-label="Share on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </button>
          <button class="share-btn" id="share-li" aria-label="Share on LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </button>
          <button class="share-btn" id="share-link" aria-label="Copy link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
        </div>

        <!-- VIDEO / IMAGE BLOCK -->
        <div class="story-video-block">
          <div class="story-video-wrap">
            {hasVideo ? (
              <iframe
                src={'https://www.youtube.com/embed/' + data.videoId + '?rel=0&modestbranding=1'}
                title={data.name}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            ) : (
              <>
                <img class="story-video-poster" src={data.thumbnail} alt={data.name} />
                <div class="bakery-hero-grade"></div>
                <div class="bakery-hero-badge">{data.category}</div>
              </>
            )}
          </div>
        </div>

        <!-- NAV RAIL -->
        <div class="story-nav-rail">
          <a href={nextSlug ? '/bakeries/' + nextSlug : '/bakeries'} class="story-nav-btn" aria-label="Next bakery">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <a href={prevSlug ? '/bakeries/' + prevSlug : '/bakeries'} class="story-nav-btn" aria-label="Previous bakery">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </a>
        </div>

      </div>

      <!-- MOBILE-ONLY: prev | share icons | next -->
      <div class="story-mobile-actions">
        <div class="story-mobile-bar">
          <a href={prevSlug ? '/bakeries/' + prevSlug : '/bakeries'} class="story-nav-btn" aria-label="Previous bakery">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </a>
          <div class="story-mobile-share">
            <button class="share-btn" id="m-share-ig" aria-label="Share on Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </button>
            <button class="share-btn" id="m-share-tt" aria-label="Share on TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
            </button>
            <button class="share-btn" id="m-share-fb" aria-label="Share on Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </button>
            <button class="share-btn" id="m-share-link" aria-label="Copy link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
          </div>
          <a href={nextSlug ? '/bakeries/' + nextSlug : '/bakeries'} class="story-nav-btn" aria-label="Next bakery">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- TITLE BLOCK -->
    <div class="story-title-block">
      <a href="/bakeries" class="back-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        All Bakeries
      </a>
      <div class="story-meta-row">
        <span>{data.category}</span>
        <span class="meta-dot">—</span>
        <span>{data.suburb}</span>
        {data.date && <span class="meta-dot">—</span>}
        {data.date && <span>{data.date}</span>}
        {data.duration && <span class="meta-dot">—</span>}
        {data.duration && <span>{data.duration}</span>}
      </div>
      <h1 class="story-h1">
        <span class="story-h1-bread">{data.name}</span>
        <span class="story-h1-bakery">{data.suburb}</span>
      </h1>
      {data.description && <p class="story-h1-sub">{data.description}</p>}
      <button id="save-btn" class="aside-share-btn" type="button" data-slug={data.slug} style="width:auto; margin-top:1.25rem;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        Save to Recipe Book
      </button>
    </div>

    <!-- Star rating — below the title block dividing line -->
    <div class="story-rating-row">
      <div class="star-rating" id="star-rating" data-slug={data.slug}>
        <span class="star" data-value="1">★</span>
        <span class="star" data-value="2">★</span>
        <span class="star" data-value="3">★</span>
        <span class="star" data-value="4">★</span>
        <span class="star" data-value="5">★</span>
      </div>
      <span class="rating-label">Rate this story</span>
      <span class="rating-sep">·</span>
      <span class="rating-summary" id="rating-summary"></span>
    </div>

    <!-- BODY: ASIDE + ARTICLE -->
    <div class="story-body-section">
      <aside>
        <div class="story-aside">

          <div>
            <span class="aside-label">Bakery</span>
            <span class="aside-value">{data.name}</span>
          </div>

          <div>
            <span class="aside-label">Address</span>
            {hasMultiLocations ? (
              <div class="aside-locations">
                {data.locations!.map((loc, locIdx) => (
                  <a class="aside-link" data-location-index={String(locIdx)} href={'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(loc.addr)} target="_blank" rel="noopener">{loc.addr}</a>
                ))}
              </div>
            ) : (
              <>
                {hasMapLink && <a class="aside-link" data-location-index="0" href={data.mapLink} target="_blank" rel="noopener">{data.address}</a>}
                {!hasMapLink && <span class="aside-value" data-location-index="0">{data.address}</span>}
              </>
            )}
          </div>

          <div>
            <span class="aside-label">Hours</span>
            <span class="aside-value">{data.hours}</span>
          </div>

          {websiteHref && (
            <div>
              <span class="aside-label">Website</span>
              <a class="aside-link" href={websiteHref} target="_blank" rel="noopener">{websiteDisplay}</a>
            </div>
          )}

          {igHandle && (
            <div>
              <span class="aside-label">Instagram</span>
              <a class="aside-link aside-instagram" href={'https://instagram.com/' + igHandle} target="_blank" rel="noopener">{igHandle}</a>
            </div>
          )}

          {credits.length > 0 && (
            <div>
              <div style="height:1px; background:var(--border); margin:0.25rem 0;"></div>
              <span class="aside-label" style="display:block; margin-bottom:0.375rem;">Film Credits</span>
              <div class="credits-grid">
                {credits.map((c) => (
                  <div class="credit-card">
                    <span class="credit-role">{c.role}</span>
                    <span class="credit-name">{c.name}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {hasMultiLocations ? (
            <a class="wf-pill pill-dark" href={'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(data.locations![0].addr)} target="_blank" rel="noopener" style="margin-top:0.25rem; justify-content:center;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Open in Maps
            </a>
          ) : hasMapLink ? (
            <a class="wf-pill pill-dark" href={data.mapLink} target="_blank" rel="noopener" style="margin-top:0.25rem; justify-content:center;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Open in Maps
            </a>
          ) : null}

          <button class="aside-share-btn" id="share-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4"/><path d="m15.4 6.5-6.8 4"/></svg>
            Share
          </button>

        </div>
      </aside>

      <article class="story-article">

        {data.quote && (
          <blockquote class="story-quote">{data.quote}</blockquote>
        )}

        <div class="story-body-text">
          <Content />
        </div>

        {images.length > 0 && (
          <div class="bakery-inline-photos">
            {images.map((img) => (
              <figure class="story-inline-photo">
                <img src={img.src} alt={img.caption || data.name} loading="lazy" />
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}

      </article>
    </div>

    <!-- COMMENTS SECTION -->
    <section class="comments-section wf-container" data-slug={data.slug}>
      <div class="comments-header">
        <div class="wf-eyebrow">Community</div>
        <h2 class="comments-title">Discussion</h2>
      </div>

      <div id="comment-form-wrap">
        <textarea id="comment-input" class="comment-input" placeholder="Share your thoughts about this bakery..." rows="3"></textarea>
        <button id="comment-submit" class="wf-pill pill-amber" type="button">Post comment</button>
      </div>

      <div id="comment-signin-prompt" style="display:none">
        <a href="/auth/login" class="wf-pill pill-light">Sign in to comment</a>
      </div>

      <div id="comments-list" class="comments-list"></div>
    </section>

    <!-- MAP SECTION -->
    {hasLat && (
      <section class="wf-container story-map-section" style="padding-bottom: clamp(3rem,5vw,5rem);">
        <div class="wf-section-head">
          <div>
            <div class="wf-eyebrow">Find this Bakery</div>
            <h2>Visit the Bakery</h2>
          </div>
          <a href="/map" class="see-all-btn">
            Full map
            <span class="arrow-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </span>
          </a>
        </div>
        <div class="story-map-panel">
          <div class="story-map-info">
            <div class="story-map-info-top">
              <div class="wf-eyebrow">{data.category}</div>
              <div class="story-map-info-name">{data.name}</div>
              <div class="story-map-details">
                {hasMultiLocations ? (
                  data.locations!.map((loc, locIdx) => (
                    <a class="story-map-detail" data-location-index={String(locIdx)} href={'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(loc.addr)} target="_blank" rel="noopener">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                      {loc.addr}
                    </a>
                  ))
                ) : hasMapLink ? (
                  <a class="story-map-detail" data-location-index="0" href={data.mapLink} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {data.address}
                  </a>
                ) : null}
                <div class="story-map-detail">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {data.hours}
                </div>
                {websiteHref && (
                  <a class="story-map-detail" href={websiteHref} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"/></svg>
                    {websiteDisplay}
                  </a>
                )}
                {igHandle && (
                  <a class="story-map-detail" href={'https://instagram.com/' + igHandle} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    @{igHandle}
                  </a>
                )}
              </div>
            </div>
            {(hasMultiLocations || hasMapLink) && (
              <div class="story-map-info-btn">
                <a
                  class="wf-pill pill-dark"
                  href={hasMultiLocations
                    ? 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(data.locations![0].addr)
                    : data.mapLink!}
                  target="_blank"
                  rel="noopener"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  Open in map
                </a>
              </div>
            )}
          </div>
          <div class="story-map-canvas-wrap">
            <div
              id="bakery-map"
              data-lat={mapLat}
              data-lng={mapLng}
              data-locations={mapLocationsJson}
            ></div>
          </div>
        </div>
      </section>
    )}

  </main>
</BaseLayout>

<style>
.story-video-shell {
  background: var(--ink);
  padding: clamp(1rem, 2vw, 1.75rem) 0;
}
.story-video-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--px);
  display: flex;
  align-items: center;
}
.story-share-rail {
  width: clamp(2.5rem, 5vw, 3.5rem);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  padding: 0 0.25rem;
}
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--p-50);
  cursor: pointer;
  transition: background 0.18s, color 0.18s, transform 0.18s;
  flex-shrink: 0;
}
.share-btn:hover { background: var(--parchment); color: var(--ink); transform: scale(1.08); }
.share-btn svg { width: 0.8125rem; height: 0.8125rem; }
.story-video-block {
  flex: 1;
  position: relative;
  background: var(--ink);
  min-width: 0;
}
.story-video-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  background: var(--ink);
  overflow: hidden;
  border-radius: var(--r-hero);
}
.story-video-wrap iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}
.story-video-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.bakery-hero-grade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(14,12,10,0.25) 0%, rgba(14,12,10,0.05) 35%, rgba(14,12,10,0.55) 68%, rgba(14,12,10,0.97) 100%);
  pointer-events: none;
}
.bakery-hero-badge {
  position: absolute;
  bottom: 1.25rem;
  left: clamp(1.25rem, 4vw, 2.5rem);
  font-family: var(--font-cond);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  background: var(--amber);
  color: #fff;
  padding: 0.28rem 0.75rem;
  border-radius: var(--r-pill);
}
.story-nav-rail {
  width: clamp(2.5rem, 5vw, 3.5rem);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  padding: 0 0.25rem;
}
.story-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--p-50);
  cursor: pointer;
  transition: background 0.18s, color 0.18s, transform 0.18s;
  flex-shrink: 0;
  text-decoration: none;
}
.story-nav-btn:hover { background: var(--parchment); color: var(--ink); transform: scale(1.08); }
.story-nav-btn svg { width: 0.875rem; height: 0.875rem; }
.story-mobile-actions {
  display: none;
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0.875rem var(--px) 0;
}
.story-mobile-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.story-mobile-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}
@media (max-width: 767px) {
  .story-share-rail { display: none; }
  .story-nav-rail { display: none; }
  .story-video-block { padding: 0; }
  .story-mobile-actions { display: block; }
}
.story-map-section {
  position: relative;
  z-index: 0;
}
.story-map-panel {
  position: relative;
  z-index: 0;
  isolation: isolate;
  border-radius: 1.5rem;
  border: 1px solid var(--border);
  background: var(--surface);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr;
}
@media (min-width: 600px) {
  .story-map-panel { grid-template-columns: clamp(220px, 30%, 300px) 1fr; }
}
.story-map-canvas-wrap {
  position: relative;
  z-index: 0;
  isolation: isolate;
  overflow: hidden;
  max-height: clamp(280px, 40vw, 520px);
}
.story-map-info {
  padding: clamp(1.25rem, 3vw, 1.875rem);
  display: flex;
  flex-direction: column;
  border-bottom: 1px solid var(--border);
}
@media (min-width: 600px) {
  .story-map-info { border-bottom: none; border-right: 1px solid var(--border); }
}
.story-map-info-top { flex: 1; }
.story-map-info-name {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(0.95rem, 1.8vw, 1.35rem);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--parchment);
  line-height: 1.2;
  margin-top: 0.35rem;
}
.story-map-details {
  margin-top: 1.125rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.story-map-detail {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  font-size: 0.8rem;
  font-weight: 300;
  color: var(--p-50);
  line-height: 1.5;
  text-decoration: none;
}
.story-map-detail svg { width: 0.82rem; height: 0.82rem; flex-shrink: 0; margin-top: 0.18rem; color: var(--p-35); }
a.story-map-detail { transition: color 0.18s; }
a.story-map-detail:hover { color: var(--amber); }
a.story-map-detail:hover svg { color: var(--amber); }
.story-map-info-btn {
  margin-top: clamp(1rem, 2.5vw, 1.5rem);
  align-self: flex-start;
}
@media (max-width: 767px) {
  .story-map-info-btn {
    align-self: center;
    width: 100%;
    display: flex;
    justify-content: center;
  }
}
#bakery-map { width: 100%; height: clamp(280px, 40vw, 520px); display: block; }
@media (max-width: 599px) {
  #bakery-map { height: 260px; }
  .story-map-canvas-wrap { max-height: 260px; }
}
.bakery-inline-photos {
  margin-top: 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
/* Multiple address links stacked in the aside for multi-location bakeries */
.aside-locations {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  margin-top: 0.15rem;
}
/* Plain <span> address gets pointer + amber hover when it has a location-index (triggers marker highlight) */
span[data-location-index] { cursor: pointer; transition: color 0.18s; }
span[data-location-index]:hover { color: var(--amber); }
/* setOpacity() targets the outer Leaflet wrapper — transition must live here, not on the inner div */
:global(.leaflet-marker-icon) { transition: opacity 0.3s ease; }
</style>

<script is:inline>
  function initBakeryPage() {
    var url = window.location.href;

    var elFb   = document.getElementById('share-fb');
    var elIg   = document.getElementById('share-ig');
    var elLi   = document.getElementById('share-li');
    var elLink = document.getElementById('share-link');
    if (elFb)   elFb.onclick   = function() { window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url), '_blank', 'width=600,height=400'); };
    if (elIg)   elIg.onclick   = function() { window.open('https://www.instagram.com/', '_blank'); };
    if (elLi)   elLi.onclick   = function() { window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url), '_blank', 'width=600,height=400'); };
    if (elLink) elLink.onclick = function() {
      navigator.clipboard.writeText(url).then(function() {
        elLink.style.color = 'var(--amber)';
        setTimeout(function() { elLink.style.color = ''; }, 1200);
      });
    };

    var mIg   = document.getElementById('m-share-ig');
    var mTt   = document.getElementById('m-share-tt');
    var mFb   = document.getElementById('m-share-fb');
    var mLink = document.getElementById('m-share-link');
    if (mIg)   mIg.onclick   = function() { window.open('https://www.instagram.com/', '_blank'); };
    if (mTt)   mTt.onclick   = function() { window.open('https://www.tiktok.com/', '_blank'); };
    if (mFb)   mFb.onclick   = function() { window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url), '_blank', 'width=600,height=400'); };
    if (mLink) mLink.onclick = function() {
      navigator.clipboard.writeText(url).then(function() {
        mLink.style.color = 'var(--amber)';
        setTimeout(function() { mLink.style.color = ''; }, 1200);
      });
    };

    var shareBtn = document.getElementById('share-btn');
    if (shareBtn) {
      shareBtn.onclick = function() {
        if (navigator.share) {
          navigator.share({ url: url });
        } else {
          navigator.clipboard.writeText(url).then(function() {
            shareBtn.textContent = 'Link copied!';
            setTimeout(function() {
              shareBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4"/><path d="m15.4 6.5-6.8 4"/></svg>Share';
            }, 2000);
          });
        }
      };
    }

  }

  window.registerPageInit('bakery-story', initBakeryPage, null);
</script>

<script>
  import { supabase } from '../../lib/supabase';

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function relativeTime(dateStr: string): string {
    const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
    if (diff < 60) return 'just now';
    if (diff < 3600) return Math.floor(diff / 60) + (Math.floor(diff / 60) === 1 ? ' minute ago' : ' minutes ago');
    if (diff < 86400) return Math.floor(diff / 3600) + (Math.floor(diff / 3600) === 1 ? ' hour ago' : ' hours ago');
    if (diff < 604800) return Math.floor(diff / 86400) + (Math.floor(diff / 86400) === 1 ? ' day ago' : ' days ago');
    return new Date(dateStr).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function avatarInitials(name: string): string {
    return name.trim().split(/\s+/).map((n: string) => n[0]).join('').slice(0, 2).toUpperCase() || '?';
  }

  async function initComments() {
    const section = document.querySelector('.comments-section[data-slug]') as HTMLElement | null;
    if (!section) return;
    const slug = section.dataset.slug!;

    const formWrap     = document.getElementById('comment-form-wrap') as HTMLElement | null;
    const signinPrompt = document.getElementById('comment-signin-prompt') as HTMLElement | null;
    const submitBtn    = document.getElementById('comment-submit') as HTMLButtonElement | null;
    const textarea     = document.getElementById('comment-input') as HTMLTextAreaElement | null;
    const listEl       = document.getElementById('comments-list') as HTMLElement | null;
    if (!listEl) return;

    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      if (formWrap)     formWrap.style.display     = '';
      if (signinPrompt) signinPrompt.style.display = 'none';
    } else {
      if (formWrap)     formWrap.style.display     = 'none';
      if (signinPrompt) signinPrompt.style.display = '';
    }

    async function loadComments() {
      const { data: comments } = await supabase
        .from('comments')
        .select('id, display_name, body, created_at')
        .eq('bakery_slug', slug)
        .order('created_at', { ascending: false });

      if (!comments || comments.length === 0) {
        listEl!.innerHTML = '<p class="comments-empty">No comments yet. Be the first to share your thoughts!</p>';
        return;
      }

      listEl!.innerHTML = comments.map((c: { display_name: string; body: string; created_at: string }) => {
        const name = c.display_name || 'Anonymous';
        return `<div class="comment-item">
          <div class="comment-avatar">${esc(avatarInitials(name))}</div>
          <div class="comment-body">
            <div class="comment-meta">
              <span class="comment-author">${esc(name)}</span>
              <span class="comment-date">${relativeTime(c.created_at)}</span>
            </div>
            <div class="comment-text">${esc(c.body)}</div>
          </div>
        </div>`;
      }).join('');
    }

    await loadComments();

    if (session && submitBtn && textarea) {
      submitBtn.onclick = async () => {
        const body = textarea.value.trim();
        if (!body) return;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Posting…';
        const displayName = (session.user.user_metadata?.full_name as string)
          || session.user.email?.split('@')[0]
          || 'Anonymous';
        const { error } = await supabase.from('comments').insert({
          bakery_slug: slug,
          user_id: session.user.id,
          display_name: displayName,
          body,
        });
        if (!error) {
          textarea.value = '';
          await loadComments();
        }
        submitBtn.disabled = false;
        submitBtn.textContent = 'Post comment';
      };
    }
  }

  document.addEventListener('astro:page-load', initComments);
  initComments();
</script>

<script>
  import { initBakeryMap, destroyBakeryMap } from '../../scripts/map.js';

  document.addEventListener('astro:before-swap', destroyBakeryMap);

  document.addEventListener('astro:page-load', function() {
    if (document.getElementById('bakery-map')) initBakeryMap();
  });

  // Immediate call — handle async module load race with astro:page-load.
  if (document.getElementById('bakery-map')) initBakeryMap();
</script>

<script>
  import { supabase } from '../../lib/supabase';

  const SAVE_ICON_EMPTY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>';
  const SAVE_ICON_FULL  = '<svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>';

  async function initSaveAndRating() {
    const starEl      = document.getElementById('star-rating') as HTMLElement | null;
    const summaryEl   = document.getElementById('rating-summary') as HTMLElement | null;
    const saveBtn     = document.getElementById('save-btn') as HTMLButtonElement | null;
    if (!starEl && !saveBtn) return;

    const slug = (starEl?.dataset.slug || saveBtn?.dataset.slug)!;
    const { data: { session } } = await supabase.auth.getSession();

    // ── RATINGS ─────────────────────────────────────────────────
    async function loadAverage() {
      const { data } = await supabase
        .from('ratings')
        .select('rating')
        .eq('bakery_slug', slug);
      if (!summaryEl) return;
      if (!data || data.length === 0) {
        summaryEl.textContent = 'No ratings yet';
      } else {
        const avg = data.reduce((s: number, r: { rating: number }) => s + r.rating, 0) / data.length;
        summaryEl.textContent = avg.toFixed(1) + ' ★ · ' + data.length + (data.length === 1 ? ' rating' : ' ratings');
      }
    }

    await loadAverage();

    if (starEl) {
      const stars = Array.from(starEl.querySelectorAll('.star')) as HTMLElement[];
      let userRating = 0;

      function renderStars(value: number) {
        stars.forEach(s => s.classList.toggle('filled', parseInt(s.dataset.value || '0') <= value));
      }

      if (session) {
        const { data: existing } = await supabase
          .from('ratings')
          .select('rating')
          .eq('bakery_slug', slug)
          .eq('user_id', session.user.id)
          .maybeSingle();
        userRating = existing?.rating || 0;
        renderStars(userRating);

        stars.forEach(star => {
          const value = parseInt(star.dataset.value || '0');
          star.addEventListener('mouseenter', () => renderStars(value));
          star.addEventListener('mouseleave', () => renderStars(userRating));
          star.addEventListener('click', async () => {
            userRating = value;
            renderStars(value);
            await supabase.from('ratings').upsert(
              { user_id: session.user.id, bakery_slug: slug, rating: value },
              { onConflict: 'user_id,bakery_slug' }
            );
            await loadAverage();
          });
        });
      } else {
        renderStars(0);
        stars.forEach(s => (s.style.cursor = 'default'));
      }
    }

    // ── SAVE BUTTON ─────────────────────────────────────────────
    if (saveBtn) {
      function setSaved(saved: boolean) {
        saveBtn!.classList.toggle('is-saved', saved);
        saveBtn!.innerHTML = saved
          ? SAVE_ICON_FULL  + ' Saved ✓'
          : SAVE_ICON_EMPTY + ' Save to Recipe Book';
      }

      if (session) {
        const { data: existing, error: checkError } = await supabase
          .from('saves')
          .select('id')
          .eq('user_id', session.user.id)
          .eq('content_type', 'bakery')
          .eq('content_slug', slug)
          .maybeSingle();
        if (checkError) console.error('Save check error:', checkError);
        setSaved(!!existing);

        saveBtn.onclick = async () => {
          if (saveBtn.classList.contains('is-saved')) {
            const { error } = await supabase.from('saves')
              .delete()
              .eq('user_id', session.user.id)
              .eq('content_type', 'bakery')
              .eq('content_slug', slug);
            console.log('Save delete result:', error ?? 'ok');
            if (!error) setSaved(false);
          } else {
            const { data, error } = await supabase.from('saves').insert({
              user_id: session.user.id,
              content_type: 'bakery',
              content_slug: slug,
            });
            console.log('Save insert result:', data, error);
            if (!error) setSaved(true);
          }
        };
      } else {
        saveBtn.onclick = () => { window.location.href = '/auth/login'; };
      }
    }
  }

  document.addEventListener('astro:page-load', initSaveAndRating);
  initSaveAndRating();
</script>