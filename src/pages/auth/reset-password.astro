---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Set New Password" description="Choose a new password for your (K)Need account.">
  <main class="auth-page">
    <div class="auth-card">

      <div class="auth-card-logo">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 179.04 38.1" style="height:2rem;width:auto;"><defs><style>.arp-fill{fill:currentColor;}</style></defs><g><path class="arp-fill" d="M9.45,13.44c.48-1.74,1.1-3.29,1.86-4.67.76-1.37,1.56-2.5,2.4-3.41l.57.81c-.76.88-1.49,1.97-2.19,3.26-.7,1.29-1.27,2.74-1.69,4.36-.43,1.62-.65,3.38-.65,5.28s.21,3.63.65,5.25c.43,1.62.99,3.07,1.69,4.35.7,1.28,1.43,2.36,2.19,3.24l-.57.81c-.84-.88-1.64-2.01-2.4-3.38-.76-1.37-1.38-2.93-1.86-4.67-.48-1.74-.72-3.62-.72-5.64s.24-3.87.72-5.61Z"/><path class="arp-fill" d="M47.76,24.69c-.48,1.74-1.1,3.29-1.85,4.67-.75,1.37-1.54,2.49-2.38,3.38l-.6-.81c.78-.88,1.52-1.96,2.21-3.24.69-1.28,1.25-2.73,1.68-4.35.43-1.62.65-3.37.65-5.25s-.21-3.66-.65-5.28-.99-3.07-1.68-4.35c-.69-1.28-1.43-2.36-2.21-3.24l.6-.84c.84.9,1.63,2.04,2.38,3.41.75,1.37,1.37,2.92,1.85,4.67.48,1.74.72,3.62.72,5.64s-.24,3.87-.72,5.61Z"/></g><g><path class="arp-fill" d="M81.9,30.11l-16.8-19.65.27-.3.03,19.5h-1.02V8.09h.06l16.89,19.83-.36.06V8.48h.96v21.63h-.03Z"/><path class="arp-fill" d="M97.89,8.48h12.84v.99h-11.82v9.03h10.65v.96h-10.65v9.21h12.24v.99h-13.26V8.48Z"/><path class="arp-fill" d="M125.94,8.48h12.84v.99h-11.82v9.03h10.65v.96h-10.65v9.21h12.24v.99h-13.26V8.48Z"/><path class="arp-fill" d="M153.99,29.66V8.48h5.04c2.02,0,3.75.33,5.19.98,1.44.65,2.6,1.5,3.5,2.55.89,1.05,1.54,2.2,1.96,3.45s.63,2.49.63,3.71c0,1.6-.28,3.04-.84,4.33-.56,1.29-1.32,2.4-2.28,3.31-.96.92-2.05,1.63-3.29,2.12-1.23.49-2.52.74-3.88.74h-6.03ZM155.01,28.67h4.68c1.32,0,2.56-.22,3.72-.66,1.16-.44,2.17-1.07,3.04-1.91.87-.83,1.55-1.83,2.05-3.01.5-1.18.75-2.51.75-3.99,0-1.18-.2-2.34-.6-3.48-.4-1.14-1.02-2.17-1.85-3.11-.83-.93-1.89-1.67-3.18-2.21s-2.82-.81-4.58-.81h-4.05v19.17Z"/></g><g><path class="arp-fill" d="M23.46,18.35l-.06,1.02v-.18l11.04-10.71h1.32l-8.76,8.55,9.9,12.63h-1.29l-9.39-11.97-2.79,2.67.03,9.3h-1.05V8.48h1.05v9.87Z"/></g></svg>
      </div>

      <div id="auth-error" class="auth-error"></div>

      <p id="reset-status" style="font-size:0.8125rem;text-align:center;color:var(--p-50);min-height:1.25rem;">Checking your reset link…</p>

      <div id="reset-form" style="display:none;">
        <div class="auth-field">
          <label class="auth-label" for="new-password">New password</label>
          <input class="auth-input" type="password" id="new-password" placeholder="••••••••" autocomplete="new-password" />
        </div>
        <div class="auth-field">
          <label class="auth-label" for="confirm-password">Confirm new password</label>
          <input class="auth-input" type="password" id="confirm-password" placeholder="••••••••" autocomplete="new-password" />
        </div>
        <button id="update-btn" class="auth-submit" type="button">Update password</button>
      </div>

      <div class="auth-footer">
        <a href="/auth/login">Back to sign in</a>
      </div>

    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';

  const errorEl  = document.getElementById('auth-error') as HTMLElement;
  const statusEl = document.getElementById('reset-status') as HTMLElement;
  const formEl   = document.getElementById('reset-form') as HTMLElement;
  const updateBtn = document.getElementById('update-btn') as HTMLButtonElement;

  let shown = false;

  function showForm() {
    if (shown) return;
    shown = true;
    statusEl.textContent = '';
    statusEl.style.display = 'none';
    formEl.style.display = '';
  }

  function showInvalid() {
    if (shown) return;
    formEl.style.display = 'none';
    statusEl.style.display = 'none';
    errorEl.style.color = '';
    errorEl.innerHTML = 'This reset link is invalid or has expired. <a href="/auth/forgot-password" style="color:var(--amber);text-decoration:underline;">Request a new one</a>.';
  }

  // Implicit flow: detectSessionInUrl consumes the recovery token from the URL hash
  // and fires PASSWORD_RECOVERY once the session is established.
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') showForm();
  });

  (async () => {
    const { data } = await supabase.auth.getSession();
    if (data.session) { showForm(); return; }
    // Give detectSessionInUrl a moment to parse the hash, then re-check.
    setTimeout(async () => {
      const { data: retry } = await supabase.auth.getSession();
      if (retry.session) showForm();
      else if (!shown) showInvalid();
    }, 800);
  })();

  async function updatePassword() {
    const password = (document.getElementById('new-password') as HTMLInputElement).value;
    const confirm  = (document.getElementById('confirm-password') as HTMLInputElement).value;
    errorEl.style.color = '';
    errorEl.textContent = '';
    if (password.length < 6) { errorEl.textContent = 'Password must be at least 6 characters.'; return; }
    if (password !== confirm) { errorEl.textContent = 'Passwords do not match.'; return; }
    updateBtn.disabled = true;
    updateBtn.textContent = 'Updating…';
    const { error } = await supabase.auth.updateUser({ password });
    if (error) {
      errorEl.textContent = error.message;
      updateBtn.disabled = false;
      updateBtn.textContent = 'Update password';
      return;
    }
    errorEl.style.color = 'var(--amber)';
    errorEl.textContent = 'Password updated. Redirecting…';
    updateBtn.disabled = true;
    updateBtn.textContent = 'Done';
    setTimeout(() => { window.location.href = '/'; }, 1200);
  }

  updateBtn?.addEventListener('click', updatePassword);
  document.getElementById('confirm-password')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') updatePassword();
  });
</script>
