---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <title>{title} | (K)NEED</title>
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100;0,200;0,300;0,400;1,200;1,300&family=Barlow:wght@300;400;500;600&family=Barlow+Condensed:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/global.css" />
    
    <!--
      ═══════════════════════════════════════════════════════════════
      PAGE INIT REGISTRY
      ═══════════════════════════════════════════════════════════════
      Handles Astro View Transition lifecycle for every page on the
      site. Because Astro's ClientRouter (SPA mode) keeps <head>
      alive across navigations, this script runs once and persists.

      HOW TO USE — in any page's <script is:inline> block:

        window.registerPageInit('my-page-id', initFn, destroyFn);

        • initFn()    — called after every astro:page-load
        • destroyFn() — called before astro:before-swap (optional)

      The registry is cleared on every before-swap so only the
      incoming page's function is queued when page-load fires.
      Each init should guard with an element-existence check so it
      is safe to be called on pages where its elements don't exist.
      ═══════════════════════════════════════════════════════════════
    -->
    <script is:inline>
      window.__pageInits = window.__pageInits || {};

      window.registerPageInit = function(pageId, initFn, destroyFn) {
        window.__pageInits[pageId] = { init: initFn, destroy: destroyFn || null };
      };

      if (!window.__lifecycleListenersAdded) {
        window.__lifecycleListenersAdded = true;

        document.addEventListener('astro:before-swap', function() {
          Object.values(window.__pageInits).forEach(function(p) {
            if (typeof p.destroy === 'function') p.destroy();
          });
          window.__pageInits = {};
        });

        document.addEventListener('astro:page-load', function() {
          Object.values(window.__pageInits).forEach(function(p) {
            if (typeof p.init === 'function') p.init();
          });
        });
      }
    </script>

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G6ZQHC582Q"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-G6ZQHC582Q');
    </script>

    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '3290406697805340');
      fbq('track', 'PageView');
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>