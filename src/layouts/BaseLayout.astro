---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
const { title, description, image, canonicalURL } = Astro.props;
const isMapPage    = Astro.url.pathname.startsWith('/map');
const isBakeryPage = /^\/bakeries\/.+/.test(Astro.url.pathname);
const noClientRouter = isMapPage || isBakeryPage;
const ogImage = image || (Astro.url.origin + '/images/og-default.jpg');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="img-src 'self' data: blob: https://lh3.googleusercontent.com https://images.unsplash.com https://images.pexels.com https://*.cartocdn.com https://*.supabase.co https://maps.googleapis.com https://maps.gstatic.com https://res.cloudinary.com https://img.youtube.com https://www.facebook.com;" />
    <title>{title} | (K)NEED</title>

    <!-- Primary SEO -->
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL || Astro.url.href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title + ' | (K)Need'} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="(K)Need" />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title + ' | (K)Need'} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Additional SEO -->
    <meta name="author" content="(K)Need" />
    <meta name="geo.region" content="AU-VIC" />
    <meta name="geo.placename" content="Melbourne" />
    {!noClientRouter && <ClientRouter />}
    {!noClientRouter && <script is:inline>
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href) return;
        if (href === '/map' || href.startsWith('/map/') || href.startsWith('/map?') ||
            /^\/bakeries\/[^\/\?#]+/.test(href)) {
          e.preventDefault();
          e.stopPropagation();
          window.location.href = href;
        }
      }, true);
    </script>}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100;0,200;0,300;0,400;1,200;1,300&family=Barlow:wght@300;400;500;600&family=Archivo+Narrow:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64," />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="stylesheet" href="/global.css" />
    <slot name="head" />
    
    <!--
      ═══════════════════════════════════════════════════════════════
      PAGE INIT REGISTRY
      ═══════════════════════════════════════════════════════════════
      Handles Astro View Transition lifecycle for every page on the
      site. Because Astro's ClientRouter (SPA mode) keeps <head>
      alive across navigations, this script runs once and persists.

      HOW TO USE — in any page's <script is:inline> block:

        window.registerPageInit('my-page-id', initFn, destroyFn);

        • initFn()    — called after every astro:page-load
        • destroyFn() — called before astro:before-swap (optional)

      The registry is cleared on every before-swap so only the
      incoming page's function is queued when page-load fires.
      Each init should guard with an element-existence check so it
      is safe to be called on pages where its elements don't exist.
      ═══════════════════════════════════════════════════════════════
    -->
    <script is:inline>
      /*
       * ╔══════════════════════════════════════════════════════════════════╗
       * ║  PAGE INIT REGISTRY + NAV DRAWER — persistent <head> script     ║
       * ║  Runs once. astro:page-load / astro:before-swap fire every nav. ║
       * ╚══════════════════════════════════════════════════════════════════╝
       */
      window.__pageInits = window.__pageInits || {};

      window.registerPageInit = function(pageId, initFn, destroyFn) {
        window.__pageInits[pageId] = { init: initFn, destroy: destroyFn || null };
      };

      // ── NAV DRAWER ────────────────────────────────────────────────────
      // Defined here (persistent head script) so they survive every SPA
      // navigation. initNavDrawer() fetches all DOM refs fresh — the header
      // is re-rendered by the body swap, so stale refs are never used.

      function initNavDrawer() {
        var drawer   = document.getElementById('menu-drawer');
        var backdrop = document.getElementById('menu-backdrop');
        var menuBtn  = document.getElementById('menu-btn');
        var closeBtn = document.getElementById('menu-close-btn');
        var panel    = drawer && drawer.querySelector('.menu-panel');
        if (!drawer || !menuBtn || !panel) return;

        // Highlight the active page link
        var currentPath = window.location.pathname;
        drawer.querySelectorAll('.menu-nav-item[href]').forEach(function(link) {
          var href = link.getAttribute('href');
          var active = href === currentPath ||
                       (href !== '/' && currentPath.startsWith(href + '/'));
          link.classList.toggle('is-active', active);
        });

        function openMenu() {
          drawer.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          menuBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          // Move focus into the panel after the slide-in transition starts
          setTimeout(function() { if (closeBtn) closeBtn.focus(); }, 50);
        }

        function closeMenu() {
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
          menuBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          menuBtn.focus();
        }

        // onclick= replaces itself on every re-init — no listener stacking
        menuBtn.onclick  = openMenu;
        if (closeBtn) closeBtn.onclick = closeMenu;
        if (backdrop)  backdrop.onclick  = closeMenu;

        // Focus trap — onkeydown= also self-replaces
        panel.onkeydown = function(e) {
          if (e.key !== 'Tab' || !drawer.classList.contains('is-open')) return;
          var focusable = Array.from(
            panel.querySelectorAll('a[href], button:not([disabled])')
          ).filter(function(el) { return el.offsetParent !== null; });
          if (focusable.length < 2) return;
          var first = focusable[0];
          var last  = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault(); last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault(); first.focus();
          }
        };

        // Escape key — guarded with a once-only flag so it never stacks
        if (!window.__kneedEscapeAdded) {
          window.__kneedEscapeAdded = true;
          document.addEventListener('keydown', function(e) {
            if (e.key !== 'Escape') return;
            var d = document.getElementById('menu-drawer');
            var b = document.getElementById('menu-btn');
            if (d && d.classList.contains('is-open')) {
              d.classList.remove('is-open');
              d.setAttribute('aria-hidden', 'true');
              document.body.style.overflow = '';
              if (b) { b.setAttribute('aria-expanded', 'false'); b.focus(); }
            }
          });
        }
      }

      function destroyNavDrawer() {
        var drawer = document.getElementById('menu-drawer');
        if (drawer && drawer.classList.contains('is-open')) {
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
        }
        document.body.style.overflow = '';
      }

      // ── LIFECYCLE ─────────────────────────────────────────────────────
      if (!window.__lifecycleListenersAdded) {
        window.__lifecycleListenersAdded = true;

        document.addEventListener('astro:before-swap', function() {
          // Destroy nav drawer first (it's not in __pageInits — see page-load)
          destroyNavDrawer();
          // Destroy and clear all page-specific inits
          Object.values(window.__pageInits).forEach(function(p) {
            if (typeof p.destroy === 'function') p.destroy();
          });
          window.__pageInits = {};
        });

        document.addEventListener('astro:page-load', function() {
          // Nav drawer runs on every page — re-register after the registry
          // was cleared by before-swap, then call all inits together.
          window.registerPageInit('nav-drawer', initNavDrawer, destroyNavDrawer);
          Object.values(window.__pageInits).forEach(function(p) {
            if (typeof p.init === 'function') p.init();
          });
        });
      }

      // Fallback for pages without ClientRouter (e.g. /map) where
      // astro:page-load never fires — DOMContentLoaded covers that case.
      // Safe to run alongside astro:page-load since initNavDrawer uses
      // onclick= assignment and never stacks listeners.
      document.addEventListener('DOMContentLoaded', initNavDrawer);
    </script>

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G6ZQHC582Q"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-G6ZQHC582Q');
    </script>

    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '3290406697805340');
      fbq('track', 'PageView');
    </script>
  </head>
  <body>
    <Header />
    <slot />

    <!-- SUBMIT BANNER — appears on every page above the footer -->
    <section class="wf-container" style="padding-bottom: clamp(2rem,4vw,3rem);">
      <a href="/submit" class="submit-banner">
        <img src="https://images.unsplash.com/photo-1599819055803-717bba43890f?q=80&w=2370&auto=format&fit=crop" alt="" aria-hidden="true" class="submit-banner-bg" loading="lazy" />
        <div class="submit-banner-overlay"></div>
        <div class="submit-banner-content">
          <div class="submit-banner-eyebrow">Submit a Bakery</div>
          <div class="submit-banner-heading">Is there a bakery we're missing?</div>
          <span class="wf-pill pill-amber" style="pointer-events:none;">Let us know →</span>
        </div>
      </a>
    </section>

    <Footer />
  </body>
</html>

<script>
  import { supabase } from '../lib/supabase';

  async function updateAuthUI() {
    const { data: { session } } = await supabase.auth.getSession();
    const signin  = document.getElementById('header-signin') as HTMLAnchorElement | null;
    const userBtn = document.getElementById('header-user') as HTMLButtonElement | null;
    const menuOut = document.getElementById('menu-member-loggedout') as HTMLElement | null;
    const menuIn  = document.getElementById('menu-member-loggedin') as HTMLElement | null;

    if (session) {
      if (signin)  signin.style.display  = 'none';
      if (userBtn) {
        const avatarUrl = (session.user.user_metadata?.picture as string | undefined)
          || (session.user.user_metadata?.avatar_url as string | undefined);
        userBtn.innerHTML = '';
        if (avatarUrl) {
          const img = document.createElement('img');
          img.src = avatarUrl;
          img.style.cssText = 'width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;';
          userBtn.appendChild(img);
        } else {
          const name = (session.user.user_metadata?.full_name as string) || session.user.email || '';
          const initials = name.split(/\s+/).map((n: string) => n[0]).join('').slice(0, 2).toUpperCase() || '?';
          userBtn.textContent = initials;
        }
        userBtn.style.display = 'flex';
        userBtn.style.overflow = 'hidden';
        userBtn.style.padding = '0';
        userBtn.onclick = () => { window.location.href = '/profile'; };
      }
      if (menuOut) menuOut.style.display = 'none';
      if (menuIn)  menuIn.style.display  = '';
      const nameEl  = document.getElementById('menu-user-name');
      const emailEl = document.getElementById('menu-user-email');
      if (nameEl)  nameEl.textContent  = (session.user.user_metadata?.full_name as string) || '';
      if (emailEl) emailEl.textContent = session.user.email || '';
    } else {
      if (signin)  signin.style.display  = '';
      if (userBtn) userBtn.style.display = 'none';
      if (menuOut) menuOut.style.display = '';
      if (menuIn)  menuIn.style.display  = 'none';
    }
  }

  document.addEventListener('astro:page-load', updateAuthUI);
  updateAuthUI();
</script>